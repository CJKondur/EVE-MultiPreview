    <sys:String x:Key="L.S.Groups.DuplicateName">Anche un altro gruppo si chiama '{0}'. Rinomina questo prima di assegnargli dei tasti.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.Colour">Colore</sys:String> <!-- draft -->
