    <sys:String x:Key="L.S.Crops.Window">Finestra sullo schermo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.Opacity">Opacità</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.ClickThrough">I clic passano attraverso</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.Tip">Trascina una finestra di ritaglio con il tasto destro per spostarla; premi anche il sinistro per ridimensionarla.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.CopyAll">Tutti gli altri personaggi ({0})</sys:String> <!-- draft -->
