    <sys:String x:Key="L.S.character.groupsLink.Desc">Aggiungi questo personaggio a un gruppo, o cambia la sua posizione, nella pagina Gruppi.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.openGroups">Apri gruppi</sys:String> <!-- draft -->
