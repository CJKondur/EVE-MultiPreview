    <sys:String x:Key="L.S.Crops.Name">Nome</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.ShowName">Mostra il nome</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Crops.EditArea">Modifica area…</sys:String> <!-- draft -->
