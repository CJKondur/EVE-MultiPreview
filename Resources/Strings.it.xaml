    <sys:String x:Key="L.S.clients.hotkeys.cycleNext.Desc">Passa al client in esecuzione successivo, qualunque sia il suo gruppo.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cyclePrevious">Client precedente</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleWhileHeld">Continua a cambiare finché il tasto è premuto</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleWhileHeld.Desc">Disattivo: ogni pressione cambia esattamente un client.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleDelay">Tempo tra i cambi a tasto premuto</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleDelay.Desc">Più basso è più veloce. Il predefinito è 100 ms.</sys:String> <!-- draft -->
