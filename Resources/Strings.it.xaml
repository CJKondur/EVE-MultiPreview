    <!-- General panel -->
    <sys:String x:Key="L.General.Title">⚙ Impostazioni generali</sys:String>
    <sys:String x:Key="L.General.Subtitle">Impostazioni principali per il comportamento dei tasti di scelta rapida di EVE MultiPreview.</sys:String>
    <sys:String x:Key="L.General.ShowTimer">Mostra il timer di sessione sulle miniature</sys:String>
    <sys:String x:Key="L.General.HotkeyScope">Ambito dei tasti di scelta rapida</sys:String>
    <sys:String x:Key="L.General.ActivationScope">Ambito di attivazione:</sys:String>
    <sys:String x:Key="L.General.ScopeGlobal">Globale</sys:String>
    <sys:String x:Key="L.General.ScopeEveActive">Quando una finestra EVE è attiva</sys:String>
    <sys:String x:Key="L.General.HotkeyWildcard">I tasti di scelta rapida si attivano anche tenendo premuto Ctrl / Maiusc / Alt</sys:String>
    <sys:String x:Key="L.General.HotkeyWildcardNote">Attivo: una scorciatoia funziona anche mentre tieni premuto un modificatore — in EVE si tiene Ctrl per agganciare i bersagli. Disattivo: una scorciatoia a tasto singolo come V si attiva solo da sola, così Ctrl+V arriva al client per incollare.</sys:String>
    <sys:String x:Key="L.General.PropagateModifiers">Trasferisci Ctrl / Maiusc / Alt tenuti premuti al client su cui passi</sys:String>
    <sys:String x:Key="L.General.PropagateModifiersNote">Attivo: tenere premuto Ctrl per agganciare un bersaglio continua a funzionare dopo essere passati a un altro client. Disattivalo se l'aggancio smette di funzionare dopo un cambio: su alcune configurazioni il client rileva già il tasto premuto e questi input aggiuntivi lo disturbano.</sys:String>
    <sys:String x:Key="L.General.PropagateKeys">Trasferisci gli altri tasti tenuti premuti al client su cui passi</sys:String>
    <sys:String x:Key="L.General.PropagateKeysNote">Attivo: lettere, numeri, tasti F, Invio, Spazio e pulsanti del mouse ancora premuti quando cambi vengono premuti anche nel nuovo client (tieni premuto F1 e scorri per attivarlo su ciascuno). Disattivalo se un tasto modulo non ancora rilasciato si attiva sul client successivo e la tua pressione lo disattiva di nuovo. Ctrl / Maiusc / Alt tenuti premuti seguono l'impostazione sopra.</sys:String>
    <sys:String x:Key="L.General.HideHeldKeys">Nascondi i tasti ancora premuti al client su cui passi</sys:String>
    <sys:String x:Key="L.General.HideHeldKeysNote">Per lettere, numeri, tasti F, Invio e Spazio. Un tasto ancora premuto al cambio viene rilasciato nel client che lasci e tenuto lontano da quello nuovo finché non lo lasci, così tenere premuto A (allinea) o S (warp) non fa allineare né andare in warp il client successivo. Ha la precedenza su «Trasferisci gli altri tasti tenuti premuti». Ctrl / Maiusc / Alt non vengono mai nascosti: seguono la loro opzione qui sopra, e nasconderli romperebbe i tasti rapidi con modificatore tenuto come Ctrl+TAB.</sys:String>
    <sys:String x:Key="L.General.HideHotkeyKeystrokes">Nascondi a EVE le pressioni dei tasti di scelta rapida (come EVE-X-Preview)</sys:String>
    <sys:String x:Key="L.General.HideHotkeyKeystrokesNote">Attivo: quando una scorciatoia cambia client, il client su cui arrivi non vede mai quel tasto. Disattivo: il rilascio del tasto raggiunge quel client, e il primo clic lì potrebbe solo mettere a fuoco l'overview invece di agire.</sys:String>
