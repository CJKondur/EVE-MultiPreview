    <sys:String x:Key="L.S.character.show">Mostra miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label">Etichetta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label.Desc">Testo aggiuntivo sulla miniatura, come Scout o Logi. Lascia vuoto per nessuno. Le etichette valgono in tutti i profili.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor">Colore etichetta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor.Desc">Lascia vuoto per usare il colore del testo della miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize">Dimensione etichetta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize.Desc">0 usa la dimensione del testo della miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size">Dimensione propria</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.Desc">Larghezza e altezza della miniatura di questo personaggio. Un personaggio in esecuzione si ridimensiona subito.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.applySize">Applica</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.NeedsLogin">Accedi una volta con questo personaggio per dargli una dimensione propria.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip">Seconda miniatura (PiP)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip.Desc">Una seconda miniatura separata di questo client. Disattivandola si conservano posizione e dimensione per dopo.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pipOpacity">Opacità della seconda miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.colors">Colori</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsOff">I colori per personaggio sono disattivati in questo profilo. Attiva Usa colori per personaggio in Client › Personaggi per usarli.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorActive">Bordo se attivo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorInactive">Bordo se non attivo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsReset">Torna ai colori del profilo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.resetColors">Reimposta colori</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.Intro">Tutto ciò che MultiPreview conserva per questo personaggio, in un unico posto. Le modifiche valgono per il profilo attuale, salvo diversa indicazione di una scheda.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.switching.Title">Passare a questo personaggio</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.switching.Body">La **scorciatoia** passa direttamente a questo personaggio. Dai lo stesso tasto a due personaggi e alternerà tra loro.&#x0A;&#x0A;**Includi nel ciclo** decide se i tasti client successivo/precedente si fermano qui. Si azzera al riavvio di MultiPreview.&#x0A;&#x0A;I gruppi si modificano nella pagina **Gruppi**, dove imposti anche tasti e ordine.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.thumbnail.Title">Miniatura di questo personaggio</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.thumbnail.Body">- **Etichetta** aggiunge il tuo testo, come Scout. Colore e dimensione possono differire dal resto del testo.&#x0A;- **Dimensione propria** dà a questa miniatura larghezza e altezza proprie. Il personaggio deve aver effettuato l'accesso almeno una volta in questo profilo.&#x0A;- **Seconda miniatura** aggiunge una vista picture-in-picture separata dello stesso client.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.colors.Title">Colori</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.colors.Body">Questi colori di bordo sono usati solo mentre **Usa colori per personaggio** è attivo per il profilo (Client › Personaggi).&#x0A;&#x0A;**Reimposta colori** torna ai colori usati da tutti i personaggi.</sys:String> <!-- draft -->
