    <sys:String x:Key="L.S.app.about.preRelease">Ricevi versioni preliminari</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.preRelease.Desc">Prova le novità in anticipo. Le versioni preliminari possono avere più bug.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.installVersion">Installa una versione specifica</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.installVersion.Desc">Qualsiasi versione, più vecchia o più nuova. Tornare a una più vecchia disattiva la ricerca di aggiornamenti all'avvio.</sys:String> <!-- draft -->
