    <sys:String x:Key="L.S.character.hotkey.Desc">Passa direttamente a questo personaggio. Un altro personaggio può condividere il tasto: allora alterna tra loro.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle">Includi nel ciclo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle.Desc">Disattivato: i tasti client successivo/precedente e i tasti di gruppo saltano questo personaggio fino al riavvio di MultiPreview.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groups">Gruppi: {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.noGroup">In nessun gruppo.</sys:String> <!-- draft -->
