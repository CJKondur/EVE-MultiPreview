    <sys:String x:Key="L.S.Presets.ImportFailed">Quel file non è un layout MultiPreview.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Filter.Layouts">Layout MultiPreview</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.presets.Title">Layout salvati</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.presets.Body">**Salva layout attuale** ricorda dove si trova la miniatura di ogni personaggio in esecuzione e la sua dimensione, come quota del suo schermo, così il layout si adatta anche dopo un cambio di risoluzione. Ricorda anche quali miniature sono nascoste e se le finestre di ritaglio sono attive.&#x0A;- **Applica** rimette a posto le miniature. I personaggi non connessi ricevono il loro posto all'accesso.&#x0A;- **Riassegna e applica** ti lascia scegliere quale personaggio occupa ogni posto, per esempio in un layout di un altro giocatore.&#x0A;- **Esporta** e **Importa** condividono un layout come file. Importare un layout con il nome di uno esistente chiede conferma prima di sostituirlo.</sys:String> <!-- draft -->
    <!-- Thumbnails › Visibility (Plan 3b) -->
    <sys:String x:Key="L.S.Page.thumbs.visibility">Visibilità</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.thumbs.visibility.Desc">Quando le miniature restano in primo piano o si scansano, il segno della schermata di accesso e le seconde miniature.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.visibility.stacking">Restare in primo piano</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.alwaysOnTop">Sempre in primo piano</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.alwaysOnTop.Desc">Le miniature restano sopra ogni altra finestra, browser compreso.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.aboveClients">Mantieni sopra i client EVE</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.aboveClients.Desc">Mentre giochi, le miniature restano sopra i tuoi client EVE ma altre app possono coprirle. Pensato per l'uso con Sempre in primo piano disattivato.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.visibility.hiding">Quando nascondere</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.hideOnLostFocus">Nascondi quando passi a un'altra app</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.hideOnLostFocus.Desc">Le miniature spariscono finché nessun client EVE è in primo piano e tornano quando lo è uno. Restano mentre le impostazioni sono aperte.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.hideActive">Nascondi il client che stai giocando</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.hideActive.Desc">Si nasconde solo la miniatura del client in primo piano.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.visibility.login">Client alla schermata di accesso</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.notLoggedIn">Segno per un client non connesso</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.notLoggedIn.Desc">Come una miniatura mostra un client ancora alla selezione del personaggio.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.NotLoggedInNone">Niente</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.NotLoggedInText">Testo «Non connesso»</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.NotLoggedInBorder">Bordo colorato</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.NotLoggedInDim">Oscurato</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.notLoggedInColor">Colore del bordo per i client non connessi</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.visibility.pip">Seconde miniature (PiP)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.pipTable">Seconde miniature</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.pipTable.Desc">Una miniatura extra dello stesso client con posizione, dimensione e opacità proprie. Disattivata mantiene posizione e dimensione per la volta successiva.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.ColOn">Attiva</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.ColOpacity">Opacità</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.Empty">Ancora nessuna seconda miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.Add">Aggiungi…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.AddTitle">Aggiungi una seconda miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.AddExists">«{0}» ha già una seconda miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.Remove">Rimuovi…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.OnFor">Seconda miniatura di {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Pip.OpacityFor">Opacità della seconda miniatura di {0}</sys:String> <!-- draft -->
