    <sys:String x:Key="L.S.Events.ColOn">Attivo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Events.Group.combat">Combattimento</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Events.Group.fleet">Flotta e chat</sys:String> <!-- draft -->
