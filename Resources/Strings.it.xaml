    <sys:String x:Key="L.S.Characters.Open">Apri le impostazioni di {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Characters.Empty">Ancora nessun personaggio. Avvia EVE ed effettua l'accesso, oppure aggiungine uno per nome.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Characters.CycleNote">Il ciclo dura fino al riavvio di MultiPreview: un personaggio escluso dal ciclo ritorna la volta successiva.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Characters.Add">Aggiungi un personaggio…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Characters.AddTitle">Aggiungi un personaggio</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Characters.AddExists">«{0}» è già nell'elenco.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.characters.colors">Colori</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.customColors">Usa colori per personaggio</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.customColors.Desc">I colori di bordo propri di ogni personaggio, impostati nella sua pagina. Disattivato: tutti i personaggi usano i colori delle miniature.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.characters.clicks">Clic sulle miniature</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.ctrlClick">Ctrl+clic su una miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.shiftClick">Maiusc+clic su una miniatura</sys:String> <!-- draft -->
