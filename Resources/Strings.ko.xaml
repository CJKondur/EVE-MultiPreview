    <sys:String x:Key="L.S.clients.hotkeys.cycleNext.Desc">그룹과 관계없이 실행 중인 다음 클라이언트로 전환합니다.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cyclePrevious">이전 클라이언트, 실행 중인 모든 클라이언트</sys:String> <!-- draft -->
