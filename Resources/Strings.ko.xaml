    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ 정보</sys:String>
    <sys:String x:Key="L.About.Edition">C# / WPF 에디션</sys:String>
    <sys:String x:Key="L.About.Desc">EVE Online용 다중 클라이언트 썸네일 미리보기 관리자. EVE 창의 실시간 DWM 썸네일을 클릭 전환, 드래그 재배치, 사용자 지정 테두리, 경보, 통계 오버레이, 캐릭터별 단축키와 함께 표시합니다.</sys:String>
    <sys:String x:Key="L.About.Origin">원래 CJKondur가 AutoHotkey v2로 작성했습니다.</sys:String>
    <sys:String x:Key="L.About.Ported">성능, 안정성, 확장성 향상을 위해 C# WPF로 이식되었습니다.</sys:String>
    <sys:String x:Key="L.About.GitHub">🔗 GitHub</sys:String>
    <sys:String x:Key="L.About.CheckUpdates">🔄 업데이트 확인</sys:String>
