    <sys:String x:Key="L.S.clients.hotkeys.redo">레이아웃 변경 다시 실행</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.profileNext">다음 프로필</sys:String> <!-- draft -->
