    <sys:String x:Key="L.Start.Restore.Startup">MultiPreview の起動時に作成されたコピー</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Update">更新の前に作成されたコピー</sys:String> <!-- draft -->
