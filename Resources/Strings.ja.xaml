    <sys:String x:Key="L.Alerts.UnderFire">被攻撃インジケーター</sys:String>
    <sys:String x:Key="L.Alerts.AlertEvents">アラートイベント</sys:String>
    <sys:String x:Key="L.Alerts.Severity">重要度設定</sys:String>
