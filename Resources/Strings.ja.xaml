    <sys:String x:Key="L.S.Sec.clients.characters.colors">色</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.customColors">キャラクターごとの色を使う</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.characters.customColors.Desc">各キャラクターのページで設定した枠線とテキストの色を使います。オフ：すべてのキャラクターがサムネイルの色を使います。</sys:String> <!-- draft -->
