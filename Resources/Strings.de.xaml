    <sys:String x:Key="L.S.app.about.preRelease.Desc">Neue Funktionen früh ausprobieren. Vorabversionen können mehr Fehler haben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.installVersion">Bestimmte Version installieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.installVersion.Desc">Jede Version, älter oder neuer. Der Wechsel zu einer älteren Version schaltet die Update-Suche beim Start aus.</sys:String> <!-- draft -->
