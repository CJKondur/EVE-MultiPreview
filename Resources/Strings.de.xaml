    <sys:String x:Key="L.S.alerts.sounds.speechVolume">Lautstärke der Stimme</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.sounds.speechVolume.Desc">Wie laut die Stimme ist. Die Alarmtöne haben ihre eigene Lautstärke.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.sounds.voices">Stimmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.sounds.voices.Desc">Die Stimme für jeden Schweregrad. Automatisch nimmt eine Stimme in der Sprache von MultiPreview, wenn Windows eine hat.</sys:String> <!-- draft -->
