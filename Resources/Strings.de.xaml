    <sys:String x:Key="L.S.StatsPicker.Always">Immer anzeigen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsPicker.Never">Nie anzeigen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsPicker.Reset">Für alle Zahlen die Standardwerte verwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.numbers.Title">Einzelne Zahlen wählen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.numbers.Body">**Zahlen auswählen…** listet jede Zahl auf, die das Statistik-Overlay anzeigen kann. **Standard** folgt der Liste für alle Charaktere; **Immer anzeigen** und **Nie anzeigen** gelten nur für diesen Charakter. Die Gruppenschalter oben stellen eine ganze Gruppe auf einmal ein.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.tools.stats.characters">Pro Charakter</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.characterTable">Zahlen pro Charakter</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.characterTable.Desc">Öffne einen Charakter, um seine eigenen Zahlen zu wählen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsTable.ColNumbers">Zahlen</sys:String> <!-- draft -->
