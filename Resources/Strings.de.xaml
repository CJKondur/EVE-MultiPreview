    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ Über</sys:String>
    <sys:String x:Key="L.About.Edition">C# / WPF Edition</sys:String>
    <sys:String x:Key="L.About.Desc">Multi-Client-Vorschauverwaltung für EVE Online. Zeigt Live-DWM-Vorschauen deiner EVE-Fenster mit Klick-zum-Wechseln, Ziehen-zum-Neupositionieren, benutzerdefinierten Rahmen, Warnungen, Statistik-Überlagerungen und Hotkeys pro Charakter.</sys:String>
    <sys:String x:Key="L.About.Origin">Ursprünglich in AutoHotkey v2 von CJKondur geschrieben.</sys:String>
    <sys:String x:Key="L.About.Ported">Für verbesserte Leistung, Stabilität und Erweiterbarkeit nach C# WPF portiert.</sys:String>
    <sys:String x:Key="L.About.GitHub">🔗 GitHub</sys:String>
    <sys:String x:Key="L.About.CheckUpdates">🔄 Nach Updates suchen</sys:String>
