    <sys:String x:Key="L.S.clients.windows.positionY.Desc">Vom oberen Rand des Monitors.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.alwaysMaximize">Den Client, zu dem du wechselst, immer maximieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.trackPositions">Merken, wo jedes Clientfenster war</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.trackPositions.Desc">Setzt jeden Client dorthin zurück, wo du ihn verlassen hast. Solange das an ist, werden Zentriert und festes X und Y nicht verwendet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.coverTaskbar">Aktiven Client die Taskleiste verdecken lassen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.coverTaskbar.Desc">Für Fenster in Bildschirmhöhe. Der aktive Client liegt über der Taskleiste und geht beim Wegwechseln dahinter. Auch das Zentrieren nutzt den ganzen Bildschirm.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.windows.slots">Feste Slots</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.slots">Slots</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.slots.Desc">Jeder Slot ist ein Platz auf einem Monitor. Aufgeführte Charaktere gehen in ihren Slot, alle anderen in den Standard-Slot.</sys:String> <!-- draft -->
