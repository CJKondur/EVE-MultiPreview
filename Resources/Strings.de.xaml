    <sys:String x:Key="L.S.NeverMinimize.AddTitle">Diesen Charakter nie minimieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.windows.placement">Fensterposition</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.positionMode">Wohin die Clientfenster kommen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.positionMode.Desc">Wird angewendet, wenn ein Client gefunden wird und bei jedem Wechsel zu ihm.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.PositionOff">Wo EVE sie platziert</sys:String> <!-- draft -->
