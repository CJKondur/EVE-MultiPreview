    <sys:String x:Key="L.S.app.about.useOldWindow">Altes Einstellungsfenster verwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.useOldWindow.Desc">Zurück zum früheren Einstellungsfenster. Es wird in einer späteren Version entfernt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.about.useOldWindow.Toast">Erledigt. Das gewählte Einstellungsfenster öffnet sich beim nächsten Öffnen der Einstellungen.</sys:String> <!-- draft -->
