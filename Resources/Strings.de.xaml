    <sys:String x:Key="L.S.Groups.NamePrompt">Name der neuen Gruppe:</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.NameTaken">'{0}' kann nicht verwendet werden: Der Name ist leer oder eine andere Gruppe heißt schon so.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.DuplicateName">Eine andere Gruppe heißt ebenfalls '{0}'. Benenne diese um, bevor du ihr Tasten gibst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.Colour">Farbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.AddColour">Farbe hinzufügen</sys:String> <!-- draft -->
