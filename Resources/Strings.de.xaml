    <sys:String x:Key="L.S.clients.groups.showBorders.Desc">Zeichnet den Vorschaurahmen jedes Mitglieds in der Farbe seiner Gruppe, auch wenn es nicht der aktive Client ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.groups.list">Deine Gruppen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.groups.new">Gruppe erstellen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.groups.new.Desc">Gib ihr einen Namen und füge dann Charaktere, eine Farbe und Tasten hinzu.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.clients.groups.new">Neue Gruppe…</sys:String> <!-- draft -->
