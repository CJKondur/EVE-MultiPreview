    <sys:String x:Key="L.S.clients.windows.minimizeInactive.Desc">Minimierte Clients zeichnen nicht mehr, das spart viel GPU.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.minimizeDelay">Vor dem Minimieren warten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMinimize">Nie minimieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMinimize.Desc">Diese Charaktere bleiben beim Wegwechseln geöffnet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMinimize.Empty">Noch niemand.</sys:String> <!-- draft -->
