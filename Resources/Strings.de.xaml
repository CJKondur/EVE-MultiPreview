    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ Über</sys:String>
    <sys:String x:Key="L.About.Edition">C# / WPF Edition</sys:String>
    <sys:String x:Key="L.About.Desc">Multi-Client-Vorschauverwaltung für EVE Online. Zeigt Live-DWM-Vorschauen deiner EVE-Fenster mit Klick-zum-Wechseln, Ziehen-zum-Neupositionieren, benutzerdefinierten Rahmen, Warnungen, Statistik-Überlagerungen und Hotkeys pro Charakter.</sys:String>
    <sys:String x:Key="L.About.Origin">Ursprünglich in AutoHotkey v2 von CJKondur geschrieben.</sys:String>
    <sys:String x:Key="L.About.Ported">Für verbesserte Leistung, Stabilität und Erweiterbarkeit nach C# WPF portiert.</sys:String>
    <sys:String x:Key="L.About.GitHub">🔗 GitHub</sys:String>
    <sys:String x:Key="L.About.CheckUpdates">🔄 Nach Updates suchen</sys:String>
    <sys:String x:Key="L.About.CheckOnStartup">Beim Programmstart nach Updates suchen</sys:String>
    <sys:String x:Key="L.About.PreRelease">Vorabversionen empfangen</sys:String>
    <sys:String x:Key="L.About.PreReleaseNote">Vorabversionen können Fehler oder Breaking Changes enthalten. Einstellungen können zwischen Vorabversion-Updates zurückgesetzt werden.</sys:String>
    <sys:String x:Key="L.About.OtherVersionNote">Wähle eine beliebige veröffentlichte Version, älter oder neuer, um sie anstelle dieser zu installieren — praktisch, wenn ein Update bei dir etwas kaputt gemacht hat. Deine Einstellungen werden vorher gesichert. Beim Wechsel auf eine ältere Version wird die Update-Prüfung beim Start ausgeschaltet, damit sie nicht sofort wieder ein Update anbietet.</sys:String>
    <sys:String x:Key="L.About.InstallVersion">⬇ Installieren…</sys:String>
    <sys:String x:Key="L.About.OtherVersion">Bestimmte Version installieren:</sys:String>

