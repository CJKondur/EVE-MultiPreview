    <!-- Ideas batch 1 (Plan 5) -->
    <sys:String x:Key="L.S.Sec.alerts.look.repeats">Wiederholungen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.look.waitBySeverity">Ruhezeit pro Schweregrad</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.look.waitBySeverity.Desc">An: Kritische, Warn- und Info-Alarme warten jeweils ihre eigene Zeit, bevor derselbe Alarm für einen Charakter erneut erscheint. Aus: Jeder Alarm wartet die Ruhezeit der Seite Ereignisse.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.look.waitCritical">Kritische Alarme bleiben still für</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.look.waitWarning">Warnalarme bleiben still für</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.look.waitInfo">Info-Alarme bleiben still für</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.events.repeatBySeverity">Jeder Schweregrad hat seine eigene Ruhezeit: Warnungen › Aussehen &amp; Schweregrad.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.alerts.look.repeats.Title">Ruhezeit pro Schweregrad</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.alerts.look.repeats.Body">Ein Alarm, der gerade für einen Charakter ausgelöst wurde, bleibt eine Weile still, damit dich ein Kampf nicht mit demselben Alarm überflutet.&#x0A;- Ist **Ruhezeit pro Schweregrad** aus, wartet jeder Alarm die Ruhezeit der Seite Ereignisse (5 Sekunden, falls du sie nicht geändert hast).&#x0A;- Eingeschaltet warten kritische, Warn- und Info-Alarme jeweils ihre eigene Zeit, zum Beispiel 2 Sekunden für kritische und 60 für Info. Jede beginnt bei 5 Sekunden, unabhängig von der Ruhezeit der Seite Ereignisse; das Einschalten kann also ändern, wie lange Alarme warten, bis du eigene Zahlen einstellst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.minSizeOn">Mindestgröße der Vorschaubilder begrenzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.minSizeOn.Desc">Aus: Beim Skalieren von Hand hört ein Vorschaubild bei 80 × 50 auf. An: Es hört bei der Größe darunter auf.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.minWidth">Kleinste Breite</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.minHeight">Kleinste Höhe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.gap">Abstand zwischen Vorschaubildern</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.gap.Desc">Der Platz, den MultiPreview zwischen Vorschaubildern lässt, die es selbst platziert: Clients ohne gespeicherten Platz und Alle Positionen zurücksetzen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.countNpc">NPC-Schaden zählen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.countNpc.Desc">Aus: Treffer von und auf NPCs bleiben aus den Schadenswerten heraus, sie zeigen also nur Kämpfe mit Spielern. ISK vom Ratting zählt weiterhin.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorText">Textfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorText.Desc">Färbt den Text auf dem Vorschaubild dieses Charakters. Solange du keine Farbe wählst, gilt die Textfarbe aus Vorschaubilder › Text und Rahmen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.ColorBlind.ConfirmOffRestore">Farbenblind-Modus ausschalten? Deine Farben für Alarme, Hervorhebung, Vorschaubild-Text, Login-Markierung und Statistik sowie die Farben, die du einzelnen Ereignissen gegeben hast, kehren zu dem zurück, was sie vor dem Einschalten waren.</sys:String> <!-- draft -->
    <!-- Ideas batch 2 (Plan 6) -->
    <sys:String x:Key="L.Start.Newer.Title">Eine neuere Einstellungsdatei wurde gefunden</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Newer.Body">Deine Einstellungsdatei ist:&#x0A;{0}&#x0A;zuletzt geändert {1}.&#x0A;&#x0A;Eine andere Einstellungsdatei wurde danach geändert, am {3}:&#x0A;{2}&#x0A;&#x0A;Das passiert, wenn eine ältere Version von MultiPreview aus diesem Ordner gestartet wurde oder eine Einstellungsdatei dorthin kopiert wurde. Die neuere Datei verwenden? Deine aktuellen Einstellungen werden vorher im Ordner Backups gesichert.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Newer.Use">Neuere Datei verwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Newer.Keep">Meine aktuellen Einstellungen behalten</sys:String> <!-- draft -->
    <sys:String x:Key="L.Upd.HandBackFailed">Deine aktuellen Einstellungen konnten nicht an die ältere Version übergeben werden. Sie startet mit den Einstellungen, die zuletzt neben der exe gespeichert wurden. Klicke noch einmal auf {0}, um trotzdem zu installieren.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Title">Deine Einstellungen konnten nicht gelesen werden</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Body">MultiPreview konnte deine Einstellungsdatei nicht lesen:&#x0A;{0}&#x0A;&#x0A;Wähle eine Kopie zum Wiederherstellen. Die Datei, die nicht gelesen werden konnte, bleibt im Ordner Backups erhalten.&#x0A;&#x0A;Wenn du mit den Standardeinstellungen startest, bleibt deine Datei unverändert und nichts, was du in dieser Sitzung änderst, wird gespeichert.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.None">MultiPreview konnte deine Einstellungsdatei nicht lesen:&#x0A;{0}&#x0A;&#x0A;Es gibt kein Backup zum Wiederherstellen. MultiPreview startet mit den Standardeinstellungen, lässt deine Datei unverändert und speichert nichts, was du in dieser Sitzung änderst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Item">Wiederherstellen von {0} ({1})</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Defaults">Mit Standardeinstellungen starten (deine Datei bleibt erhalten)</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Startup">Kopie, die beim Start von MultiPreview erstellt wurde</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Update">Kopie, die vor einem Update erstellt wurde</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.BesideExe">die Einstellungsdatei neben MultiPreview.exe</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Backup">eine gespeicherte Kopie im Ordner Backups</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Restore.Failed">Diese Kopie konnte nicht wiederhergestellt werden. Wähle eine andere.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Move.Note">EVE MultiPreview speichert seine Einstellungen jetzt in diesem Ordner:&#x0A;{0}&#x0A;&#x0A;Die Einstellungsdatei hier neben MultiPreview.exe ist die Kopie von vor Version {2}. MultiPreview verwendet sie nicht mehr (außer im Fall einer älteren Version, siehe unten), und du kannst sie als Sicherung behalten. Falls die Einstellungsdatei oben jemals fehlt, fragt MultiPreview beim nächsten Start, welche Kopie wiederhergestellt werden soll: eines seiner neueren Backups oder diese Datei. Gibt es kein neueres Backup, kopiert es diese Datei ohne Nachfrage zurück.&#x0A;&#x0A;Wenn du stattdessen alles neben der exe behalten willst (portable Installation, zum Beispiel auf einem USB-Stick): Schließe MultiPreview, kopiere die Einstellungsdatei (und layout_presets.json, falls du Layout-Vorlagen nutzt) aus dem Ordner oben in diesen Ordner und lege hier eine leere Datei namens {1} an. Danach liest und speichert MultiPreview seine Dateien wieder hier.&#x0A;&#x0A;Wenn du unter Einstellungen › App-Einstellungen › Info &amp; Updates eine ältere Version installierst, kopiert MultiPreview zuerst deine aktuellen Einstellungen und Layout-Vorlagen hierher, weil ältere Versionen die Dateien neben der exe lesen. Die Dateien, die hier lagen, bleiben im Ordner Backups im Ordner oben erhalten.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Crash.Title">MultiPreview wurde unerwartet beendet</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Crash.Body">Die letzte Sitzung, gestartet {0}, endete, ohne dass MultiPreview geschlossen wurde: Es ist abgestürzt oder wurde über den Task-Manager oder durch einen Stromausfall beendet. Falls etwas schiefgelaufen ist, steht in error_log.txt im Ordner Logs vielleicht mehr. Hänge die Datei an einen Fehlerbericht an.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Crash.Open">Ordner Logs öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Crash.Close">Schließen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Tray.Errors">Behandelte Fehler: {0}. Siehe App-Einstellungen › Diagnose.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.profiles.folderText">Deine Einstellungen liegen in {0}.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.app.profiles.openFolder">Ordner öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.app.diagnostics.errors">Fehler</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.diagnostics.errorCount">Seit dem Start von MultiPreview behandelte Fehler: {0}. Es lief weiter. Das Fehlerprotokoll enthält die Details für einen Fehlerbericht.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.diagnostics.uncleanExit">Die letzte Sitzung, gestartet {0}, wurde nicht normal beendet: MultiPreview ist abgestürzt oder wurde beendet. Das Fehlerprotokoll nennt vielleicht den Grund.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.diagnostics.errorLog">Fehlerprotokoll</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.diagnostics.errorLog.Desc">Fehler, die MultiPreview behandelt hat, ohne anzuhalten; sie liegen im Logs-Ordner.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.app.diagnostics.openErrorLog">Fehlerprotokoll öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.app.diagnostics.errors.Title">Fehler und unerwartetes Beenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.app.diagnostics.errors.Body">MultiPreview läuft weiter, wenn etwas schiefgeht, und schreibt auf, was passiert ist, ins **Fehlerprotokoll**. Solange es behandelte Fehler gibt, nennt der Tooltip des Tray-Symbols ihre Anzahl.&#x0A;&#x0A;Wenn MultiPreview beendet wurde, ohne dass du es geschlossen hast (Absturz, Task-Manager, Stromausfall), sagt es das beim nächsten Start und bietet den Logs-Ordner an.&#x0A;&#x0A;Hänge bei einem Fehlerbericht error_log.txt aus dem Logs-Ordner an.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Missing.Title">Deine Einstellungsdatei fehlt</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Missing.Body">MultiPreview kann deine Einstellungsdatei nicht finden:&#x0A;{0}&#x0A;&#x0A;Die Datei fehlt, aber es wurden Kopien deiner Einstellungen gefunden. Wähle eine zum Wiederherstellen.&#x0A;&#x0A;„Neu anfangen“ startet wieder mit den Standardeinstellungen, wie beim ersten Start. Deine Backups bleiben im Ordner Backups.&#x0A;&#x0A;Wenn du dieses Fenster schließt, verwendet MultiPreview in dieser Sitzung die Standardeinstellungen, speichert nichts und fragt beim nächsten Start erneut.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Start.Missing.Fresh">Neu anfangen</sys:String> <!-- draft -->
    <!-- Ideas batch 3 (Plan 7) -->
    <sys:String x:Key="L.Upd.NoDigest">GitHub hat für dieses Release keine Prüfsumme geliefert, deshalb kann MultiPreview den Download nicht prüfen. Klicke noch einmal auf {0}, um trotzdem zu installieren, oder auf {1}, um die Datei selbst von GitHub zu laden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Upd.DigestMismatch">Es ließ sich nicht bestätigen, dass die heruntergeladene Datei die ist, die GitHub veröffentlicht hat. Sie wird deshalb nicht installiert. Klicke auf {0}, um es noch einmal zu versuchen, oder auf {1}, um die Datei selbst von GitHub zu laden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Upd.DigestUnreadable">Die Prüfsumme, die GitHub für dieses Release angibt, hat ein Format, das MultiPreview nicht lesen kann. Deshalb lädt und installiert MultiPreview dieses Release nicht. Klicke auf {1}, um die Datei selbst von GitHub zu laden.</sys:String> <!-- draft -->
    <!-- Ideas batch 4 (Plan 8) -->
    <sys:String x:Key="L.S.Sec.alerts.hub.history">Verlauf</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.hub.keepHistory">Alarmverlauf führen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.hub.keepHistory.Desc">Jeder Alarm kommt in eine Liste auf diesem PC: wann, welcher Charakter, welcher Alarm und wo. Aus: Es kommt nichts Neues dazu.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.hub.historyDays">Alarme aufbewahren für</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.hub.historyDays.Desc">Ältere Tage werden gelöscht, wenn MultiPreview startet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.hub.historyFolder">Der Verlauf bleibt auf diesem PC, in {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.alerts.hub.history.Title">Alarmverlauf</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.alerts.hub.history.Body">MultiPreview führt eine Liste aller Alarme, die auslösen: Zeit, Charakter, Alarm, Schweregrad, Sonnensystem und ob der Alarm gezeigt wurde oder der Charakter stummgeschaltet war. Ein Alarm, den du abgeschaltet hast, steht nicht darin, eine Wiederholung innerhalb der Ruhezeit auch nicht.&#x0A;&#x0A;- Die Liste ist eine Datei pro Tag im Ordner History in deinem Einstellungsordner. MultiPreview bewahrt sie dort auf und sendet sie nirgendwohin. Eine CSV-Datei, die du aus dem Verlaufsfenster exportierst, landet dort, wo du sie speicherst, und enthält denselben Text.&#x0A;- Bei einem Alarm einer deiner eigenen Regeln stehen in der Liste auch der Name der Regel und die Zeile, die sie gefunden hat, auf 160 Zeichen gekürzt. Eine Zeile des Game-Logs kann andere Spieler nennen, und in einem Chat-Kanal hat die Zeile ein anderer Spieler geschrieben.&#x0A;- **Alarme aufbewahren für** legt fest, wie viele Tage bleiben, 30, solange du nichts änderst. Ältere Tage werden beim nächsten Start von MultiPreview gelöscht.&#x0A;- Ist **Alarmverlauf führen** aus, wird nichts Neues geschrieben. Was schon da ist, bleibt, bis seine Tage abgelaufen sind oder du den Verlauf leerst.</sys:String> <!-- draft -->
