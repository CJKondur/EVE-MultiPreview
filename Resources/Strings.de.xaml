    <sys:String x:Key="L.S.Slot.DeleteTitle">Slot löschen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.DeleteConfirm">Den Slot „{0}“ löschen? Seine Charaktere gehen stattdessen in den Standard-Slot.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.Characters">Charaktere</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.AddCharacter">Hinzufügen…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.AddCharacterTitle">Einen Charakter an „{0}“ senden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.NoClients">Es laufen keine angemeldeten Clients.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.CaptureFail">Dieser Client ist nicht in einem normalen Fenster (evtl. minimiert oder maximiert). Stelle ihn wieder her und versuche es erneut.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.NoMonitor">Monitor nicht verbunden: Dieser Slot wird übersprungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.TooSmall">Zu klein: Minimum ist 640×360. Dieser Slot wird übersprungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.NoFit">Passt nicht auf den {0}×{1}-Monitor: Dieser Slot wird übersprungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.WhoDefault">Standard-Slot</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.Scaled">Die Windows-Skalierung dieses Monitors weicht von der des primären ab, daher wird das Bild von EVE hier neu skaliert. Positionen sind in MultiPreview-Einheiten von {0}×{1} für diesen {2}×{3}-Monitor angegeben. Für einen pixelgenauen Client gib ihm dieselbe Skalierung wie dem primären.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMove">Nie verschieben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMove.Desc">Die Fenster dieser Charaktere werden nie verschoben oder in der Größe geändert, auch nicht mit Standard-Slot.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Slot.NeverMoveTitle">Diesen Charakter nie verschieben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.slotsResize">Clients auf ihre Slot-Größe bringen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.slotsResize.Desc">Aus: Clients werden nur an Ort und Stelle verschoben und behalten ihre Größe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.windows.charSelect">Charakterauswahl</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.charSelectCycle">Bei der Charakterauswahl zwischen Clients wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.charSelectCycle.Desc">Zwei zusätzliche Tasten zum Anmelden vieler Clients.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.charSelectNext">Nächster Client bei der Charakterauswahl</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.charSelectPrevious">Vorheriger Client bei der Charakterauswahl</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.Intro">Wie MultiPreview mit deinen EVE-Fenstern umgeht: Minimieren der verlassenen und wohin jedes Fenster kommt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.minimize.Title">Minimieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.minimize.Body">**Clients beim Wegwechseln minimieren** minimiert beim Wechsel alle anderen Clients, sodass nur der gespielte zeichnet. Das spart bei vielen Clients viel GPU.&#x0A;&#x0A;Charaktere auf der Liste **Nie minimieren** bleiben geöffnet, zum Beispiel ein Scout, den du im Blick behältst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.position.Title">Wohin Fenster kommen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.position.Body">MultiPreview kann jeden Client verschieben, wenn er gefunden wird und bei jedem Wechsel zu ihm:&#x0A;- **Auf dem Monitor zentriert**&#x0A;- **An festem X und Y**&#x0A;- **In festen Slots**: Plätze auf deinen Monitoren, einer pro Charakter oder geteilt.&#x0A;&#x0A;**Merken, wo jedes Clientfenster war** setzt stattdessen jeden Client dorthin zurück, wo du ihn verlassen hast.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.slots.Title">Feste Slots</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.slots.Body">Ein Slot ist ein Rechteck auf einem Monitor. Führe Charaktere in einem Slot auf, um sie dorthin zu schicken; alle anderen gehen in den **Standard**-Slot oder bleiben, wo sie sind, wenn es keinen gibt.&#x0A;&#x0A;**Von einem Client kopieren** übernimmt das aktuelle Fenster eines laufenden Clients. Ein Slot muss mindestens 640×360 groß sein und auf seinen Monitor passen, sonst wird er übersprungen.&#x0A;&#x0A;**Clients jetzt einrasten** bewegt jeden laufenden Client in seinen Slot.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.charSelect.Title">Charakterauswahl</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.windows.charSelect.Body">Schalte das ein für zwei Tasten, mit denen du zwischen Clients wechselst, die noch auf dem Charakterauswahl-Bildschirm sind, praktisch beim Anmelden vieler Clients nacheinander.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.clients.audio">Spielton</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.clients.audio.Desc">Hör nur den Client, den du spielst, und stelle die Lautstärke jedes Clients ein.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.audio.solo">Nur aktiver Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.autoSolo">Nur den aktiven Client hören</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.autoSolo.Desc">Beim Wechsel werden die anderen EVE-Clients stummgeschaltet. Gilt ab dem nächsten Wechsel; beim Ausschalten werden sie sofort wieder eingeschaltet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.muteNoneActive">Alles stummschalten, wenn kein EVE-Client vorne ist</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.muteNoneActive.Desc">Statt den zuletzt gespielten Client hörbar zu lassen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.audio.volumes">Lautstärke pro Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.volume">Laufende Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.volume.Desc">Die Lautstärke jedes Clients in Windows. Ein Client merkt sie sich für das nächste Mal.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.audio.volume.Empty">Es laufen keine Clients.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.audio.Intro">Hör nur den Client, den du spielst, und stelle die Lautstärke jedes Clients einzeln ein.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.audio.solo.Title">Nur der aktive Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.audio.solo.Body">Ist **Nur den aktiven Client hören** an, schaltet ein Wechsel jeden anderen EVE-Client stumm und den, zu dem du wechselst, wieder laut. **Alles stummschalten, wenn kein EVE-Client vorne ist** schaltet auch den letzten stumm, wenn du zu einer anderen App gehst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.audio.volume.Title">Lautstärke pro Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.audio.volume.Body">Jeder laufende Client bekommt einen Regler. Die Lautstärke wird pro Charakter gemerkt und beim Wechsel zu ihm erneut angewendet. Du kannst sie auch im Rechtsklick-Menü einer Vorschau einstellen.</sys:String> <!-- draft -->
    <!-- Home (draft) -->
    <sys:String x:Key="L.S.Page.home">Start</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.home.Desc">Das Wichtigste: deine Clients, die Tasten zum Wechseln, Vorschaubilder und Kampfwarnungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.welcome">Einfacher Modus</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.simpleBanner">Du bist im einfachen Modus: Diese Seite hat, was die meisten Spieler brauchen. Alle anderen Einstellungen sind einen Klick entfernt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.showAllRow">Alle Einstellungen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.showAllRow.Desc">Zeigt alle Seiten in der Navigation. Mit dem Schalter unten links wechselst du zurück.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.home.showAll">Alle Einstellungen anzeigen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.clients">Deine Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.empty">Es läuft kein EVE-Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.empty.Desc">Starte EVE und melde dich an: Jeder Charakter bekommt hier eine Kachel mit Hotkey und Vorschau-Schalter.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Home.Show">Vorschau</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Home.GroupRow">{0} · {1} Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.switching">Wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.groupKeys">Gruppentasten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.groupKeys.Desc">Jede Gruppe in diesem Profil schaltet durch ihre eigenen Mitglieder.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.next">Nächster Client, alle laufenden Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.next.Desc">Geht durch jeden laufenden Client, egal in welcher Gruppe. Jede Kachel oben kann auch eine eigene Taste haben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.previous">Vorheriger Client, alle laufenden Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.thumbnails">Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.size">Größe der Vorschau</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.size.Desc">Breite jeder Vorschau; die Höhe folgt im Format 16:9. Zieh am Rand einer Vorschau, um nur sie anzupassen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.opacity">Deckkraft</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.opacity.Desc">Niedriger lässt das Spiel durch die Vorschaubilder scheinen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.monitor">Monitor für neue Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.monitor.Desc">Wo Vorschaubilder erscheinen, bevor du sie verschiebst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Monitor.Item">Monitor {0}: {1}×{2}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Monitor.Primary">(primär)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.alerts">Kampfwarnungen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertAttack">Unter Beschuss</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertAttack.Desc">Ein Client wird beschossen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertScram">Warp gestört</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertScram.Desc">Ein Client kann nicht wegwarpen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertDecloak">Enttarnt</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertDecloak.Desc">Die Tarnung eines Clients ist gefallen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertFleet">Flotteneinladung</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertFleet.Desc">Ein Client wurde in eine Flotte eingeladen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertSound">Ton abspielen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.alertSound.Desc">Die Töne wählst du unter Warnungen › Töne.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.quick">Schnellaktionen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.quick.hideAll">Alle Vorschaubilder ausblenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.quick.lock">Positionen der Vorschaubilder sperren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.quick.pause">Hotkeys pausieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.quick.clickThrough">Vorschaubilder durchklickbar</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.home.startup">Start</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.startWithWindows">Mit Windows starten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.home.startWithWindows.Desc">Startet MultiPreview im Infobereich, wenn du dich bei Windows anmeldest.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.Intro">Alles für den Einstieg auf einer Seite: deine Clients, die Tasten zum Wechseln, die Größe der Vorschaubilder und die Warnungen, die im Kampf zählen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.clients.Title">Deine Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.clients.Body">Jeder laufende Charakter bekommt eine Kachel. Klick auf die Taste, um einen Hotkey aufzunehmen, der direkt zu ihm wechselt, und blende die Vorschau mit dem Schalter aus oder ein. **›** öffnet alle Einstellungen dieses Charakters.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.switching.Title">Clients wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.switching.Body">**Gruppentasten** schalten durch die Mitglieder einer Gruppe, in deren Reihenfolge: Stelle sie hier oder unter Clients › Gruppen ein.&#x0A;**Nächster Client** und **Vorheriger Client, alle laufenden Clients** gehen durch alle laufenden Clients. Halte eine Taste, um weiterzuschalten.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.thumbnails.Title">Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.thumbnails.Body">**Größe der Vorschau** stellt alle Vorschaubilder auf einmal ein und behält das Format 16:9. Zieh eine Vorschau, um sie zu verschieben, oder zieh an ihrem Rand, um nur sie anzupassen.&#x0A;&#x0A;**Deckkraft** lässt das Spiel durchscheinen. Mehr Optionen findest du unter Vorschaubilder in allen Einstellungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.alerts.Title">Kampfwarnungen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.alerts.Body">MultiPreview liest die Chat- und Kampfprotokolle von EVE und lässt die Vorschau des Clients blinken, der dich braucht. Schalte die Ereignisse ein, die dir wichtig sind. Alle anderen Ereignisse, Farben und Töne findest du unter Warnungen in allen Einstellungen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.quick.Title">Schnellaktionen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.home.quick.Body">Jeder Schalter tut dasselbe wie sein daneben gezeigter Hotkey: alle Vorschaubilder ausblenden, an Ort und Stelle sperren, alle Hotkeys pausieren oder Klicks durch die Vorschaubilder lassen.&#x0A;&#x0A;**Alle Einstellungen anzeigen** öffnet alle Seiten, falls du mehr als das Wichtigste willst.</sys:String> <!-- draft -->
    <!-- Thumbnails › Appearance (Plan 3b) -->
    <sys:String x:Key="L.S.Page.thumbs.appearance">Darstellung</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.thumbs.appearance.Desc">Größe, Deckkraft, Zoom und Hintergrund für alle Vorschaubilder.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.appearance.size">Größe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.resizeAll">Alle Vorschaubilder skalieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.resizeAll.Desc">Breite × Höhe. „Auf alle anwenden“ skaliert jedes Vorschaubild an Ort und Stelle; neue Vorschaubilder starten mit dieser Größe. Rückgängig unter Layout &amp; Bildschirme.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.appearance.applySize">Auf alle anwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.individualResize">Vorschaubilder einzeln skalieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.individualResize.Desc">An: Das Skalieren ändert nur dieses eine Vorschaubild. Aus: Alle folgen, außer du hältst Strg gedrückt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.appearance.seeThrough">Deckkraft</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.opacity">Deckkraft</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.opacity.Desc">Niedriger lässt mehr vom Spiel dahinter durchscheinen. Dieselbe Einstellung wie auf Start.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.opacityOnHover">Undurchsichtig unter der Maus</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.opacityOnHover.Desc">Ein Vorschaubild wird voll undurchsichtig, solange die Maus darüber ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.appearance.zoom">Hover-Zoom</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.hoverZoom">Zoom unter der Maus</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.hoverZoom.Desc">Ein Vorschaubild wächst, solange die Maus darauf ruht.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.hoverScale">Zoomgröße</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.hoverScale.Desc">Wie groß es wird, verglichen mit der normalen Größe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.appearance.backdrop">Hintergrund</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.background">Hintergrundfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.appearance.background.Desc">Füllt ein Vorschaubild, wo kein Bild ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.appearance.Intro">Wie jedes Vorschaubild aussieht: seine Größe, wie viel vom Spiel durchscheint, der Zoom unter der Maus und die Farbe hinter dem Bild. Ein Charakter kann auch eine eigene Größe haben, die auf seiner Seite eingestellt wird.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.appearance.size.Title">Vorschaubilder skalieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.appearance.size.Body">**Alle Vorschaubilder skalieren** gibt allen auf einmal genau dieselbe Größe, und neue Vorschaubilder starten damit. Die Vorschaubilder bleiben, wo sie sind, und **Rückgängig** (Layout &amp; Bildschirme) stellt die alten Größen wieder her.&#x0A;&#x0A;Zum Skalieren von Hand halte die rechte Maustaste auf einem Vorschaubild, drücke zusätzlich die linke und ziehe. Ist **Vorschaubilder einzeln skalieren** aus, folgen alle; halte Strg, um nur eines zu skalieren.&#x0A;&#x0A;**Mindestgröße der Vorschaubilder begrenzen** legt die kleinste Größe fest, die ein Ziehen ergeben kann. Solange es aus ist, sind das 80 × 50.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.appearance.look.Title">Deckkraft, Zoom und Hintergrund</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.appearance.look.Body">- **Deckkraft** lässt das Spiel dahinter durchscheinen. **Undurchsichtig unter der Maus** macht ein Vorschaubild undurchsichtig, solange du darauf zeigst.&#x0A;- **Zoom unter der Maus** vergrößert ein Vorschaubild, solange die Maus darauf ruht, auf die gewählte **Zoomgröße**.&#x0A;- **Hintergrundfarbe** füllt ein Vorschaubild, wo kein Bild ist.</sys:String> <!-- draft -->
    <!-- Thumbnails Text and borders (Plan 3b) -->
    <sys:String x:Key="L.S.Page.thumbs.text">Text und Rahmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.thumbs.text.Desc">Was jede Vorschau über dem Bild zeigt, und die Rahmen, die Clients unterscheiden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.labels">Text auf Vorschauen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showText">Charaktername</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showText.Desc">Jede Vorschau zeigt den Namen ihres Charakters.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem">Sonnensystem</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem.Desc">Das System, in dem sich jeder Charakter befindet, gelesen aus seinen EVE-Logs.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showTimer">Sitzungstimer</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showTimer.Desc">Wie lange jeder Client geöffnet ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.color">Textfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.color.Desc">Wird auch für die Namen der Ausschnittfenster verwendet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.font">Schriftart</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.font.Desc">Der Name einer in Windows installierten Schriftart, z. B. Segoe UI.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.size">Textgröße</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.marginX">Abstand zum linken Rand</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.marginY">Abstand zum oberen Rand</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Err.FontName">Gib den Namen einer Schriftart ein, z. B. Segoe UI.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.stats">Client-Statistik</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showStats">CPU-, Speicher- und Grafikauslastung</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showStats.Desc">CPU-, RAM- und VRAM-Nutzung jedes Clients, alle paar Sekunden aktualisiert.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.statsSize">Textgröße der Statistik</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.active">Der Client, den du spielst</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlight">Hervorhebungsrahmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlight.Desc">Ein farbiger Rahmen markiert den Client im Vordergrund. Änderungen zeigen sich, wenn du zu EVE zurückkehrst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightColor">Hervorhebungsfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightWidth">Hervorhebungsbreite</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightInGroup">Hervorhebung in farbiger Gruppe beibehalten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightInGroup.Desc">Bei aktiven Gruppenrahmen behält der Client, den du spielst, die Hervorhebungsfarbe statt der Farbe seiner Gruppe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.others">Andere Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveColor">Rahmenfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveColor.Desc">Um jede andere Vorschau. Leer lassen für keinen Rahmen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveWidth">Rahmenbreite</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveWidth.Desc">0 blendet den Rahmen aus.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.groupBorders">Gruppenfarben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.groupBorders.Desc">Damit der Rahmen jedes Gruppenmitglieds in der Farbe seiner Gruppe gezeichnet wird, aktiviere „Gruppenrahmen anzeigen“ auf der Seite „Gruppen“.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.text.openGroups">Gruppen öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.marks">Markierungen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.badgePosition">Wo die Markierung für übersprungene Clients erscheint</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.badgePosition.Desc">Ein aus dem Wechsel genommener Client zeigt hier ein rotes ✕.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorTopLeft">Oben links</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorTop">Oben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorTopRight">Oben rechts</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorLeft">Links</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorCenter">Mitte</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorRight">Rechts</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorBottomLeft">Unten links</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorBottom">Unten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.AnchorBottomRight">Unten rechts</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.Intro">Was jede Vorschau über dem Bild zeigt, und die Rahmen, die den Client, den du spielst, von den übrigen unterscheiden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.text.Title">Text auf Vorschauen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.text.Body">Aktiviere den Charakternamen, das Sonnensystem (aus den EVE-Logs gelesen) und den Sitzungstimer. **Textfarbe**, **Schriftart** und **Textgröße** gelten für alle davon und für die Namen der Ausschnittfenster.&#x0A;&#x0A;Das eigene Label eines Charakters mit eigener Farbe und Größe wird auf der Seite dieses Charakters festgelegt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.stats.Title">Client-Statistik</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.stats.Body">Zeigt, wie viel CPU, Arbeitsspeicher (RAM) und Grafikspeicher (VRAM) jeder Client nutzt, alle paar Sekunden aktualisiert. Praktisch, um einen Client zu erkennen, der Probleme hat.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.borders.Title">Rahmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.borders.Body">- Der **Hervorhebungsrahmen** markiert den Client, den du spielst. Änderungen zeigen sich, wenn du zu EVE zurückkehrst.&#x0A;- Jeder andere Client erhält den Rahmen unter **Andere Clients**. Lass die Farbe leer für keinen Rahmen.&#x0A;- Gruppen können ihre Mitglieder in der Gruppenfarbe zeichnen (Clients › Gruppen). **Hervorhebung in farbiger Gruppe beibehalten** behält die Hervorhebungsfarbe beim Client, den du spielst.&#x0A;- Die eigenen Rahmenfarben eines Charakters werden auf dessen Seite festgelegt und gelten, solange **Farben pro Charakter verwenden** aktiv ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.marks.Title">Die Markierung für übersprungene Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.text.marks.Body">Ein Client, den du aus dem Wechsel nimmst (standardmäßig Shift+Klick), zeigt ein rotes ✕. Wähle, an welcher Ecke oder Kante der Vorschau es sitzt.</sys:String> <!-- draft -->
    <!-- Thumbnails › Layout &amp; screens (Plan 3b) -->
    <sys:String x:Key="L.S.Page.thumbs.layout">Layout &amp; Bildschirme</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.thumbs.layout.Desc">Wo Vorschaubilder erscheinen, wie sie sich ausrichten, gespeicherte Layouts und Rückgängig.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.screens">Bildschirme</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.monitor">Monitor für neue Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.monitor.Desc">Wo Vorschaubilder erscheinen, bevor du sie verschiebst. Dieselbe Einstellung wie auf Start.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.identifyRow">Welcher Bildschirm ist welcher</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.identifyRow.Desc">Zeigt kurz die Nummer jedes Monitors darauf an. Die Nummern von MultiPreview können von den Windows-Anzeigenummern abweichen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.layout.identify">Identifizieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Monitor.Badge">Monitor {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.newThumbnails">Neue Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startX">Abstand vom linken Bildschirmrand</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startX.Desc">Wo ein Vorschaubild ohne gespeicherten Platz erscheint, auf dem Monitor oben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startY">Abstand vom oberen Bildschirmrand</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startWidth">Startbreite</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startWidth.Desc">Die Größe, mit der ein neues Vorschaubild startet. „Alle Vorschaubilder skalieren“ (Darstellung) setzt sie ebenfalls.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.startHeight">Starthöhe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.lining">Ausrichten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.snap">An Kanten einrasten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.snap.Desc">Ein losgelassenes Vorschaubild richtet sich an den Kanten seiner Nachbarn und des Bildschirms aus.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.snapDistance">Einrastabstand</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.snapDistance.Desc">Wie nah eine Kante sein muss, damit es einrastet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.confine">Ziehen auf einem Monitor halten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.confine.Desc">Ein gezogenes Vorschaubild bleibt auf dem Monitor, auf dem es gestartet ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.lock">Positionen der Vorschaubilder sperren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.lock.Desc">Vorschaubilder lassen sich nicht mehr durch Ziehen verschieben oder skalieren. Auch eine Schnellaktion auf Start und ein Hotkey.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.undo">Rückgängig und Zurücksetzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.history">Rückgängig, Wiederholen und Zurücksetzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.history.Desc">Macht das gleichzeitige Verschieben oder Skalieren aller Vorschaubilder, ein gespeichertes Layout oder ein Zurücksetzen rückgängig oder stellt es wieder her.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.layout.undo">Rückgängig</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.layout.redo">Wiederholen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.layout.reset">Alle Positionen zurücksetzen…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Layout.ResetTitle">Alle Positionen zurücksetzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Layout.ResetConfirm">Alle Vorschaubilder in einer Spalte dorthin zurücksetzen, wo neue Vorschaubilder erscheinen, in der Startgröße? Die in diesem Profil gespeicherten Plätze werden gelöscht. Du kannst es rückgängig machen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.Intro">Wo Vorschaubilder erscheinen und wie sie sich beim Ziehen ausrichten, gespeicherte Layouts, die du mit einem Klick wiederherstellst, und Rückgängig.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.screens.Title">Bildschirme und neue Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.screens.Body">Ein Vorschaubild ohne gespeicherten Platz erscheint auf dem **Monitor für neue Vorschaubilder**, im Abstand und in der Größe unter **Neue Vorschaubilder**.&#x0A;&#x0A;Mit **Identifizieren** siehst du, welcher Bildschirm welche Nummer hat: Die Nummern von MultiPreview können von den Windows-Anzeigenummern abweichen.&#x0A;&#x0A;MultiPreview stellt solche Vorschaubilder in eine Spalte, im Abstand von **Abstand zwischen Vorschaubildern**, und beginnt am unteren Bildschirmrand eine neue Spalte. **Alle Positionen zurücksetzen** ordnet alle Vorschaubilder so an.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.lining.Title">Vorschaubilder verschieben</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.lining.Body">Halte die rechte Maustaste auf einem Vorschaubild und ziehe, um es zu verschieben; halte zusätzlich Strg, um alle zu verschieben.&#x0A;- **An Kanten einrasten** richtet ein Vorschaubild beim Loslassen an seinen Nachbarn und am Bildschirmrand aus.&#x0A;- **Ziehen auf einem Monitor halten** verhindert, dass ein Vorschaubild auf einen anderen Bildschirm wechselt.&#x0A;- **Positionen der Vorschaubilder sperren** verhindert jedes Verschieben und Skalieren.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.history.Title">Rückgängig und Zurücksetzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.thumbs.layout.history.Body">**Rückgängig** und **Wiederholen** gehen durch Änderungen vor und zurück, die alle Vorschaubilder auf einmal verschoben oder skaliert haben: alle ziehen, alle skalieren, ein gespeichertes Layout oder ein Zurücksetzen. Dafür gibt es auch Hotkeys (Clients › Hotkeys &amp; Wechseln).&#x0A;&#x0A;**Alle Positionen zurücksetzen** setzt jedes Vorschaubild in einer Spalte an den Platz und in die Größe für neue Vorschaubilder und löscht die in diesem Profil gespeicherten Plätze.</sys:String> <!-- draft -->
    <!-- Thumbnails › Layout &amp; screens › Saved layouts (Plan 3b) -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.saved">Gespeicherte Layouts</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.presets">Deine Layouts</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.presets.Desc">Speichere, wo jedes Vorschaubild liegt und wie groß es ist, und stelle alles mit einem Klick wieder her (Layout-Vorlagen). Gilt für alle Profile.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Apply">Anwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Remap">Zuordnen und anwenden…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Delete">Löschen…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Save">Aktuelles Layout speichern…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Export">Exportieren…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Import">Importieren…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Empty">Noch keine gespeicherten Layouts. Ordne deine Vorschaubilder an und speichere das Layout.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.NoneUsed">Dieses Profil hat noch kein gespeichertes Layout verwendet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Current">Dieses Profil nutzte zuletzt: {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.PickFirst">Wähle zuerst ein gespeichertes Layout.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.Applied">Layout '{0}' angewendet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.NoClients">Es laufen keine Clients, die platziert werden könnten.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.NoThumbnails">Es gibt keine Vorschaubilder zum Speichern. Starte zuerst deine Clients.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.SaveTitle">Layout speichern</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.NamePrompt">Name für dieses Layout:</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Presets.ReplaceTitle">Layout ersetzen</sys:String> <!-- draft -->
