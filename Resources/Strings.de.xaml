    <sys:String x:Key="L.S.Sec.app.general.startup">Start</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.general.startupSettings">Beim Start von MultiPreview</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.general.startupSettings.Desc">Ob sich dieses Einstellungsfenster von selbst öffnet.</sys:String> <!-- draft -->
