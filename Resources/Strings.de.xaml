    <sys:String x:Key="L.S.Opt.ClickSwitch">Dorthin wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.ClickMinimize">Minimieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.ClickExclude">Beim Wechseln überspringen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.characters.Intro">Jeder Charakter, den MultiPreview kennt: die gerade laufenden und die, die du früher eingerichtet hast. Öffne einen Charakter mit ›, um alle seine Einstellungen auf einer Seite zu sehen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.characters.table.Title">Die Charakterliste</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.characters.table.Body">- **Hotkey** wechselt direkt zu diesem Charakter. Klicke darauf, um eine Taste aufzunehmen.&#x0A;- **Anzeigen** blendet sein Vorschaubild ein oder aus.&#x0A;- **Wechsel** nimmt ihn bis zum Neustart von MultiPreview aus den Tasten für nächsten und vorherigen Client heraus.&#x0A;- **›** öffnet die eigene Seite des Charakters.&#x0A;&#x0A;Zwei Charaktere können sich einen Hotkey teilen: Er wechselt dann zwischen ihnen.&#x0A;&#x0A;**Alle laufenden Clients hinzufügen** behält deine laufenden Charaktere in der Liste, auch nach dem Abmelden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.characters.clicks.Title">Klick auf Vorschaubilder</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.characters.clicks.Body">Ein einfacher Klick wechselt zu diesem Client. **Strg+Klick** und **Umschalt+Klick** können ihn stattdessen minimieren oder beim Wechseln überspringen. Strg ist auch die Ziel-sperren-Taste von EVE, wähle also, was zu deinem Spielstil passt.&#x0A;&#x0A;**Farben pro Charakter verwenden** aktiviert die Rahmen- und Textfarben, die du auf der Seite jedes Charakters festlegst.</sys:String> <!-- draft -->
    <!-- Character page (one per character) -->
    <sys:String x:Key="L.S.Page.character">Charakter</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.character.Desc">Alles, was MultiPreview zu diesem Charakter speichert, an einem Ort.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Unit.Pt">pt</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Unit.Px">px</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.switching">Wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.hotkey">Hotkey</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.hotkey.Desc">Wechselt direkt zu diesem Charakter. Mehrere Charaktere können dieselbe Taste teilen: Dann wechselt sie zwischen ihnen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle">Im Durchschalten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle.Desc">Aus: Die Tasten für nächsten und vorherigen Client sowie Gruppentasten überspringen diesen Charakter, bis MultiPreview neu startet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groups">Gruppen: {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.noGroup">In keiner Gruppe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groupsLink">Gruppen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groupsLink.Desc">Füge diesen Charakter auf der Seite „Gruppen“ einer Gruppe hinzu oder ändere seine Position.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.openGroups">Gruppen öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.thumbnail">Vorschau</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.show">Vorschau anzeigen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label">Beschriftung</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label.Desc">Zusätzlicher Text auf der Vorschau, z. B. Scout oder Logi. Leer lassen für keine. Beschriftungen gelten in allen Profilen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor">Beschriftungsfarbe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor.Desc">Leer lassen, um die Textfarbe der Vorschau zu verwenden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize">Beschriftungsgröße</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize.Desc">0 verwendet die Textgröße der Vorschau.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size">Eigene Größe</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.Desc">Breite und Höhe der Vorschau dieses Charakters. Ein laufender Charakter ändert sich sofort.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.applySize">Anwenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.NeedsLogin">Melde diesen Charakter einmal an, um ihm eine eigene Größe zu geben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip">Zweite Vorschau (PiP)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip.Desc">Eine zweite, separate Vorschau dieses Clients. Beim Ausschalten bleiben Position und Größe für später erhalten.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pipOpacity">Deckkraft der zweiten Vorschau</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.colors">Farben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsOff">Charakterfarben sind in diesem Profil aus. Aktiviere „Charakterfarben verwenden“ unter Clients › Charaktere, um diese zu nutzen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorActive">Rahmen bei aktiv</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorInactive">Rahmen bei inaktiv</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsReset">Zurück zu den Profilfarben</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.resetColors">Farben zurücksetzen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.Intro">Alles, was MultiPreview zu diesem Charakter speichert, an einem Ort. Änderungen gelten für das aktuelle Profil, sofern eine Karte nichts anderes sagt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.switching.Title">Zu diesem Charakter wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.switching.Body">Der **Hotkey** wechselt direkt zu diesem Charakter. Gib zwei Charakteren dieselbe Taste, wechselt sie zwischen ihnen.&#x0A;&#x0A;**Im Durchschalten** legt fest, ob die Tasten für nächsten und vorherigen Client hier anhalten. Wird beim Neustart von MultiPreview zurückgesetzt.&#x0A;&#x0A;Gruppen bearbeitest du auf der Seite **Gruppen**, wo du auch Tasten und Reihenfolge festlegst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.thumbnail.Title">Vorschau dieses Charakters</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.thumbnail.Body">- **Beschriftung** fügt deinen eigenen Text hinzu, z. B. Scout. Farbe und Größe können vom übrigen Text abweichen.&#x0A;- **Eigene Größe** gibt dieser Vorschau eine eigene Breite und Höhe. Der Charakter muss in diesem Profil einmal angemeldet gewesen sein.&#x0A;- **Zweite Vorschau** fügt eine separate Bild-in-Bild-Ansicht desselben Clients hinzu.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.colors.Title">Farben</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.colors.Body">Diese Farben gelten nur, solange **Farben pro Charakter verwenden** für das Profil aktiv ist (Clients › Charaktere).&#x0A;- Die zwei Rahmenfarben markieren das Vorschaubild dieses Charakters, je nachdem, ob es der Client ist, den du spielst, oder nicht.&#x0A;- **Textfarbe** färbt den Text auf seinem Vorschaubild. Solange du keine wählst, folgt sie Vorschaubilder › Text und Rahmen.&#x0A;&#x0A;**Farben zurücksetzen** kehrt zu den Farben zurück, die alle Charaktere verwenden.</sys:String> <!-- draft -->
    <!-- Character page, part 2 -->
    <sys:String x:Key="L.S.Sec.character.clients">Client-Fenster</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.neverMinimize">Nie minimieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.neverMinimize.Desc">Hält diesen Client geöffnet, wenn Clients beim Wechseln minimieren aktiv ist (Clients › Fenster &amp; Positionen).</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.core">CPU-Kern im Hintergrund</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.core.Desc">Gilt nur, solange die Hintergrundpriorität verwaltet wird (Leistung › CPU).</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.CoreAuto">Automatisch</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.CoreN">Kern {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.volume">Spiellautstärke</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.volume.Desc">Die Lautstärke dieses Clients in Windows. Ein laufender Client ändert sich sofort.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.stats">Statistik-Overlay</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsOff">Das Statistik-Overlay ist ausgeschaltet, daher haben diese Einstellungen keine Wirkung, bis es wieder aktiv ist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsNote">Standard folgt den Werten, die für alle Charaktere gewählt wurden. An oder Aus überschreibt eine ganze Gruppe von Werten für diesen Charakter. Wird keine Auswahl angezeigt, wurden die Werte einzeln gesetzt; eine Auswahl ersetzt sie.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsDamage">Schaden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsLogi">Reparaturen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsMining">Bergbau</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.statsRatting">Ratting</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.StatsDefault">Standard</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.StatsOn">An</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.StatsOff">Aus</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.crops">Ausschnittfenster</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cropCount">Ausschnittfenster für diesen Charakter: {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cropsLink">Ausschnittfenster</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cropsLink.Desc">Ausschnittfenster werden auf der Seite Ausschnittfenster hinzugefügt und bearbeitet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.openCrops">Ausschnittfenster öffnen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.remove">Vergessen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.forgetRow">Diesen Charakter vergessen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.forgetRow.Desc">Entfernt Hotkey, Farben, Beschriftung, Größe, Ausschnitte und alle anderen Einstellungen in allen Profilen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.forget">Vergessen…</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Character.ForgetTitle">Charakter vergessen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Character.ForgetConfirm">'{0}' vergessen? Die Einstellungen werden aus allen Profilen sowie aus seinen Gruppen und Slots entfernt. Das kann nicht rückgängig gemacht werden. Läuft der Client, bleibt er mit Standardeinstellungen in der Liste.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Character.Forgotten">'{0}' vergessen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.clients.Title">Client-Fenster, CPU und Ton</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.clients.Body">- **Nie minimieren** hält diesen Client geöffnet, wenn die anderen beim Wechseln minimiert werden.&#x0A;- **CPU-Kern im Hintergrund** bindet den Client an einen Kern, solange du ihn nicht spielst, sofern die Hintergrundpriorität verwaltet wird.&#x0A;- **Spiellautstärke** legt die Lautstärke dieses Clients in Windows fest. Sie wird für das nächste Mal gespeichert.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.stats.Title">Statistik-Overlay</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.stats.Body">Das Statistik-Overlay zeigt Werte wie Schaden pro Sekunde oder ISK pro Stunde neben einer Vorschau an. **Standard** nutzt die für alle Charaktere gewählten Werte. **An** oder **Aus** zeigt oder verbirgt eine ganze Gruppe nur für diesen Charakter.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.crops.Title">Ausschnittfenster</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.crops.Body">Ein Ausschnittfenster zeigt einen Teil dieses Clients, etwa die Übersicht, in einem eigenen kleinen Fenster. Ausschnittfenster werden auf der Seite Ausschnittfenster bearbeitet.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.remove.Title">Einen Charakter vergessen</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.remove.Body">**Vergessen** entfernt alles, was MultiPreview für diesen Charakter in allen Profilen speichert: Hotkey, Farben, Beschriftung, Größe, zweite Vorschau, Ausschnitte, Ton und seinen Platz in Gruppen und Slots. Nutze es für einen Charakter, den du nicht mehr spielst. Es fragt vorher nach und kann nicht rückgängig gemacht werden.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.clients.hotkeys">Hotkeys &amp; Wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.clients.hotkeys.Desc">Tasten, die Clients wechseln oder MultiPreview steuern, und wie sie sich verhalten.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Unit.Ms">ms</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Filter.Sounds">Sounddateien</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.hotkeys.behaviour">Verhalten der Hotkeys</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.scope">Hotkeys funktionieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.scope.Desc">Nur wenn EVE im Vordergrund ist lässt deine Tasten in anderen Apps in Ruhe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.ScopeEverywhere">Überall</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.ScopeEve">Nur wenn EVE im Vordergrund ist</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.wildcard">Hotkeys funktionieren bei gehaltenem Strg, Umschalt oder Alt</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.wildcard.Desc">An: Strg halten, um Ziele zu sperren, stoppt deine Hotkeys nicht. Aus: Ein Ein-Tasten-Hotkey wie V löst nur allein aus, sodass Strg+V weiter einfügt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideKeystrokes">Hotkeys vor EVE verbergen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideKeystrokes.Desc">Der Client, zu dem du wechselst, sieht den Hotkey nie. Aus: Er bekommt das Loslassen der Taste, wodurch dein erster Klick nur die Übersicht fokussieren kann.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.carryModifiers">Gehaltenes Strg, Umschalt und Alt zum nächsten Client mitnehmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.carryModifiers.Desc">Strg gedrückt zu halten, um zu sperren, funktioniert nach dem Wechsel weiter. Schalte es aus, wenn das Sperren nach dem Wechsel nicht mehr geht.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.carryKeys">Andere gehaltene Tasten zum nächsten Client mitnehmen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.carryKeys.Desc">Halte F1 und wechsle, um es auf jedem Client zu drücken. Schalte es aus, wenn eine noch nicht losgelassene Modultaste auf dem nächsten Client auslöst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideHeld">Noch gehaltene Tasten vor dem nächsten Client verbergen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideHeld.Desc">Eine beim Wechsel noch gedrückte Taste bleibt dem neuen Client verborgen, bis du loslässt, sodass Halten von A oder S ihn nicht ausrichten oder warpen lässt. Hat Vorrang vor der Option darüber.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.broadcastHud">Anzeigen, welche gehaltene Taste mitgenommen wird</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.broadcastHud.Desc">Eine kleine Anzeige auf dem Bildschirm. Zieh sie, wohin du willst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.hotkeys.cycling">Zwischen Clients wechseln</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleNext">Nächster Client, alle laufenden Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleNext.Desc">Wechselt zum nächsten laufenden Client, egal in welcher Gruppe.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cyclePrevious">Vorheriger Client, alle laufenden Clients</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleWhileHeld">Weiterwechseln, solange die Taste gehalten wird</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleWhileHeld.Desc">Aus: Jeder Tastendruck wechselt genau einen Client.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleDelay">Zeit zwischen Wechseln bei gehaltener Taste</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.cycleDelay.Desc">Niedriger ist schneller. Standard sind 100 ms.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.wrapSound">Ton abspielen, wenn der Wechsel von vorn beginnt</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.wrapSound.Desc">Sagt dir, dass du wieder beim ersten Client bist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.wrapSoundFile">Ton beim Umlauf</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.includeLogins">Clients am Anmeldebildschirm einbeziehen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.includeLogins.Desc">Die Tasten für nächsten und vorherigen Client halten auch bei Clients, die noch keinen Charakter gewählt haben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.hotkeys.app">MultiPreview-Hotkeys</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.suspend">Hotkeys pausieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.suspend.Desc">Schaltet alle anderen Hotkeys aus und wieder ein. Dieser funktioniert auch während der Pause.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.clickThrough">Durchklickbare Vorschauen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.clickThrough.Desc">Klicks gehen durch die Vorschauen auf das dahinter Liegende.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideAll">Alle Vorschauen ein- oder ausblenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideAll.Desc">Auch zweite Vorschauen, Statistik-Overlays und Ausschnittfenster.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hidePrimary">Hauptvorschauen ein- oder ausblenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hidePip">Zweite Vorschauen ein- oder ausblenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.hideCrops">Ausschnittfenster ein- oder ausblenden</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.quickSwitch">Schnellwechsel-Rad</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.lockPositions">Vorschaupositionen sperren oder entsperren</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.undo">Layoutänderung rückgängig machen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.undo.Desc">Vermeide Tasten, die EVE nutzt, wie Strg+Z.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.redo">Layoutänderung wiederholen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.profileNext">Nächstes Profil</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.profilePrevious">Vorheriges Profil</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.closeAll">Alle Clients schließen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.closeAll.Desc">Beendet jeden EVE-Client, den MultiPreview verfolgt, nach einer Bestätigung.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.hotkeys.check">Konfliktprüfung</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.conflicts">Doppelt belegte Tasten</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.conflicts.Desc">Aktualisiert sich, wenn du Tasten änderst. Charaktere, die absichtlich eine Taste teilen, werden nicht aufgeführt.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Conflicts.None">Keine Konflikte: Jede Taste macht eine Sache.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Conflicts.Count">{0} Taste(n) doppelt belegt. Wähle für eines jedes Paars eine andere Taste.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.Intro">Tasten, die Clients wechseln und MultiPreview steuern, und wie sie sich verhalten. Die Konfliktprüfung unten zeigt Tasten mit zwei Aufgaben.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.scope.Title">Wo Hotkeys funktionieren</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.scope.Body">**Überall** fängt deine Hotkeys ab, egal welche App vorn ist, sodass eine Taste im Browser trotzdem Clients wechselt. **Nur wenn EVE im Vordergrund ist** lässt die Tasten in anderen Apps in Ruhe.&#x0A;&#x0A;**Hotkeys funktionieren bei gehaltenem Strg, Umschalt oder Alt** ist wichtig, wenn du Strg zum Sperren von Zielen hältst. Schalte es aus, wenn ein Ein-Tasten-Hotkey Strg+V oder Strg+C daran hindert, EVE zu erreichen.&#x0A;&#x0A;**Hotkeys vor EVE verbergen** verhindert, dass der Client, zu dem du wechselst, die gedrückte Taste sieht.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.held.Title">Tasten, die du noch hältst</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.held.Body">Wenn du wechselst, während du Tasten hältst, kann MultiPreview sie zum nächsten Client mitnehmen oder vor ihm verbergen.&#x0A;- **Strg, Umschalt und Alt mitnehmen**: Halte Strg weiter, um nach dem Wechsel Ziele zu sperren.&#x0A;- **Andere gehaltene Tasten mitnehmen**: Halte F1 und wechsle, um es auf jedem Client auszulösen.&#x0A;- **Noch gehaltene Tasten verbergen**: Halten von A oder S lässt den nächsten Client nie ausrichten oder warpen.&#x0A;&#x0A;Die Anzeige auf dem Bildschirm zeigt, welche Taste mitgenommen wird.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.cycling.Title">Nächster und vorheriger Client</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.cycling.Body">**Nächster Client** und **Vorheriger Client** gehen durch jeden laufenden Client. Gruppen haben eigene Tasten auf der Seite Gruppen.&#x0A;&#x0A;Halte die Taste, um in der eingestellten Zeit weiterzuwechseln. Schalte das aus, um pro Druck genau einen Client zu wechseln.&#x0A;&#x0A;Ein Ton kann dir sagen, wenn du wieder beim ersten Client angekommen bist.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.app.Title">MultiPreview-Hotkeys</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.app.Body">Tasten für MultiPreview selbst: alle Hotkeys pausieren, Vorschauen durchklickbar machen, ausblenden, ihre Positionen sperren, eine Layoutänderung rückgängig machen, das Profil wechseln oder jeden Client schließen. Wähle Tasten, die EVE nicht nutzt. **Hotkeys pausieren** funktioniert auch während der Pause, sodass du sie immer wieder einschalten kannst.</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.conflicts.Title">Doppelt belegte Tasten</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.clients.hotkeys.conflicts.Body">Teilen zwei Dinge eine Taste, läuft nur eines davon. Die Konfliktprüfung listet jedes Paar auf; klicke eines an, um seine Taste zu ändern.&#x0A;&#x0A;Nicht aufgeführt, weil sie absichtlich so funktionieren: Charaktere mit derselben Taste (die Taste wechselt zwischen ihnen) und Gruppen mit derselben Taste für „nächster“ (sie teilen eine Liste).</sys:String> <!-- draft -->
    <!-- Clients › Windows & positions -->
    <sys:String x:Key="L.S.Page.clients.windows">Fenster &amp; Positionen</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Page.clients.windows.Desc">Das Minimieren verlassener Clients und wohin die Clientfenster kommen.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.windows.minimizing">Minimieren</sys:String> <!-- draft -->
