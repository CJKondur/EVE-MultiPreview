    <sys:String x:Key="L.S.character.label.Desc">Extra text on the thumbnail, like Scout or Logi. Leave it empty for none. Labels apply in every profile.</sys:String>
    <sys:String x:Key="L.S.character.labelColor">Label colour</sys:String>
    <sys:String x:Key="L.S.character.labelColor.Desc">Leave it empty to use the thumbnail text colour.</sys:String>
    <sys:String x:Key="L.S.character.labelSize">Label size</sys:String>
    <sys:String x:Key="L.S.character.labelSize.Desc">0 uses the thumbnail text size.</sys:String>
