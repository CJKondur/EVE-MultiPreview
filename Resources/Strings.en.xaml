    <sys:String x:Key="L.S.clients.groups.showBorders.Desc">Paint each member's thumbnail border in its group's colour, even when it isn't the active client.</sys:String>
    <sys:String x:Key="L.S.Sec.clients.groups.list">Your groups</sys:String>
    <sys:String x:Key="L.S.clients.groups.new">Make a group</sys:String>
    <sys:String x:Key="L.S.clients.groups.new.Desc">Give it a name, then add characters, a colour and keys.</sys:String>
