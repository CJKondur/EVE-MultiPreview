    <sys:String x:Key="L.S.Sec.app.about.fonts">Fonts</sys:String>
    <sys:String x:Key="L.S.app.about.fonts">Typefaces of the looks</sys:String>
    <sys:String x:Key="L.S.app.about.fonts.Desc">MultiPreview carries these typefaces for its looks. Each is free under the SIL Open Font License 1.1, whose text comes with it.</sys:String>
