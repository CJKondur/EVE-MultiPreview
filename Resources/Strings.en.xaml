    <sys:String x:Key="L.S.clients.characters.customColors">Use per-character colours</sys:String>
    <sys:String x:Key="L.S.clients.characters.customColors.Desc">Each character's own border and text colours, set on its page. Off: every character uses the Thumbnails colours.</sys:String>
    <sys:String x:Key="L.S.Sec.clients.characters.clicks">Clicking thumbnails</sys:String>
