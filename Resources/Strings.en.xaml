    <sys:String x:Key="L.S.Sec.character.colors">Colours</sys:String>
    <sys:String x:Key="L.S.character.colorsOff">Per-character colours are off in this profile. Turn on Use per-character colours under Clients › Characters to use these.</sys:String>
