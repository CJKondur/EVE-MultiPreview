    <sys:String x:Key="L.S.Characters.Empty">No characters yet. Start EVE and log in, or add one by name.</sys:String>
    <sys:String x:Key="L.S.Characters.CycleNote">Cycle lasts until MultiPreview restarts: a character you take out of cycling comes back next time.</sys:String>
