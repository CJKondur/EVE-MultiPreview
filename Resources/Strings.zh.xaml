    <sys:String x:Key="L.S.thumbs.visibility.pipTable">第二缩略图</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.pipTable.Desc">同一客户端的额外缩略图，有自己的位置、大小和不透明度。关闭后会保留位置和大小，供下次使用。</sys:String> <!-- draft -->
