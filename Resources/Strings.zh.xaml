    <sys:String x:Key="L.S.app.diagnostics.cycling.Desc">每个切换热键及其选中的客户端。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.app.diagnostics.windowHooks">窗口事件</sys:String> <!-- draft -->
