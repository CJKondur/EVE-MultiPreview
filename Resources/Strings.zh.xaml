    <sys:String x:Key="L.S.thumbs.text.showText">角色名称</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showText.Desc">每个缩略图显示其角色的名称。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem">星系</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem.Desc">每个角色所在的星系，从其 EVE 日志中读取。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showTimer">会话计时器</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showTimer.Desc">每个客户端已打开的时间。</sys:String> <!-- draft -->
