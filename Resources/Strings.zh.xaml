    <sys:String x:Key="L.S.tools.stats.countNpc">统计 NPC 伤害</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.countNpc.Desc">关闭后，NPC 造成和受到的伤害不计入伤害数据，因此只显示与玩家的战斗。打怪获得的 ISK 仍会计入。</sys:String> <!-- draft -->
