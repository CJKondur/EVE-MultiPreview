    <sys:String x:Key="L.S.clients.hotkeys.broadcastHud.Desc">屏幕上的一个小标签。可以拖到任意位置。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.hotkeys.cycling">在客户端之间切换</sys:String> <!-- draft -->
