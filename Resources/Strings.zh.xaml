    <sys:String x:Key="L.S.thumbs.text.showStats">CPU、内存和显存占用</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showStats.Desc">每个客户端的 CPU、RAM 和 VRAM 占用，每隔几秒更新一次。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.statsSize">统计文字大小</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.active">你正在玩的客户端</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlight">高亮边框</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlight.Desc">彩色边框标出最前面的客户端。更改会在你返回 EVE 时显示。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightColor">高亮颜色</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightWidth">高亮宽度</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightInGroup">在彩色分组内保留高亮</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.highlightInGroup.Desc">开启分组边框后，你正在玩的客户端保留高亮颜色，而不是其分组的颜色。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.others">其他客户端</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveColor">边框颜色</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveColor.Desc">位于其他每个缩略图周围。留空则无边框。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveWidth">边框宽度</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.inactiveWidth.Desc">0 表示隐藏边框。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.groupBorders">分组颜色</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.groupBorders.Desc">若要用分组颜色绘制每个成员的边框，请在“分组”页面打开“显示分组边框”。</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.text.openGroups">打开分组</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.marks">标记</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.badgePosition">已跳过客户端标记的位置</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.badgePosition.Desc">被移出循环切换的客户端会在此处显示红色 ✕。</sys:String> <!-- draft -->
