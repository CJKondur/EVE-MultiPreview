    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ 关于</sys:String>
    <sys:String x:Key="L.About.Edition">C# / WPF 版</sys:String>
    <sys:String x:Key="L.About.Desc">EVE Online 的多客户端缩略图预览管理器。显示 EVE 窗口的实时 DWM 缩略图，支持点击切换、拖动重定位、自定义边框、警报、数据覆盖层和每角色热键。</sys:String>
    <sys:String x:Key="L.About.Origin">最初由 CJKondur 用 AutoHotkey v2 编写。</sys:String>
    <sys:String x:Key="L.About.Ported">移植到 C# WPF 以提升性能、稳定性和可扩展性。</sys:String>
    <sys:String x:Key="L.About.GitHub">🔗 GitHub</sys:String>
    <sys:String x:Key="L.About.CheckUpdates">🔄 检查更新</sys:String>
    <sys:String x:Key="L.About.CheckOnStartup">程序启动时检查更新</sys:String>
