    <sys:String x:Key="L.S.thumbs.text.highlightInGroup.Desc">Con los bordes de grupo o los colores de borde automáticos activados, el cliente con el que juegas conserva el color de resaltado en lugar del de su grupo.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.text.others">Otros clientes</sys:String> <!-- draft -->
