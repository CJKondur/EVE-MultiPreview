    <sys:String x:Key="L.S.character.hotkey">Atajo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.hotkey.Desc">Cambia directamente a este personaje. Otro personaje puede compartir la tecla: entonces alterna entre ellos.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle">Incluir en el ciclo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle.Desc">Desactivado: las teclas de cliente siguiente/anterior y las de grupo omiten a este personaje hasta que MultiPreview se reinicie.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groups">Grupos: {0}</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.noGroup">No está en ningún grupo.</sys:String> <!-- draft -->
