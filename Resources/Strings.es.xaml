    <sys:String x:Key="L.S.alerts.events.snoozed">Pospuestas ahora mismo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.alerts.events.snoozed.Desc">Alertas que pospusiste para un personaje desde una notificación. Termina una para volver a recibirla.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Snoozes.None">No hay nada pospuesto.</sys:String> <!-- draft -->
