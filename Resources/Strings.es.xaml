    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ Acerca de</sys:String>
    <sys:String x:Key="L.About.Edition">Edición C# / WPF</sys:String>
    <sys:String x:Key="L.About.Desc">Gestor de vistas previas en miniatura multicliente para EVE Online. Muestra miniaturas DWM en vivo de tus ventanas de EVE con cambio con un clic, reposicionamiento por arrastre, bordes personalizados, alertas, superposiciones de estadísticas y teclas rápidas por personaje.</sys:String>
