    <sys:String x:Key="L.S.thumbs.text.showText.Desc">Cada miniatura muestra el nombre de su personaje.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem">Sistema solar</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showSystem.Desc">El sistema en el que está cada personaje, leído de sus registros de EVE.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.text.showTimer">Temporizador de sesión</sys:String> <!-- draft -->
