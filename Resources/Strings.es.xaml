    <sys:String x:Key="L.S.Page.thumbs.layout.Desc">Dónde aparecen las miniaturas, cómo se alinean, diseños guardados y deshacer.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.thumbs.layout.screens">Pantallas</sys:String> <!-- draft -->
