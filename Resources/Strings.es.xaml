    <sys:String x:Key="L.S.character.groupsLink.Desc">Añade este personaje a un grupo, o cambia su lugar, en la página Grupos.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.openGroups">Abrir grupos</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.thumbnail">Miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.show">Mostrar miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label">Etiqueta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label.Desc">Texto adicional en la miniatura, como Scout o Logi. Déjalo vacío para ninguno. Las etiquetas se aplican en todos los perfiles.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor">Color de la etiqueta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor.Desc">Déjalo vacío para usar el color de texto de la miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize">Tamaño de la etiqueta</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize.Desc">0 usa el tamaño de texto de la miniatura.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size">Tamaño propio</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.Desc">Ancho y alto de la miniatura de este personaje. Un personaje en ejecución cambia de tamaño al instante.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.applySize">Aplicar</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.NeedsLogin">Inicia sesión con este personaje una vez para darle su propio tamaño.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip">Segunda miniatura (PiP)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip.Desc">Una segunda miniatura independiente de este cliente. Al desactivarla se conservan su lugar y tamaño para la próxima vez.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pipOpacity">Opacidad de la segunda miniatura</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.colors">Colores</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsOff">Los colores por personaje están desactivados en este perfil. Activa Usar colores por personaje en Clientes › Personajes para usarlos.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorActive">Borde si está activo</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorInactive">Borde si no está activo</sys:String> <!-- draft -->
