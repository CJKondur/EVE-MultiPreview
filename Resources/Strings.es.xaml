    <sys:String x:Key="L.S.thumbs.layout.monitor.Desc">Dónde aparecen las miniaturas antes de que las muevas. El mismo ajuste que en Inicio.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.identifyRow">Qué pantalla es cuál</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.layout.identifyRow.Desc">Muestra un momento el número de cada monitor en él. Los números de MultiPreview pueden diferir de los de Windows.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.thumbs.layout.identify">Identificar</sys:String> <!-- draft -->
