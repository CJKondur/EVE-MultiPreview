    <!-- General panel -->
    <sys:String x:Key="L.General.Title">⚙ Configuración general</sys:String>
    <sys:String x:Key="L.General.Subtitle">Ajustes básicos del comportamiento de las teclas rápidas de EVE MultiPreview.</sys:String>
    <sys:String x:Key="L.General.ShowTimer">Mostrar temporizador de sesión en las miniaturas</sys:String>
    <sys:String x:Key="L.General.HotkeyScope">Ámbito de las teclas rápidas</sys:String>
    <sys:String x:Key="L.General.ActivationScope">Ámbito de activación:</sys:String>
    <sys:String x:Key="L.General.ScopeGlobal">Global</sys:String>
    <sys:String x:Key="L.General.ScopeEveActive">Si una ventana de EVE está activa</sys:String>
    <sys:String x:Key="L.General.HotkeyWildcard">Las teclas rápidas se activan aunque mantengas Ctrl / Mayús / Alt</sys:String>
    <sys:String x:Key="L.General.HotkeyWildcardNote">Activado: una tecla rápida funciona aunque mantengas un modificador — en EVE se mantiene Ctrl para fijar objetivos. Desactivado: una tecla rápida simple como V solo se activa sola, así que Ctrl+V llega al cliente para pegar.</sys:String>
    <sys:String x:Key="L.General.PropagateModifiers">Transferir Ctrl / Mayús / Alt mantenidos al cliente al que cambias</sys:String>
    <sys:String x:Key="L.General.PropagateModifiersNote">Activado: mantener Ctrl para fijar un objetivo sigue funcionando tras cambiar a otro cliente. Desactívalo si el fijado deja de funcionar tras un cambio: en algunos equipos el cliente ya detecta la tecla mantenida y estas pulsaciones adicionales estorban.</sys:String> <!-- draft -->
    <sys:String x:Key="L.General.PropagateKeys">Transferir otras teclas mantenidas al cliente al que cambias</sys:String>
    <sys:String x:Key="L.General.PropagateKeysNote">Activado: las letras, números, teclas F, Intro, Espacio y botones del ratón que sigues manteniendo al cambiar se pulsan también en el nuevo cliente (mantén F1 y cicla para activarlo en cada uno). Desactívalo si una tecla de módulo que aún no has soltado se activa en el siguiente cliente y tu propia pulsación luego la vuelve a desactivar. Ctrl / Mayús / Alt mantenidos siguen el ajuste de arriba.</sys:String>
    <sys:String x:Key="L.General.HideHeldKeys">Ocultar las teclas que sigues manteniendo al cliente al que cambias</sys:String>
    <sys:String x:Key="L.General.HideHeldKeysNote">Para letras, números, teclas F, Intro y Espacio. Una tecla que sigue pulsada al cambiar se suelta en el cliente que dejas y se mantiene fuera del nuevo hasta que la sueltes, así que mantener A (alinear) o S (warp) no hace que el siguiente cliente se alinee o haga warp. Tiene prioridad sobre «Transferir otras teclas mantenidas». Ctrl / Mayús / Alt nunca se ocultan: siguen su propia opción de arriba, y ocultarlos rompería las teclas rápidas con modificador mantenido como Ctrl+TAB.</sys:String>
    <sys:String x:Key="L.General.HideHotkeyKeystrokes">Ocultar a EVE las pulsaciones de las teclas rápidas (como EVE-X-Preview)</sys:String>
    <sys:String x:Key="L.General.HideHotkeyKeystrokesNote">Activado: cuando una tecla rápida cambia de cliente, el cliente al que llegas nunca ve esa tecla. Desactivado: la liberación de la tecla llega a ese cliente, y tu primer clic allí puede solo enfocar el overview en lugar de actuar.</sys:String>
