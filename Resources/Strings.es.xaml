    <sys:String x:Key="L.S.thumbs.visibility.pipTable">Segundas miniaturas</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.thumbs.visibility.pipTable.Desc">Una miniatura extra del mismo cliente con su propia posición, tamaño y opacidad. Desactivada conserva su posición y tamaño para la próxima vez.</sys:String> <!-- draft -->
