    <sys:String x:Key="L.S.home.showAllRow.Desc">Muestra todas las páginas en la navegación. Vuelve con el interruptor de abajo a la izquierda.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.home.showAll">Mostrar todos los ajustes</sys:String> <!-- draft -->
