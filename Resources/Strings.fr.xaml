    <sys:String x:Key="L.S.StatsPicker.DefaultHidden">Par défaut (masqué)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsPicker.Always">Toujours afficher</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsPicker.Never">Ne jamais afficher</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.StatsPicker.Reset">Utiliser les valeurs par défaut pour tous les chiffres</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.numbers.Title">Choisir des chiffres individuels</sys:String> <!-- draft -->
    <sys:String x:Key="L.Help.character.numbers.Body">**Choisir les chiffres…** liste chaque chiffre que l'overlay de statistiques peut afficher. **Par défaut** suit la liste de tous les personnages ; **Toujours afficher** et **Ne jamais afficher** ne concernent que ce personnage. Les interrupteurs de groupe ci-dessus règlent un groupe entier d'un coup.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.tools.stats.characters">Par personnage</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.characterTable">Chiffres par personnage</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.tools.stats.characterTable.Desc">Ouvrez un personnage pour choisir ses propres chiffres.</sys:String> <!-- draft -->
