    <sys:String x:Key="L.S.Groups.NameTaken">Impossible d'utiliser '{0}' : le nom est vide ou un autre groupe le porte déjà.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.DuplicateName">Un autre groupe s'appelle aussi '{0}'. Renommez celui-ci avant de lui donner des touches.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Groups.Colour">Couleur</sys:String> <!-- draft -->
