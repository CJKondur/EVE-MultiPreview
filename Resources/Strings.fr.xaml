    <sys:String x:Key="L.S.character.size.NeedsLogin">Connectez ce personnage une fois pour lui donner sa propre taille.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip">Deuxième miniature (PiP)</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pip.Desc">Une deuxième miniature distincte de ce client. La désactiver conserve sa place et sa taille pour plus tard.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.pipOpacity">Opacité de la deuxième miniature</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.character.colors">Couleurs</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.colorsOff">Les couleurs par personnage sont désactivées dans ce profil. Activez Utiliser les couleurs par personnage sous Clients › Personnages pour les appliquer.</sys:String> <!-- draft -->
