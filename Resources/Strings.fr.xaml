    <sys:String x:Key="L.S.clients.groups.showBorders.Desc">Colore la bordure de la miniature de chaque membre à la couleur de son groupe, même s'il n'est pas le client actif.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.clients.groups.list">Vos groupes</sys:String> <!-- draft -->
