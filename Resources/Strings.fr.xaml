    <sys:String x:Key="L.S.clients.groups.new.Desc">Donnez-lui un nom, puis ajoutez des personnages, une couleur et des touches.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.clients.groups.new">Nouveau groupe…</sys:String> <!-- draft -->
