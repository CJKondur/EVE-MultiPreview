    <sys:String x:Key="L.S.Page.alerts.events.Desc">Ce que MultiPreview surveille dans les journaux d'EVE, et comment chaque alerte s'affiche.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Sec.alerts.events.logs">Lecture des journaux d'EVE</sys:String> <!-- draft -->
