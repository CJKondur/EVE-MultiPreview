    <!-- About panel -->
    <sys:String x:Key="L.About.Title">ℹ À propos</sys:String>
    <sys:String x:Key="L.About.Edition">Édition C# / WPF</sys:String>
    <sys:String x:Key="L.About.Desc">Gestionnaire d'aperçu de miniatures multi-clients pour EVE Online. Affiche des miniatures DWM en direct de vos fenêtres EVE avec clic pour changer, glisser pour repositionner, bordures personnalisées, alertes, superpositions de stats et raccourcis par personnage.</sys:String>
