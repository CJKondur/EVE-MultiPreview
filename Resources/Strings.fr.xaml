    <sys:String x:Key="L.S.character.hotkey.Desc">Bascule directement vers ce personnage. Un autre personnage peut partager la touche : elle bascule alors entre eux.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle">Inclure dans le cycle</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.cycle.Desc">Désactivé : les touches client suivant/précédent et les touches de groupe sautent ce personnage jusqu'au redémarrage de MultiPreview.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.groups">Groupes : {0}</sys:String> <!-- draft -->
