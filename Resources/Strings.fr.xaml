    <sys:String x:Key="L.S.character.groupsLink.Desc">Ajoutez ce personnage à un groupe, ou changez sa place, sur la page Groupes.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Act.character.openGroups">Ouvrir les groupes</sys:String> <!-- draft -->
