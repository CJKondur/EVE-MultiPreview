    <sys:String x:Key="L.S.character.show">Afficher la miniature</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label">Étiquette</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.label.Desc">Texte supplémentaire sur la miniature, comme Scout ou Logi. Laissez vide pour aucune. Les étiquettes s'appliquent dans tous les profils.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor">Couleur de l'étiquette</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelColor.Desc">Laissez vide pour utiliser la couleur du texte de la miniature.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize">Taille de l'étiquette</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.labelSize.Desc">0 utilise la taille du texte de la miniature.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size">Taille propre</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.character.size.Desc">Largeur et hauteur de la miniature de ce personnage. Un personnage en cours d'exécution est redimensionné immédiatement.</sys:String> <!-- draft -->
