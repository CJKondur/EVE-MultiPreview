    <sys:String x:Key="L.S.clients.hotkeys.undo.Desc">Избегайте клавиш, которые использует EVE, например Ctrl+Z.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.hotkeys.redo">Повторить изменение раскладки</sys:String> <!-- draft -->
