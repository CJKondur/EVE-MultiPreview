    <sys:String x:Key="L.General.HkHidePip">Скрыть/показать PiP:</sys:String>
    <sys:String x:Key="L.General.HkHideCrops">Скрыть/показать обрезки:</sys:String>
    <sys:String x:Key="L.General.HkProfileFwd">Цикл профилей вперёд:</sys:String>
