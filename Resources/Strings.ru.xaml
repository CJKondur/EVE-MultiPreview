    <sys:String x:Key="L.S.clients.windows.neverMinimize.Desc">Эти персонажи остаются открытыми при переключении.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.clients.windows.neverMinimize.Empty">Пока никого.</sys:String> <!-- draft -->
