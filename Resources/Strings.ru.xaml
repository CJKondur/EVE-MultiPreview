    <sys:String x:Key="L.S.app.general.startupSettings.Desc">Открывается ли это окно настроек само.</sys:String> <!-- draft -->
    <sys:String x:Key="L.S.Opt.StartupOff">Оставаться в трее</sys:String> <!-- draft -->
