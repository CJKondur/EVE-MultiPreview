<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EveMultiPreview.Linux</RootNamespace>
    <AssemblyName>eve-multipreview</AssemblyName>
    <!-- The Windows app's version, read from its project: one release carries both, and the updater compares with it. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../EveMultiPreview.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- The Windows app's own platform-neutral sources, compiled here unchanged. -->
  <ItemGroup>
    <Compile Include="..\Models\*.cs" LinkBase="Shared\Models" />
    <Compile Include="..\Converters\*.cs" LinkBase="Shared\Converters" />
    <!-- WithCulture=false: MSBuild reads "Strings.de.xaml" as a German resource and moves it into a satellite assembly,
         where LocalizationService (which reads this assembly) cannot find it. -->
    <EmbeddedResource Include="..\Resources\Strings.*.xaml" WithCulture="false" LogicalName="%(Filename)%(Extension)" />
    <!-- The Linux app's own strings (the L.Linux.* keys), same WithCulture reason. -->
    <EmbeddedResource Include="Resources\LinuxStrings.*.xaml" WithCulture="false" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Icon.ico" LogicalName="Icon.ico" />
    <!-- The log monitor's line patterns in every client language, under the name AlertPatterns reads. -->
    <EmbeddedResource Include="..\Resources\alert_patterns.json" LogicalName="EveMultiPreview.Resources.alert_patterns.json" />
  </ItemGroup>
  <Import Project="SharedSources.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.4" />
  </ItemGroup>

</Project>
