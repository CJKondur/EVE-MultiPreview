    <sys:String x:Key="L.Linux.FolderNote">Se lasciato vuoto, i log vengono cercati nella cartella Steam (Proton) di EVE Online.</sys:String>
    <sys:String x:Key="L.Linux.ImportTitle">Impostazioni dall'app per Windows</sys:String>
    <sys:String x:Key="L.Linux.ImportPick">Scegli l'EVE MultiPreview.json dell'app per Windows</sys:String>
    <sys:String x:Key="L.Linux.Import">Importa le impostazioni da Windows…</sys:String>
