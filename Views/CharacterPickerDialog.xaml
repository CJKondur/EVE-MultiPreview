<Window x:Class="EveMultiPreview.Views.CharacterPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Pick.Title}"
        Width="360" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Fx.BgBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- In the look of the settings window (UI styles spec §8.1, O17); before plan S1 it had the old window's navy. -->
    <Border Style="{DynamicResource Fx.Dialog}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBox x:Name="TxtSearch" Grid.Row="1" TextChanged="OnSearchChanged"/>

        <ListBox x:Name="LstCharacters" Grid.Row="2" Margin="0,8,0,8"
                 MouseDoubleClick="OnListDoubleClick"
                 SelectionChanged="OnSelectionChanged"/>

        <TextBlock Grid.Row="3" Text="{DynamicResource L.Pick.ManualHint}" Style="{DynamicResource Fx.Desc}" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Common.Ok}" Style="{DynamicResource Fx.PrimaryButton}" MinWidth="80" Click="OnOK" IsDefault="True"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource L.Common.Cancel}" MinWidth="80" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
