<Window x:Class="EveMultiPreview.Views.TextOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        AllowsTransparency="True"
        Background="Transparent"
        Title="TextOverlay">

    <Grid x:Name="OverlayRoot">
        <!-- Cycle-exclusion indicator (issue #16 / #27 / #40) — small badge in
             the top-LEFT corner, mirroring the alert-count badge in the top
             right. Replaces the earlier corner-to-corner red X strikeout,
             which obscured the thumbnail content. Visibility is toggled by
             SetCycleExcluded. -->
        <Border x:Name="ExclusionBadge"
                Width="20" Height="20"
                CornerRadius="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="4,4,0,0"
                Background="#FFCC0000"
                BorderBrush="White"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
            </Border.Effect>
            <TextBlock Text="✕"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel x:Name="TextOverlayPanel"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="5,5,5,0">
            
            <!-- Character name -->
            <TextBlock x:Name="NameOverlay"
                       Foreground="#FFfac57a"
                       FontSize="12"
                       FontFamily="Gill Sans MT"
                       FontWeight="Medium"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Annotation label (user-defined: "Scout", "DPS", "Logi", etc.) -->
            <TextBlock x:Name="AnnotationOverlay"
                       Foreground="#FF8ecfff"
                       FontSize="9"
                       FontFamily="Gill Sans MT"
                       FontWeight="Normal"
                       FontStyle="Italic"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- System name -->
            <TextBlock x:Name="SystemOverlay"
                       Foreground="#FFfac57a"
                       FontSize="10"
                       FontFamily="Gill Sans MT"
                       FontWeight="Normal"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Session timer -->
            <TextBlock x:Name="TimerOverlay"
                       Foreground="#FFfac57a"
                       FontSize="10"
                       FontFamily="Gill Sans MT"
                       FontWeight="Normal"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Process stats (CPU/RAM/VRAM) — Viewbox auto-shrinks text to fit thumbnail width -->
            <Viewbox x:Name="ProcessStatsViewbox"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Left"
                     Visibility="Collapsed">
                <TextBlock x:Name="ProcessStatsOverlay"
                           Foreground="#FF90ee90"
                           FontSize="9"
                           FontFamily="Consolas"
                           FontWeight="Normal">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Viewbox>
        </StackPanel>

        <!-- FPS Overlay -->
        <TextBlock x:Name="FpsOverlay"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,5,5,0"
                   Foreground="#FFfac57a"
                   FontSize="12"
                   FontFamily="Gill Sans MT"
                   FontWeight="Medium"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- What the current alert is ("Warp scrambled", "Fleet warp"), in the alert's
             colour, for as long as it lasts (#115). Anchor set by SetAlertTextPosition.
             A custom rule's name can be 40 characters: a text wider than the thumbnail
             ends in "…" inside it. The grid hands the text the thumbnail's width less its
             inset, so the trimming needs no width of its own; a text that fits is drawn
             exactly as without it. -->
        <TextBlock x:Name="AlertTextOverlay"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,4"
                   FontSize="14"
                   FontFamily="Gill Sans MT"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="1" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Per-character unread alert badge (matches AlertHub badge styling).
             Severity-coloured circle with white count, painted top-right and
             rendered AFTER FpsOverlay so it draws on top when both are visible.
             Cleared the moment the user activates the client. -->
        <Border x:Name="AlertBadge"
                Width="20" Height="20"
                CornerRadius="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,4,0"
                Background="#FFCC0000"
                BorderBrush="White"
                BorderThickness="1"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="AlertBadgeText"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- IDEAS #22, #47: what the client itself is doing, "Not responding" or "Disconnected", in the middle and over
             every other overlay. Shown by SetClientMark. Not styled by the looks, as the badges beside it. -->
        <Border x:Name="ClientMarkBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="8,3"
                CornerRadius="4"
                Background="#E0202020"
                BorderBrush="#FFFFB000"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="ClientMarkText"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
