<Window x:Class="EveMultiPreview.Views.QuickSwitchWheel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EveMultiPreview.SettingsUi"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Title="{DynamicResource L.Qs.Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SettingsTheme/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Plan 4, the F2 reference: the clients' cards around a centre disc. The root's almost-transparent fill keeps the
         whole wheel clickable, as the old opaque panel was, so a click between two cards never reaches the game. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Canvas x:Name="ButtonCanvas" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- In a ring, the disc sits in the middle of the cards; in rows, it is the header above them. -->
        <Border x:Name="Disc" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource Fx.BgBrush}" BorderBrush="{StaticResource Fx.FlyoutBorderBrush}" BorderThickness="1">
            <StackPanel x:Name="DiscContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8">
                <TextBlock Text="{DynamicResource L.Qs.SwitchChar}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Fx.TextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtCount" FontSize="12" Foreground="{StaticResource Fx.TextSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <Button x:Name="BtnEdit" Style="{StaticResource Fx.QuietButton}" FontSize="12" Padding="10,2"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Click="BtnEdit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
