<Window x:Class="EveMultiPreview.Views.CopyLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Copy.Title}"
        Width="420" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Fx.BgBrush}">

    <!-- In the look of the settings window (UI styles spec §8.1, O17); before plan S1 it had the old window's navy. -->
    <Border Style="{DynamicResource Fx.Dialog}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Copy.From}" VerticalAlignment="Center"
                   Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbFrom" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Copy.To}" VerticalAlignment="Center"
                   Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbTo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Copy.What}" VerticalAlignment="Top" Margin="0,4,0,0"
                   Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
            <RadioButton x:Name="RdoLayoutOnly" GroupName="What" IsChecked="True" Margin="0,2">
                <TextBlock Text="{DynamicResource L.Copy.LayoutOnly}" Style="{DynamicResource Fx.Label}"/>
            </RadioButton>
            <RadioButton x:Name="RdoFullProfile" GroupName="What" Margin="0,6,0,2">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Copy.EntireProfile}" Style="{DynamicResource Fx.Label}"/>
                    <TextBlock Text="{DynamicResource L.Copy.EntireNote}" Style="{DynamicResource Fx.Desc}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="{DynamicResource L.Copy.CopyBtn}" Style="{DynamicResource Fx.PrimaryButton}"
                Click="OnCopy" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
    </Grid>
    </Border>
</Window>
