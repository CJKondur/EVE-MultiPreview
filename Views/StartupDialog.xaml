<Window x:Class="EveMultiPreview.Views.StartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE MultiPreview"
        Background="{DynamicResource Fx.BgBrush}"
        SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- IDEAS #49, #55, #57: what MultiPreview asks or says before or beside its main windows. Same look as ChoiceDialog. -->
    <Border Style="{DynamicResource Fx.Dialog}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{DynamicResource Fx.Label}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="BodyText" Style="{DynamicResource Fx.Label}" Margin="0,12,0,0"/>
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0">
            <StackPanel x:Name="ChoicePanel"/>
        </ScrollViewer>
    </StackPanel>
    </Border>
</Window>
