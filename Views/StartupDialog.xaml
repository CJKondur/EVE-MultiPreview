<Window x:Class="EveMultiPreview.Views.StartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EveMultiPreview.SettingsUi"
        ThemeMode="Dark"
        Title="EVE MultiPreview"
        Background="{DynamicResource Fx.BgBrush}"
        SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- IDEAS #49, #55, #57: what MultiPreview asks or says before or beside its main windows. Same look as ChoiceDialog. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SettingsTheme/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource Fx.Label}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="BodyText" Style="{StaticResource Fx.Label}" Margin="0,12,0,0"/>
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0">
            <StackPanel x:Name="ChoicePanel"/>
        </ScrollViewer>
    </StackPanel>
</Window>
