<Window x:Class="EveMultiPreview.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EveMultiPreview.SettingsUi"
        Title="{DynamicResource L.Upd.Title}"
        Width="560" Height="460" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{DynamicResource Fx.CardBrush}">

    <!-- Plan 4, the F2 reference's update dialog. The buttons and what they do are unchanged. -->

    <!-- The Fluent theme leaves the window's own background to the system backdrop, so the content paints the surface. -->
    <DockPanel Background="{DynamicResource Fx.CardBrush}">
        <!-- ═══ Footer: Release page on the left; Later and Update now on the right ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Fx.BgBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                BorderThickness="0,1,0,0" Padding="26,16">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnReleaseNotes" DockPanel.Dock="Left" Content="{DynamicResource L.Upd.ReleasePage}" Padding="16,6" Click="OnReleaseNotes"/>
                <Button x:Name="BtnUpdateNow" DockPanel.Dock="Right" Content="{DynamicResource L.Upd.UpdateNow}" Style="{DynamicResource Fx.PrimaryButton}"
                        Click="OnUpdateNow" Margin="8,0,0,0"/>
                <Button x:Name="BtnLater" DockPanel.Dock="Right" Content="{DynamicResource L.Upd.Later}" Padding="16,6" Click="OnLater"/>
            </DockPanel>
        </Border>

        <Grid Margin="26,24,26,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtHeader" Text="{DynamicResource L.Upd.Header}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fx.TextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtVersionInfo" Grid.Row="1" FontSize="13" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,12"/>

            <!-- Release notes, formatted: headings and **labels** bold, bullets as bullets -->
            <Border Grid.Row="2" Background="{DynamicResource Fx.BgBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Fx.Radius}" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="NotesPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Progress (hidden until the download starts) -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0">
                <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="TxtProgressStatus" FontSize="12" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                           Margin="0,6,0,0" Text="{DynamicResource L.Upd.Downloading}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Status (applying, or the error) -->
            <TextBlock x:Name="TxtStatus" Grid.Row="4" FontSize="12" Foreground="{DynamicResource Fx.WarningBrush}"
                       Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </Grid>
    </DockPanel>
</Window>
