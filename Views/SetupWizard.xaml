<Window x:Class="EveMultiPreview.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Wiz.Title}"
        Width="720" SizeToContent="Height" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Fx.CardBrush}">

    <!-- Plan 4, the F2 reference's first-run dialog. The steps, choices and what Done saves are unchanged. -->
    <Window.Resources>

        <Style x:Key="Wiz.Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Wiz.Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="Wiz.Text" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Wiz.StepBar" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Fx.FlyoutBorderBrush}"/>
        </Style>

        <!-- A thumbnail-size choice: a card with a preview; the picked one has an accent edge (the reference's .opt.on).
             Radio buttons, so arrow keys move between them. -->
        <Style x:Key="Wiz.SizeCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Size"/>
            <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Fx.CardBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource Fx.Radius}" Padding="10,16">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="9,15"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Wiz.Preview" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Wiz.Check" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontFamily" Value="{DynamicResource Fx.IconFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fx.AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <!-- The Fluent theme leaves the window's own background to the system backdrop, so the content paints the surface. -->
    <DockPanel Background="{DynamicResource Fx.CardBrush}">
        <!-- ═══ Footer: Skip on the left; Back and Next/Done on the right ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Fx.BgBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                BorderThickness="0,1,0,0" Padding="26,16">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnSkip" DockPanel.Dock="Left" Content="{DynamicResource L.Wiz.Skip}" Padding="16,6" Click="OnSkip"/>
                <Button x:Name="BtnNext" DockPanel.Dock="Right" Style="{DynamicResource Fx.PrimaryButton}" Click="OnNext" Margin="8,0,0,0"/>
                <Button x:Name="BtnBack" DockPanel.Dock="Right" Content="{DynamicResource L.Wiz.Back}" Padding="16,6" Click="OnBack"
                        Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <StackPanel Margin="26,24,26,20">
            <!-- ═══ Progress: one bar per step, then "Step 2 of 5" ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border x:Name="Bar1" Style="{StaticResource Wiz.StepBar}"/>
                <Border x:Name="Bar2" Style="{StaticResource Wiz.StepBar}"/>
                <Border x:Name="Bar3" Style="{StaticResource Wiz.StepBar}"/>
                <Border x:Name="Bar4" Style="{StaticResource Wiz.StepBar}"/>
                <Border x:Name="Bar5" Style="{StaticResource Wiz.StepBar}"/>
                <Border x:Name="Bar6" Style="{StaticResource Wiz.StepBar}"/>
                <TextBlock x:Name="TxtStep" FontSize="12" Foreground="{DynamicResource Fx.TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Step 1: Welcome (and the language, spec §10) -->
            <StackPanel x:Name="Step1" Visibility="Visible">
                <TextBlock Text="{DynamicResource L.Wiz.WelcomeTitle}" Style="{StaticResource Wiz.Title}"/>
                <TextBlock Text="{DynamicResource L.Wiz.WelcomeSub}" Style="{StaticResource Wiz.Sub}"/>
                <StackPanel Margin="0,16,0,0">
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat1}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat2}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat3}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat4}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat5}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Style="{StaticResource Wiz.Check}"/><TextBlock Text="{DynamicResource L.Wiz.Feat6}" Style="{StaticResource Wiz.Text}"/></DockPanel>
                </StackPanel>
                <DockPanel Margin="0,20,0,0">
                    <ComboBox x:Name="CmbLanguage" DockPanel.Dock="Right" MinWidth="220"/>
                    <TextBlock Text="{DynamicResource L.S.app.general.language}" Style="{StaticResource Wiz.Text}" Margin="0,0,12,0"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource L.Wiz.WelcomeFooter}" Style="{StaticResource Wiz.Sub}" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Step 2: Pick a look (UI styles spec §9.3): the gallery of App settings › Look, four cards to a row (the code
                 puts it in LookHost). A pick restyles the wizard at once; Done saves it. At most 460 high: twelve looks
                 are three rows, and the wizard still fits a screen 768 high. -->
            <StackPanel x:Name="StepLook" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Wiz.LookTitle}" Style="{StaticResource Wiz.Title}"/>
                <TextBlock Text="{DynamicResource L.Wiz.LookSub}" Style="{StaticResource Wiz.Sub}"/>
                <ScrollViewer x:Name="LookScroll" Margin="0,16,-8,0" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ContentControl x:Name="LookHost" Focusable="False"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Step 3: Thumbnail size (the presets are the app's own, not the reference's sample numbers) -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Wiz.SizeTitle}" Style="{StaticResource Wiz.Title}"/>
                <TextBlock Text="{DynamicResource L.Wiz.SizeSub}" Style="{StaticResource Wiz.Sub}"/>
                <UniformGrid Columns="3" Margin="0,16,-10,0">
                    <RadioButton x:Name="CardDual" Style="{StaticResource Wiz.SizeCard}" Tag="300,200" Checked="OnSizeCard">
                        <StackPanel>
                            <Border Style="{StaticResource Wiz.Preview}" Width="90" Height="60"/>
                            <TextBlock Text="{DynamicResource L.Wiz.SizeDual}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="300 × 200" FontSize="12" Foreground="{DynamicResource Fx.TextSecondaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CardMulti" Style="{StaticResource Wiz.SizeCard}" Tag="200,150" Checked="OnSizeCard">
                        <StackPanel>
                            <Border Style="{StaticResource Wiz.Preview}" Width="66" Height="50" Margin="0,5,0,15"/>
                            <TextBlock Text="{DynamicResource L.Wiz.SizeMulti}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="200 × 150" FontSize="12" Foreground="{DynamicResource Fx.TextSecondaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CardFleet" Style="{StaticResource Wiz.SizeCard}" Tag="150,100" Checked="OnSizeCard">
                        <StackPanel>
                            <Border Style="{StaticResource Wiz.Preview}" Width="50" Height="34" Margin="0,13,0,23"/>
                            <TextBlock Text="{DynamicResource L.Wiz.SizeFleet}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="150 × 100" FontSize="12" Foreground="{DynamicResource Fx.TextSecondaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <TextBlock x:Name="TxtSelectedSize" Foreground="{DynamicResource Fx.AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Step 4: Hotkeys -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Wiz.HkTitle}" Style="{StaticResource Wiz.Title}"/>
                <TextBlock Text="{DynamicResource L.Wiz.HkSub}" Style="{StaticResource Wiz.Sub}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L.Common.Character}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource L.Common.Hotkey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" Margin="0,0,0,4"/>

                    <TextBox x:Name="TxtWizChar1" Grid.Row="1" Margin="0,3"/>
                    <TextBox x:Name="TxtWizKey1" Grid.Row="1" Grid.Column="2" Margin="0,3"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="⌨" MinWidth="36" Padding="8,4" Margin="4,3,0,3" Click="OnWizCapture" Tag="TxtWizKey1"/>

                    <TextBox x:Name="TxtWizChar2" Grid.Row="2" Margin="0,3"/>
                    <TextBox x:Name="TxtWizKey2" Grid.Row="2" Grid.Column="2" Margin="0,3"/>
                    <Button Grid.Row="2" Grid.Column="3" Content="⌨" MinWidth="36" Padding="8,4" Margin="4,3,0,3" Click="OnWizCapture" Tag="TxtWizKey2"/>

                    <TextBox x:Name="TxtWizChar3" Grid.Row="3" Margin="0,3"/>
                    <TextBox x:Name="TxtWizKey3" Grid.Row="3" Grid.Column="2" Margin="0,3"/>
                    <Button Grid.Row="3" Grid.Column="3" Content="⌨" MinWidth="36" Padding="8,4" Margin="4,3,0,3" Click="OnWizCapture" Tag="TxtWizKey3"/>
                </Grid>
            </StackPanel>

            <!-- Step 5: Character select cycling -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Client.CharSelectCycling}" Style="{StaticResource Wiz.Title}"/>
                <TextBlock Text="{DynamicResource L.Wiz.CycleSub}" Style="{StaticResource Wiz.Sub}"/>
                <CheckBox x:Name="ChkWizCharCycle" Content="{DynamicResource L.Client.EnableCharSelect}" IsChecked="True" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L.Groups.Forward}" Style="{StaticResource Wiz.Text}" Margin="0,0,12,0"/>
                    <TextBox x:Name="TxtWizCycleFwd" Grid.Column="1" Text="F11" Margin="0,3"/>
                    <Button Grid.Column="2" Content="⌨" MinWidth="36" Padding="8,4" Margin="4,3,0,3" Click="OnWizCapture" Tag="TxtWizCycleFwd"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource L.Groups.Backward}" Style="{StaticResource Wiz.Text}" Margin="0,0,12,0"/>
                    <TextBox x:Name="TxtWizCycleBwd" Grid.Row="1" Grid.Column="1" Text="F12" Margin="0,3"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="⌨" MinWidth="36" Padding="8,4" Margin="4,3,0,3" Click="OnWizCapture" Tag="TxtWizCycleBwd"/>
                </Grid>
            </StackPanel>

            <!-- Step 6: Summary -->
            <StackPanel x:Name="Step5" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Wiz.DoneTitle}" Style="{StaticResource Wiz.Title}"/>
                <Border Background="{DynamicResource Fx.BgBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource Fx.Radius}" Padding="16,12" Margin="0,16,0,0">
                    <TextBlock x:Name="TxtSummary" Style="{StaticResource Wiz.Text}" LineHeight="22"/>
                </Border>
                <TextBlock Text="{DynamicResource L.Wiz.DoneNote}" Style="{StaticResource Wiz.Sub}" Margin="0,16,0,0"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
