<Window x:Class="EveMultiPreview.Views.LabelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Lbl.Title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Fx.BgBrush}"
        ShowInTaskbar="False">
    <!-- In the look of the settings window (UI styles spec §8.1, O17); before plan S1 it had the old window's navy. -->
    <Border Style="{DynamicResource Fx.Dialog}">
    <StackPanel Margin="14">
        <TextBlock x:Name="HeaderText" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource L.Lbl.LabelText}" Style="{DynamicResource Fx.Desc}" Margin="0,0,0,3"/>
        <TextBox x:Name="TxtLabel" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource L.Lbl.TextColor}" Style="{DynamicResource Fx.Desc}" Margin="0,0,0,3"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TxtColor" Width="120" TextChanged="OnColorTextChanged"/>
            <Border x:Name="ColorSwatch" Width="24" Height="24" Margin="6,0,0,0"
                    BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"/>
            <Button Content="🎨" Width="32" Height="32" Padding="0" Margin="6,0,0,0" Click="OnPickColor"/>
            <Button Content="{DynamicResource L.Lbl.Default}" Margin="6,0,0,0" Padding="8,2" Click="OnClearColor"
                    ToolTip="{DynamicResource L.Lbl.DefaultTt}"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource L.Lbl.TextSize}" Style="{DynamicResource Fx.Desc}" Margin="0,0,0,3"/>
        <TextBox x:Name="TxtSize" Width="80" HorizontalAlignment="Left" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Lbl.Remove}" Padding="10,4" Click="OnRemove" Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Lbl.RemoveTt}"/>
            <Button Content="{DynamicResource L.Common.Cancel}" Padding="14,4" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="{DynamicResource L.Common.Ok}" Style="{DynamicResource Fx.PrimaryButton}" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
