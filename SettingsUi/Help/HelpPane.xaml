<UserControl x:Class="EveMultiPreview.SettingsUi.HelpPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SettingsTheme/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource Fx.BorderBrush}" Background="{StaticResource Fx.BgBrush}">
        <DockPanel Margin="16,16,8,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Fx.IconFont}"
                        Click="OnClose" Width="32" Height="32" Padding="0" ToolTip="{DynamicResource L.S.Help.Close}"/>
                <TextBlock local:Loc.Key="L.S.Help.Title" Style="{StaticResource Fx.Label}" FontSize="20" FontWeight="SemiBold"/>
            </DockPanel>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="Body" Margin="0,0,8,24"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
