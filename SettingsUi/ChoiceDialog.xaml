<Window x:Class="EveMultiPreview.SettingsUi.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveMultiPreview.SettingsUi"
        Background="{DynamicResource Fx.BgBrush}"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{DynamicResource Fx.Label}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="BodyText" Style="{DynamicResource Fx.Label}" Margin="0,12,0,0"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="YesButton" Click="OnYes" Margin="0,0,8,8" Padding="16,6"/>
            <Button x:Name="NoButton" Click="OnNo" Margin="0,0,8,8" Padding="16,6"/>
            <Button local:Loc.Key="L.S.Shell.Cancel" Click="OnCancel" IsCancel="True" Margin="0,0,8,8" Padding="16,6"/>
        </WrapPanel>
    </StackPanel>
</Window>
