<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.CompactStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Compact (UI styles spec §7.4): dense rows, no cards. Source: Compact.dc.html. The 95 tokens of the contract; a value
         the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF1B1C1E</Color>
    <Color x:Key="Fx.Nav">#FF232427</Color>
    <Color x:Key="Fx.CardColor">#FF232427</Color>
    <Color x:Key="Fx.CardHover">#FF2A2C30</Color>
    <Color x:Key="Fx.Header">#FF1B1C1E</Color>
    <Color x:Key="Fx.Control">#FF232427</Color>
    <Color x:Key="Fx.Flyout">#FF232427</Color>
    <Color x:Key="Fx.AccentSoft">#FF3A2A1C</Color>
    <Color x:Key="Fx.NavHover">#FF2A2C30</Color>
    <Color x:Key="Fx.NavSelected">#FF3A2A1C</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF33353A</Color>
    <Color x:Key="Fx.ControlEdge">#FF4A4D54</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3F4147</Color>
    <Color x:Key="Fx.Divider">#FF2A2C30</Color>
    <Color x:Key="Fx.Focus">#FFF0883E</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFE4E5E7</Color>
    <Color x:Key="Fx.TextSecondary">#FFA2A6AD</Color>
    <Color x:Key="Fx.TextDisabled">#FF7C8088</Color>
    <Color x:Key="Fx.NavText">#FFE4E5E7</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFA2A6AD</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFC08A</Color>
    <Color x:Key="Fx.Title">#FFE4E5E7</Color>
    <Color x:Key="Fx.SectionText">#FFA2A6AD</Color>
    <Color x:Key="Fx.Link">#FFF0883E</Color>
    <Color x:Key="Fx.ValueText">#FFE4E5E7</Color>
    <Color x:Key="Fx.Icon">#FFA2A6AD</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FFF0883E</Color>
    <Color x:Key="Fx.OnAccent">#FF221002</Color>
    <Color x:Key="Fx.NavMark">#FF3A2A1C</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FF232427</Color>
    <Color x:Key="Fx.ButtonHover">#FF2A2C30</Color>
    <Color x:Key="Fx.ButtonBorder">#FF33353A</Color>
    <Color x:Key="Fx.ButtonText">#FFE4E5E7</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FFF0883E</Color>
    <Color x:Key="Fx.CheckMark">#FF221002</Color>
    <Color x:Key="Fx.CheckBorder">#FF7C8088</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF33353A</Color>
    <Color x:Key="Fx.TrackFill">#FFF0883E</Color>
    <Color x:Key="Fx.Thumb">#FFF0883E</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFFF9B9B</Color>
    <Color x:Key="Fx.Warning">#FFEBCB5A</Color>
    <Color x:Key="Fx.InfoColor">#FF8FC4F2</Color>
    <Color x:Key="Fx.AlertBadge">#FFFF9B9B</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF1B1C1E</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF232427</Color>
    <Color x:Key="Fx.CaptionText">#FFA2A6AD</Color>
    <Color x:Key="Fx.WindowBorder">#FF3F4147</Color>

    <!-- Fonts (3): Windows' own until plan S3 Task 10 gives Compact IBM Plex Sans and IBM Plex Mono -->
    <FontFamily x:Key="Fx.Font">Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">Segoe UI</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">11</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">12.5</sys:Double>
    <!-- Weights (4), slant (1), case (4): headings and table heads in capitals -->
    <FontWeight x:Key="Fx.Weight.Title">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">SemiBold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Upper</local:TextCase>
    <!-- Radii (5) -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">3</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">3</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">2</CornerRadius>
    <!-- Lines (3): no card; the box's edge; a hairline under each row -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">204</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">22</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">30</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">28</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">2,0</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">22</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,14,0,2</Thickness>
    <Thickness x:Key="Fx.Page.Padding">20,10,22,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4): the title holds the group (no breadcrumb line); small corners -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Small</local:WindowCorners>
    <!-- Around (5): menus with 24 px rows, radius 3, a tick; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">3</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Tick</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Segoe UI</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- A small square "?" with an edge, its glyph in the note colour. -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Box}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="14"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="14"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Round}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the 14 px box before its label (Fx.Card.Toggle below). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="14"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
    </Style>
    <!-- Icon buttons: 22 by 20, an edge, the glyph in the note colour. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Box}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>
    <!-- A key: the box with a slightly lighter edge. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Compact.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>

    <!-- A row: the label, its note after it on the same line (wrapping under it when there is no room), the control on the
         right; the error under them. A search hit lights the label. -->
    <Style x:Key="Fx.CardHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" Style="{DynamicResource Fx.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <WrapPanel>
                                    <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}" Margin="0" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An on/off setting: the box before its label, the note after the label on the same line. -->
    <DataTemplate x:Key="Fx.Card.Toggle">
        <Border Style="{DynamicResource Fx.Card}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <StackPanel VerticalAlignment="Center">
                <CheckBox Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}"
                          HorizontalAlignment="Left" VerticalContentAlignment="Center">
                    <WrapPanel>
                        <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}" Margin="0" VerticalAlignment="Center"/>
                    </WrapPanel>
                </CheckBox>
                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The title's tokens, for the group, the separator and the page's name of the header. Not a contract name. -->
    <Style x:Key="Compact.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
        <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The page's header: "Alerts › Sounds" is the title (the group goes back to its first page), a small "?" on the
         right, a line under them; the description under the line. Home's title is its name alone. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <StackPanel>
            <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Row}" Padding="0,0,0,6">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource Look.Help}" IsChecked="{Binding HelpOpen}" Content="?"
                                  VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{DynamicResource L.S.Shell.Help}" local:Loc.NameKey="L.S.Shell.Help"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Cursor="Hand" Command="{Binding BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                                Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock local:Loc.Key="{Binding GroupTitleKey}" Style="{StaticResource Compact.Title}"/>
                        </Button>
                        <TextBlock Text=" › " Style="{StaticResource Compact.Title}"
                                   Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}"/>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Compact.Title}">
                                    <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                            <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </DockPanel>
            </Border>
            <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}" Margin="0,6,0,2"/>
        </StackPanel>
    </DataTemplate>

    <!-- The profile: a 22 px square orange avatar, the name, "Profile" after it on the same line. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="4,2" MinHeight="0"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="{DynamicResource Fx.Radius.Control}" Background="{DynamicResource Fx.AccentBrush}">
                    <TextBlock Text="{Binding ProfileInitial}" Foreground="{DynamicResource Fx.OnAccentBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}" Margin="6,0,0,0"
                           Foreground="{DynamicResource Fx.NavTextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or All settings: two joined buttons in a box with the line colour's edge; the picked one orange. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" HorizontalAlignment="Left" Margin="2,6,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                    CornerRadius="{DynamicResource Fx.Radius.Control}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="Fx.Shell.Mode" Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsSimple}" Padding="10,3">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple"/>
                    </RadioButton>
                    <RadioButton GroupName="Fx.Shell.Mode" Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsAdvanced}" Padding="10,3">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
