<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.Windows11Controls"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slot 0 of a Windows 11 window (plan S1, ruling 5): WPF's Fluent dictionary, and the keyed controls that are Fluent's
         button with other metrics. A keyed style replaces the implicit one, so these must be based on it, and only a
         dictionary that merges Fluent can name it while it is read. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- The "›" that opens a page (EditorCard.Open). -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,2"/>
    </Style>

    <!-- A key shown as the hotkey cards show it (EditorCard.HotkeyButton). Its text is in Fx.MonoFont. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- A colour swatch (EditorCard.Swatch): the button around the colour. -->
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
</ResourceDictionary>
