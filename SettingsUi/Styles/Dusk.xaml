<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.DuskStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Dusk (UI styles spec §7.11): soft slate-violet, rounded. Source: Dusk.dc.html. The 95 tokens of the contract; a
         value the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF242535</Color>
    <Color x:Key="Fx.Nav">#FF1B1C29</Color>
    <Color x:Key="Fx.CardColor">#FF2E3045</Color>
    <Color x:Key="Fx.CardHover">#FF34364D</Color>
    <Color x:Key="Fx.Header">#FF2E3045</Color>
    <Color x:Key="Fx.Control">#FF1B1C29</Color>
    <Color x:Key="Fx.Flyout">#FF2E3045</Color>
    <Color x:Key="Fx.AccentSoft">#FF3B3663</Color>
    <Color x:Key="Fx.NavHover">#FF2A2B3D</Color>
    <Color x:Key="Fx.NavSelected">#FF3B3663</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF3D4060</Color>
    <Color x:Key="Fx.ControlEdge">#FF3D4060</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3D4060</Color>
    <Color x:Key="Fx.Divider">#FF3A3D58</Color>
    <Color x:Key="Fx.Focus">#FFB5A8FF</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFEFEEFC</Color>
    <Color x:Key="Fx.TextSecondary">#FFB6B5D4</Color>
    <Color x:Key="Fx.TextDisabled">#FF8684A8</Color>
    <Color x:Key="Fx.NavText">#FFEFEEFC</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFB6B5D4</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Title">#FFEFEEFC</Color>
    <Color x:Key="Fx.SectionText">#FFEFEEFC</Color>
    <Color x:Key="Fx.Link">#FFB5A8FF</Color>
    <Color x:Key="Fx.ValueText">#FFB5A8FF</Color>
    <Color x:Key="Fx.Icon">#FFB6B5D4</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FFB5A8FF</Color>
    <Color x:Key="Fx.OnAccent">#FF1B1538</Color>
    <Color x:Key="Fx.NavMark">#FF3B3663</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FF1B1C29</Color>
    <Color x:Key="Fx.ButtonHover">#FF2A2B3D</Color>
    <Color x:Key="Fx.ButtonBorder">#FF3D4060</Color>
    <Color x:Key="Fx.ButtonText">#FFEFEEFC</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FFB5A8FF</Color>
    <Color x:Key="Fx.CheckMark">#FF1B1538</Color>
    <Color x:Key="Fx.CheckBorder">#FF9391BA</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF3D4060</Color>
    <Color x:Key="Fx.TrackFill">#FFB5A8FF</Color>
    <Color x:Key="Fx.Thumb">#FFB5A8FF</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFFFC2CF</Color>
    <Color x:Key="Fx.Warning">#FFFFE08F</Color>
    <Color x:Key="Fx.InfoColor">#FFB5A8FF</Color>
    <Color x:Key="Fx.AlertBadge">#FFFFC2CF</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF5B2B3D</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF1B1C29</Color>
    <Color x:Key="Fx.CaptionText">#FFB6B5D4</Color>
    <Color x:Key="Fx.WindowBorder">#FF3D4060</Color>

    <!-- Fonts (3): DM Sans, carried (spec §11.1); key labels "Cascadia Mono, Consolas" (O13) -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/DMSans/#DM Sans</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/DMSans/#DM Sans</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">27</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">13</sys:Double>
    <!-- Weights (4), slant (1), case (4) -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">SemiBold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5) -->
    <CornerRadius x:Key="Fx.Radius">12</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">9</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">12</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">10</CornerRadius>
    <!-- Lines (3): no card edge; the box's edge; a hairline under each row (the card hides the last one) -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">252</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">34</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">40</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">42</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,4</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">32</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,14,0,6</Thickness>
    <Thickness x:Key="Fx.Page.Padding">28,14,34,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4) -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): menus with 32 px rows, radius 8, a tick; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">8</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Tick</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">DM Sans</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Collapsed</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- A round "?" on the card's colour, no edge, a lilac glyph. -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Round}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <!-- Under the pointer its edge in the accent (the lighter fill alone was about 1.1:1; final wave). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.RoundTick}">
        <Setter Property="local:Kit.Size" Value="20"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="20"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Round}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <!-- Under the pointer the edge turns the accent colour, as the kit's boxed button (Classic's) does: the hover colour
             alone is within 1.25:1 of the button's (fix round C, LookUsabilityTests). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the round check (before its label: Base.Card.CheckFirst). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.RoundTick}">
        <Setter Property="local:Kit.Size" Value="20"/>
    </Style>
    <!-- Icon buttons are lilac discs with a dark glyph. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Round}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
    </Style>
    <!-- A key: on the pane's colour, lilac letters. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="Background" Value="{DynamicResource Fx.NavBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.AccentBrush}"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Dusk.xaml.cs. ═══ -->

    <!-- The breadcrumb: small, in the note colour, over the title. -->
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>

    <!-- The profile: a round lilac avatar with the initial, the name, "Profile" under it. It opens the profile menu. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="6,4" MinHeight="0"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="38" Height="38">
                    <Ellipse Fill="{DynamicResource Fx.AccentBrush}"/>
                    <local:DecorativeText Text="{Binding ProfileInitial}" Foreground="{DynamicResource Fx.OnAccentBrush}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or All settings: a pill on the page's colour holding two buttons; the picked one lilac. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" HorizontalAlignment="Left" Margin="2,6,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border Background="{DynamicResource Fx.BgBrush}" CornerRadius="{DynamicResource Fx.Radius}" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsSimple}" Margin="0,0,2,0">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple"/>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsAdvanced}">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </GroupBox>
    </DataTemplate>

    <!-- A severity is a pill (spec §7.11): light text on a dark tint, critical on the badge's tint, warning on a dark
         yellow (no token is that tint), info its note colour on the picked surface. -->
    <DataTemplate x:Key="Look.Severity">
        <Border x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,1" CornerRadius="{DynamicResource Fx.Radius.Check}"
                Background="{DynamicResource Fx.AccentSoftBrush}">
            <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" Foreground="{DynamicResource Fx.InfoBrush}" FontWeight="SemiBold"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Fx.OnAlertBadgeBrush}"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Pill" Property="Background" Value="#FF554720"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
