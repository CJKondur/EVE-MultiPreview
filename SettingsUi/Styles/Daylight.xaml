<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.DaylightStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Daylight (UI styles spec §7.6): light and flat. Source: Daylight.dc.html. The 95 tokens of the contract; a colour is
         written once, as a Color, and the loader makes its frozen brush. A value the mock-up does not show is derived from
         its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FFF2F4F7</Color>
    <Color x:Key="Fx.Nav">#FFFFFFFF</Color>
    <Color x:Key="Fx.CardColor">#FFFFFFFF</Color>
    <Color x:Key="Fx.CardHover">#FFF7F8FA</Color>
    <Color x:Key="Fx.Header">#FFFFFFFF</Color>
    <Color x:Key="Fx.Control">#FFFFFFFF</Color>
    <Color x:Key="Fx.Flyout">#FFFFFFFF</Color>
    <Color x:Key="Fx.AccentSoft">#FFE3E8FB</Color>
    <Color x:Key="Fx.NavHover">#FFF2F4F7</Color>
    <Color x:Key="Fx.NavSelected">#FFE3E8FB</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FFD3D9E0</Color>
    <Color x:Key="Fx.ControlEdge">#FFAEB7C2</Color>
    <Color x:Key="Fx.FlyoutBorder">#FFAEB7C2</Color>
    <Color x:Key="Fx.Divider">#FFE6EAEF</Color>
    <Color x:Key="Fx.Focus">#FF2C49C8</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FF18212C</Color>
    <Color x:Key="Fx.TextSecondary">#FF536070</Color>
    <Color x:Key="Fx.TextDisabled">#FF8A94A1</Color>
    <Color x:Key="Fx.NavText">#FF18212C</Color>
    <Color x:Key="Fx.NavTextSecondary">#FF536070</Color>
    <Color x:Key="Fx.NavSelectedText">#FF1F3399</Color>
    <Color x:Key="Fx.Title">#FF18212C</Color>
    <Color x:Key="Fx.SectionText">#FF18212C</Color>
    <Color x:Key="Fx.Link">#FF2C49C8</Color>
    <Color x:Key="Fx.ValueText">#FF18212C</Color>
    <Color x:Key="Fx.Icon">#FF536070</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF2C49C8</Color>
    <Color x:Key="Fx.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavMark">#FFE3E8FB</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FFFFFFFF</Color>
    <Color x:Key="Fx.ButtonHover">#FFF2F4F7</Color>
    <Color x:Key="Fx.ButtonBorder">#FFAEB7C2</Color>
    <Color x:Key="Fx.ButtonText">#FF18212C</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FF2C49C8</Color>
    <Color x:Key="Fx.CheckMark">#FFFFFFFF</Color>
    <Color x:Key="Fx.CheckBorder">#FF6B7787</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FFD3D9E0</Color>
    <Color x:Key="Fx.TrackFill">#FF2C49C8</Color>
    <Color x:Key="Fx.Thumb">#FF2C49C8</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFB3261E</Color>
    <Color x:Key="Fx.Warning">#FF8A5A00</Color>
    <Color x:Key="Fx.InfoColor">#FF2C49C8</Color>
    <Color x:Key="Fx.AlertBadge">#FFB3261E</Color>
    <Color x:Key="Fx.OnAlertBadge">#FFFFFFFF</Color>
    <!-- Title bar (3): a white caption; its buttons dark (TitleBar reads the caption's lightness) -->
    <Color x:Key="Fx.CaptionColor">#FFFFFFFF</Color>
    <Color x:Key="Fx.CaptionText">#FF536070</Color>
    <Color x:Key="Fx.WindowBorder">#FFAEB7C2</Color>

    <!-- Fonts (3): Figtree, carried (spec §11.1); key labels "Cascadia Mono, Consolas" (O13). UiFont chains each with the
         language's family for Chinese, Japanese and Korean (spec §13). -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Figtree/#Figtree</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/Figtree/#Figtree</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">26</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">13.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">13</sys:Double>
    <!-- Weights (4), slant (1), case (4) -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">SemiBold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5) -->
    <CornerRadius x:Key="Fx.Radius">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">4</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">6</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">4</CornerRadius>
    <!-- Lines (3): the card's edge, the box's edge, a hairline under each row (the card hides the last one) -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">248</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">28</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">36</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">40</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,4</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">30</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,14,0,6</Thickness>
    <Thickness x:Key="Fx.Page.Padding">28,14,32,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4) -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): light menus, rows 30, radius 4, a tick; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">4</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Tick</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Figtree</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- A square "?", white with a grey edge and a blue glyph. -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Box}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="18"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="18"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Round}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <!-- Under the pointer the edge turns the accent colour, as the kit's boxed button (Classic's) does: the hover colour
             alone is within 1.25:1 of the button's (fix round C, LookUsabilityTests). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the check box (before its label: Base.Card.CheckFirst). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="18"/>
    </Style>
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Box}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <!-- Under the pointer its edge in the accent (the lighter fill alone was about 1.1:1; final wave). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Daylight.xaml.cs. ═══ -->

    <!-- The breadcrumb: small, in the note colour, over the title. -->
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>

    <!-- The profile: a 34 px square avatar in blue with the initial, the name, "Profile" under it. It opens the profile
         menu. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="6,4" MinHeight="0"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="{DynamicResource Fx.Radius.Control}" Background="{DynamicResource Fx.AccentBrush}">
                    <TextBlock Text="{Binding ProfileInitial}" Foreground="{DynamicResource Fx.OnAccentBrush}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or All settings: two joined buttons in a box with the card's edge; the picked one blue. A group named for
         screen readers, as Classic's. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" HorizontalAlignment="Left" Margin="2,6,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                    CornerRadius="{DynamicResource Fx.Radius.Control}" Background="{DynamicResource Fx.CardBrush}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsSimple}">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple"/>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource Kit.Segment}" IsChecked="{Binding IsAdvanced}">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
