<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.NeonStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Neon (UI styles spec §7.8): violet, with pink, cyan and yellow. Source: Neon.dc.html. The 95 tokens of the contract;
         a value the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF262335</Color>
    <Color x:Key="Fx.Nav">#FF241B2F</Color>
    <Color x:Key="Fx.CardColor">#FF2A2139</Color>
    <Color x:Key="Fx.CardHover">#FF2C2440</Color>
    <Color x:Key="Fx.Header">#FF262335</Color>
    <Color x:Key="Fx.Control">#FF2A2139</Color>
    <Color x:Key="Fx.Flyout">#FF241B2F</Color>
    <Color x:Key="Fx.AccentSoft">#FF34294F</Color>
    <Color x:Key="Fx.NavHover">#FF2C2440</Color>
    <Color x:Key="Fx.NavSelected">#FF34294F</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF3B3454</Color>
    <Color x:Key="Fx.ControlEdge">#FF3B3454</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3B3454</Color>
    <Color x:Key="Fx.Divider">#FF322C49</Color>
    <Color x:Key="Fx.Focus">#FF36F9F6</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFF4F1FF</Color>
    <Color x:Key="Fx.TextSecondary">#FFA39DC9</Color>
    <Color x:Key="Fx.TextDisabled">#FF938DB8</Color>
    <Color x:Key="Fx.NavText">#FFF4F1FF</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFA39DC9</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFF7EDB</Color>
    <Color x:Key="Fx.Title">#FFF4F1FF</Color>
    <Color x:Key="Fx.SectionText">#FFFF7EDB</Color>
    <Color x:Key="Fx.Link">#FF36F9F6</Color>
    <Color x:Key="Fx.ValueText">#FFFEDE5D</Color>
    <Color x:Key="Fx.Icon">#FFA39DC9</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF36F9F6</Color>
    <Color x:Key="Fx.OnAccent">#FF171520</Color>
    <Color x:Key="Fx.NavMark">#FF34294F</Color>
    <!-- Buttons (4): purple -->
    <Color x:Key="Fx.Button">#FF614D85</Color>
    <Color x:Key="Fx.ButtonHover">#FF70599A</Color>
    <Color x:Key="Fx.ButtonBorder">#FF614D85</Color>
    <Color x:Key="Fx.ButtonText">#FFFFFFFF</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FF36F9F6</Color>
    <Color x:Key="Fx.CheckMark">#FF171520</Color>
    <Color x:Key="Fx.CheckBorder">#FF3B3454</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF3B3454</Color>
    <Color x:Key="Fx.TrackFill">#FF36F9F6</Color>
    <Color x:Key="Fx.Thumb">#FFFFFFFF</Color>
    <!-- Status (5) -->
    <!-- #FF6272, a shade over the mock's #FF5C6C: 4.6 to 1 on a pointed item (Fx.AccentSoft), fix round D of plan S4. -->
    <Color x:Key="Fx.Critical">#FFFF6272</Color>
    <Color x:Key="Fx.Warning">#FFFF8B39</Color>
    <Color x:Key="Fx.InfoColor">#FF36F9F6</Color>
    <Color x:Key="Fx.AlertBadge">#FFFF5C6C</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF171520</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF171520</Color>
    <Color x:Key="Fx.CaptionText">#FFA39DC9</Color>
    <Color x:Key="Fx.WindowBorder">#FF3B3454</Color>

    <!-- Fonts (3): Rubik, carried, for text, titles and key labels (spec §11.1) -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Rubik/#Rubik</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">/EVE MultiPreview;component/Resources/Fonts/Rubik/#Rubik</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/Rubik/#Rubik</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">26</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">14</sys:Double>
    <!-- Weights (4), slant (1), case (4) -->
    <FontWeight x:Key="Fx.Weight.Title">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Medium</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5) -->
    <CornerRadius x:Key="Fx.Radius">8</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">6</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">8</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">10</CornerRadius>
    <!-- Lines (3): no card; the box's edge; a hairline under each row (and under each heading) -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">240</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">36</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">42</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,3</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">28</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,16,0,0</Thickness>
    <Thickness x:Key="Fx.Page.Padding">28,16,32,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4) -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): menus with 32 px rows, radius 6, a tick; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">6</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Tick</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Rubik</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Collapsed</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- A round outline "?" with a cyan glyph. -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Round}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="16"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="16"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Round}"/>
    <!-- A switched-off box or dropdown is dashed. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <!-- Under the pointer the edge turns the accent colour, as the kit's boxed button (Classic's) does: the hover colour
             alone is within 1.25:1 of the button's (fix round C, LookUsabilityTests). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the switch without words, on the row's right. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Switch}"/>
    <!-- Icon buttons are purple discs with a white glyph. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Round}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Neon.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>
    <local:KeyCapsConverter x:Key="Neon.Keys"/>

    <!-- A key combination: one cap per key, a 3 px bottom edge, yellow letters, "+" between (the button's content is the
         text of the combination: EditorCard.HotkeyButton's, the hotkey card's below). -->
    <Style x:Key="Fx.KeyCap" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="{DynamicResource Fx.Line.Control}"
                            CornerRadius="{DynamicResource Fx.Radius.Control}" Padding="2">
                        <ItemsControl Focusable="False"
                                      ItemsSource="{Binding Content.Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Neon.Keys}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Plus" Text="+" Foreground="{DynamicResource Fx.TextSecondaryBrush}" Margin="5,0" VerticalAlignment="Center"/>
                                        <Border MinWidth="28" MaxWidth="160" Height="26" Padding="8,0" BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="1,1,1,3"
                                                CornerRadius="5" Background="{DynamicResource Fx.ControlBrush}">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Fx.ValueTextBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <!-- Switched off: faded like the switch and the boxes (plain values only: this is true when the template is made), no hand, no hover edge. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.56"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A destructive button (owner's decision, 2026-10-17): the label stays in the button's own text colour (red on the lit
         purple was 2.4 to 1) and a 2 px critical edge marks it, the same at rest, under the pointer and pressed, so nothing
         shifts. No hover edge of the accent here; the keyboard-focus ring of the kit's template still wins. -->
    <Style x:Key="Neon.Destructive" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CriticalBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- One action button (the base's Look.Action, plan S5): a destructive one takes the style above (a static reference: a
         trigger that is true when the template is made may not set a {DynamicResource}) and 1 px less padding all round,
         so its 2 px edge leaves it the size of a plain button (1 px edge). A template trigger beats the template's own
         Padding, a style setter would not. -->
    <DataTemplate x:Key="Look.Action">
        <Button x:Name="Act" Command="{Binding Command}" Margin="8,0,0,0" Padding="12,4">
            <TextBlock local:Loc.Key="{Binding LabelKey}"/>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                <Setter TargetName="Act" Property="Style" Value="{StaticResource Neon.Destructive}"/>
                <Setter TargetName="Act" Property="Padding" Value="11,3"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A hotkey setting: its combination as key caps, the Clear button beside it. -->
    <DataTemplate x:Key="Fx.Card.Hotkey">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource Fx.KeyCap}" local:Loc.NameKey="{Binding LabelKey}" AutomationProperties.HelpText="{Binding HotkeyDisplay}"
                        Command="{Binding CaptureHotkeyCommand}">
                    <TextBlock Text="{Binding HotkeyDisplay}"/>
                </Button>
                <Button local:Loc.Key="L.S.Hotkey.Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0"
                        Visibility="{Binding HasValue, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- A number box: its figures in yellow; switched off they take the disabled text colour (the mock's grey "20"), over the
         box's own fade. The colour is a style setter, not a local value on the box, so the trigger can win. -->
    <Style x:Key="Neon.NumberBox" TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ValueTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A number setting: its figures in yellow, centred, then the unit. -->
    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" Style="{StaticResource Neon.NumberBox}" MinWidth="58" TextAlignment="Center"
                         Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- The breadcrumb: small, in the note colour, over the title. -->
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>

    <!-- The profile: a 30 px rounded purple square with the initial in white, the name, "Profile" under it. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="6,4" MinHeight="0"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="{DynamicResource Fx.Radius}" Background="{DynamicResource Fx.ButtonBrush}">
                    <local:DecorativeText Text="{Binding ProfileInitial}" Foreground="{DynamicResource Fx.ButtonTextBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="Medium"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or All settings: a dark pill as wide as the pane, holding two equal buttons; the picked one purple. -->
    <Style x:Key="Neon.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius.Control}"
                            BorderThickness="{DynamicResource Fx.Line.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="0,6,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border Background="{DynamicResource Fx.CaptionBrush}" CornerRadius="{DynamicResource Fx.Radius}" Padding="3">
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource Neon.Segment}" IsChecked="{Binding IsSimple}">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Neon.Segment}" IsChecked="{Binding IsAdvanced}">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings"/>
                    </RadioButton>
                </UniformGrid>
            </Border>
        </GroupBox>
    </DataTemplate>

    <!-- A severity: a dot and the word, both in the status colour (spec §7.8). -->
    <DataTemplate x:Key="Look.Severity">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Fx.InfoBrush}"/>
            <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
