<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.TerminalStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Terminal (UI styles spec §7.5): monospace, amber on black. Source: Terminal.dc.html. The 95 tokens of the contract; a
         value the mock-up does not show is derived from its palette (spec: marked *). The metrics marked "cells" are laid on
         the grid by Terminal.xaml.cs when the look loads (the values here are those of a 9.6 px cell). -->

    <!-- Surfaces (10): black; the open page amber -->
    <Color x:Key="Fx.Bg">#FF0D0A04</Color>
    <Color x:Key="Fx.Nav">#FF0D0A04</Color>
    <Color x:Key="Fx.CardColor">#FF0D0A04</Color>
    <Color x:Key="Fx.CardHover">#FF231A08</Color>
    <Color x:Key="Fx.Header">#FF0D0A04</Color>
    <Color x:Key="Fx.Control">#FF231A08</Color>
    <Color x:Key="Fx.Flyout">#FF171206</Color>
    <Color x:Key="Fx.AccentSoft">#FF231A08</Color>
    <Color x:Key="Fx.NavHover">#FF33260A</Color>
    <Color x:Key="Fx.NavSelected">#FFF0A800</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF6E5210</Color>
    <Color x:Key="Fx.ControlEdge">#FF6E5210</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF6E5210</Color>
    <Color x:Key="Fx.Divider">#FF0D0A04</Color>
    <Color x:Key="Fx.Focus">#FFF0A800</Color>
    <!-- Text (11): amber; the bright amber for titles and values; the dim amber for notes -->
    <Color x:Key="Fx.Text">#FFF0A800</Color>
    <Color x:Key="Fx.TextSecondary">#FFB8861F</Color>
    <Color x:Key="Fx.TextDisabled">#FFB8861F</Color>
    <Color x:Key="Fx.NavText">#FFF0A800</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFB8861F</Color>
    <Color x:Key="Fx.NavSelectedText">#FF0D0A04</Color>
    <Color x:Key="Fx.Title">#FFFFCB52</Color>
    <Color x:Key="Fx.SectionText">#FFFFCB52</Color>
    <Color x:Key="Fx.Link">#FFFFCB52</Color>
    <Color x:Key="Fx.ValueText">#FFFFCB52</Color>
    <Color x:Key="Fx.Icon">#FFF0A800</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FFF0A800</Color>
    <Color x:Key="Fx.OnAccent">#FF0D0A04</Color>
    <Color x:Key="Fx.NavMark">#FFF0A800</Color>
    <!-- Buttons (4): text on the page -->
    <Color x:Key="Fx.Button">#FF0D0A04</Color>
    <Color x:Key="Fx.ButtonHover">#FF33260A</Color>
    <Color x:Key="Fx.ButtonBorder">#FF0D0A04</Color>
    <Color x:Key="Fx.ButtonText">#FFF0A800</Color>
    <!-- Check and switch (3): "[x]" in the bright amber -->
    <Color x:Key="Fx.CheckFill">#FF0D0A04</Color>
    <Color x:Key="Fx.CheckMark">#FFFFCB52</Color>
    <Color x:Key="Fx.CheckBorder">#FFF0A800</Color>
    <!-- Slider (3): the filled cells amber, the rest hatched in the dim line colour -->
    <Color x:Key="Fx.Track">#FF6E5210</Color>
    <Color x:Key="Fx.TrackFill">#FFF0A800</Color>
    <Color x:Key="Fx.Thumb">#FFF0A800</Color>
    <!-- Status (5): critical the bright amber (an inverted tag), warning amber -->
    <Color x:Key="Fx.Critical">#FFFFCB52</Color>
    <Color x:Key="Fx.Warning">#FFF0A800</Color>
    <Color x:Key="Fx.InfoColor">#FFB8861F</Color>
    <Color x:Key="Fx.AlertBadge">#FFFFCB52</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF0D0A04</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF171206</Color>
    <Color x:Key="Fx.CaptionText">#FFB8861F</Color>
    <Color x:Key="Fx.WindowBorder">#FF3A2C0C</Color>

    <!-- Fonts (3): everything in Windows' own mono chain (nothing carried) -->
    <FontFamily x:Key="Fx.Font">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <!-- Sizes (8): one size, 16 -->
    <sys:Double x:Key="Fx.Size.Title">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">16</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">16</sys:Double>
    <!-- Weights (4), slant (1), case (4): bold for the title, the section headings and the open page -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Bold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5): square everywhere -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3): a section's box line; controls are text; no line between rows -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">0</Thickness>
    <Thickness x:Key="Fx.Line.Row">0</Thickness>
    <!-- Metrics (11): every entry and row 24 high (one line); cells: the pane, the indent, the label column, the page's padding -->
    <sys:Double x:Key="Fx.Nav.Width">268.8</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">38.4</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">24</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">20</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,0,0,12</Thickness>
    <Thickness x:Key="Fx.Page.Padding">9.6,6,9.6,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">480</sys:Double>
    <!-- Presence (4): no icons, no breadcrumb (the group is part of the title, Task 13), the scroll bar in its own column,
         square corners -->
    <Visibility x:Key="Fx.Nav.Icons">Collapsed</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">False</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Square</local:WindowCorners>
    <!-- Around (5): menus with 24 px rows, square, the pointed item inverted, in Cascadia Mono; a square bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Invert</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Cascadia Mono</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">False</sys:Boolean>

    <!-- ═══ The values the shared parts read; its cells (Terminal.xaml.cs lays them) ═══ -->
    <Visibility x:Key="Look.PaneLine">Collapsed</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <sys:Double x:Key="Look.BoxColumn">38.4</sys:Double>
    <sys:Double x:Key="Terminal.Cell">9.6</sys:Double>
    <sys:Double x:Key="Terminal.SliderWidth">192</sys:Double>
    <Thickness x:Key="Terminal.BoxPad">9.6,0,0,0</Thickness>
    <Thickness x:Key="Terminal.TagPad">4.8,0,4.8,0</Thickness>
    <sys:Double x:Key="Terminal.FindWidth">249.6</sys:Double>
    <!-- Its help: "<Help>" (Task 13's header gives the word; until then the stacked header's "?"). -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Text}"/>

    <!-- ═══ Picks from the kit (spec §6.3): the text shapes ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Text}">
        <Setter Property="Padding" Value="{DynamicResource Terminal.BoxPad}"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Text}">
        <Setter Property="Padding" Value="{DynamicResource Terminal.BoxPad}"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Blocks}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Text}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Text}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Text}"/>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Text}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control: "[x]" or "[ ]" in the row's box column (Base.Card.ColumnsToggle), its label one cell after. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Text}">
        <Setter Property="Padding" Value="{DynamicResource Terminal.BoxPad}"/>
    </Style>
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Button.Text}"/>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Text}"/>
    <!-- A key: "[ Ctrl + Alt + D ]", inverted while it has the keyboard. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal">
                            <local:DecorativeText Text="[ " Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <local:DecorativeText Text=" ]" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Terminal.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A row has no surface of its own: it stands on the page in its section's box. -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
    </Style>

    <!-- A navigation entry: one line, 24 high, flush; under the mouse the hover shade; keyboard focus an edge in the focus
         colour (the open page is the inverted one). -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.NavBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Nav.ItemHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Two lines: the focus colour outside, the page colour inside it, so the open page (filled in the focus
                             colour) still shows the focus as the inner dark line. -->
                        <Grid x:Name="Edge" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource Fx.FocusBrush}" BorderThickness="{DynamicResource Fx.Line.Card}"/>
                            <Border Margin="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.BgBrush}" BorderThickness="{DynamicResource Fx.Line.Card}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- On the entry's own background: the open page's fill (set on the button by its page) wins over it. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Fx.NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dropdown's item: the pointed one (mouse or arrow keys) inverted, amber with black text; the picked one bold, marked ">". -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Kit.Dropdown.Item}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <local:DecorativeText x:Name="Mark" DockPanel.Dock="Left" Text="  " Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="&gt; "/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A menu's item: one line, the pointed one inverted; a checked one marked "x". -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource Kit.Menu.Row}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{DynamicResource Fx.FlyoutBrush}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:DecorativeText x:Name="Tick" Text="  " Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <local:DecorativeText x:Name="Arrow" Grid.Column="3" Text=" &gt;" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"
                                                  VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Card}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Text" Value="x "/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice in a row of choices (Fx.Card.Segmented): "( )" or "(•)" before the word, a cell between two, the one with the
         keyboard inverted (a keyed style: the search results and the tables' rows are list items too). -->
    <Style x:Key="Terminal.Choice" TargetType="ListBoxItem" BasedOn="{StaticResource Kit.List.Item}">
        <Setter Property="Padding" Value="{DynamicResource Terminal.BoxPad}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Padding="{TemplateBinding Padding}" Background="{DynamicResource Fx.BgBrush}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DockPanel>
                                <local:DecorativeText x:Name="Mark" DockPanel.Dock="Left" Text="( ) " Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="(•) "/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card of the look gallery (the base's, with a "[x] " for its tick and a focus line of the card's line, because the
         controls' line is 0 here): the picked card has an amber outline, the mark and the word Current; the one with the
         keyboard a line in the focus colour just inside it. -->
    <Style x:Key="Look.Card" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter/>
                                <StackPanel x:Name="Current" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Hidden">
                                    <local:DecorativeText Text="[x] " Foreground="{DynamicResource Fx.CheckMarkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="L.S.Look.Current" Style="{DynamicResource Fx.Label}" Foreground="{DynamicResource Fx.CheckMarkBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Outline" Margin="1" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" Margin="3" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Current" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Fx.Card.Segmented">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ListBox local:Loc.NameKey="{Binding LabelKey}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                     ItemTemplate="{DynamicResource Fx.OptionText}" ItemContainerStyle="{DynamicResource Terminal.Choice}"
                     BorderThickness="{DynamicResource Fx.Line.Control}" Background="{x:Null}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </ContentControl>
    </DataTemplate>

    <!-- A group: "+ " closed or "- " open, then its name; its pages under it while it is open. -->
    <DataTemplate x:Key="Fx.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="{DynamicResource Terminal.BoxPad}" local:Loc.NameKey="{Binding TitleKey}">
                <StackPanel Orientation="Horizontal">
                    <local:DecorativeText x:Name="Sign" Text="+ " Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Sign" Property="Text" Value="- "/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A section: a box with its title set into its top line (the kit's group box). -->
    <DataTemplate x:Key="Fx.Section">
        <GroupBox Margin="{DynamicResource Fx.Section.Gap}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <GroupBox.Header>
                <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" Margin="0"/>
            </GroupBox.Header>
            <ContentPresenter Content="{Binding Cards}"/>
        </GroupBox>
    </DataTemplate>

    <!-- A slider: twenty cells, then its value and unit in the bright amber. -->
    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="{DynamicResource Terminal.SliderWidth}" VerticalAlignment="Center"
                        Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
                <TextBlock Text="{Binding Number, StringFormat=N0}" Foreground="{DynamicResource Fx.ValueTextBrush}" FontSize="{DynamicResource Fx.Size.Control}" VerticalAlignment="Center"
                           Margin="{DynamicResource Terminal.BoxPad}"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.ValueTextBrush}" FontSize="{DynamicResource Fx.Size.Control}" VerticalAlignment="Center"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- A number: "[   5]", right-aligned on the field colour, the unit after it. -->
    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="40" TextAlignment="Right" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextBrush}" FontSize="{DynamicResource Fx.Size.Control}" VerticalAlignment="Center" Margin="{DynamicResource Terminal.BoxPad}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- A severity: critical an inverted tag (the bright amber behind, black bold text); warning and info plain. -->
    <DataTemplate x:Key="Look.Severity">
        <Border x:Name="Tag" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="{DynamicResource Terminal.TagPad}">
            <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" Foreground="{DynamicResource Fx.InfoBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                <Setter TargetName="Word" Property="FontWeight" Value="Bold"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
