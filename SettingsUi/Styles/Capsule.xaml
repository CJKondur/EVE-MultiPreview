<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.CapsuleStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Capsule (UI styles spec §7.3): dark and sharp, like the game. Source: Eve.dc.html. The 95 tokens of the contract; a
         value the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF14181C</Color>
    <Color x:Key="Fx.Nav">#FF0F1316</Color>
    <Color x:Key="Fx.CardColor">#FF181D22</Color>
    <Color x:Key="Fx.CardHover">#FF1B2127</Color>
    <Color x:Key="Fx.Header">#FF1D242A</Color>
    <Color x:Key="Fx.Control">#FF0B0E11</Color>
    <Color x:Key="Fx.Flyout">#FF181D22</Color>
    <Color x:Key="Fx.AccentSoft">#FF20272E</Color>
    <Color x:Key="Fx.NavHover">#FF171C21</Color>
    <Color x:Key="Fx.NavSelected">#FF20272E</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF272E35</Color>
    <Color x:Key="Fx.ControlEdge">#FF3A444D</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3A444D</Color>
    <Color x:Key="Fx.Divider">#FF272E35</Color>
    <Color x:Key="Fx.Focus">#FF86B7CE</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFDDE2E6</Color>
    <Color x:Key="Fx.TextSecondary">#FF98A4AE</Color>
    <Color x:Key="Fx.TextDisabled">#FF7F8A93</Color>
    <Color x:Key="Fx.NavText">#FFDDE2E6</Color>
    <Color x:Key="Fx.NavTextSecondary">#FF98A4AE</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Title">#FFDDE2E6</Color>
    <Color x:Key="Fx.SectionText">#FFDDE2E6</Color>
    <Color x:Key="Fx.Link">#FF86B7CE</Color>
    <Color x:Key="Fx.ValueText">#FF98A4AE</Color>
    <Color x:Key="Fx.Icon">#FF98A4AE</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF86B7CE</Color>
    <Color x:Key="Fx.OnAccent">#FF0B0E11</Color>
    <Color x:Key="Fx.NavMark">#FF86B7CE</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FF0B0E11</Color>
    <Color x:Key="Fx.ButtonHover">#FF1B2127</Color>
    <Color x:Key="Fx.ButtonBorder">#FF3A444D</Color>
    <Color x:Key="Fx.ButtonText">#FFDDE2E6</Color>
    <!-- Check and switch (3): the box on the input colour, the accent square when on -->
    <Color x:Key="Fx.CheckFill">#FF0B0E11</Color>
    <Color x:Key="Fx.CheckMark">#FF86B7CE</Color>
    <Color x:Key="Fx.CheckBorder">#FF6B7882</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF3A444D</Color>
    <Color x:Key="Fx.TrackFill">#FF86B7CE</Color>
    <Color x:Key="Fx.Thumb">#FFFFFFFF</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFE0655C</Color>
    <Color x:Key="Fx.Warning">#FFDDAA4C</Color>
    <Color x:Key="Fx.InfoColor">#FF86B7CE</Color>
    <Color x:Key="Fx.AlertBadge">#FFE0655C</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF0B0E11</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF0F1316</Color>
    <Color x:Key="Fx.CaptionText">#FFDDE2E6</Color>
    <Color x:Key="Fx.WindowBorder">#FF3A444D</Color>

    <!-- Fonts (3): Barlow, carried (spec §11.1), for text, titles and key labels -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Barlow/#Barlow</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">/EVE MultiPreview;component/Resources/Fonts/Barlow/#Barlow</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/Barlow/#Barlow</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">20</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">13</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">13</sys:Double>
    <!-- Weights (4), slant (1), case (4): the title medium, the panels' titles semibold; nothing upper-case -->
    <FontWeight x:Key="Fx.Weight.Title">Medium</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Normal</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5): square everywhere -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3): the panel's line, the box's edge; no line between rows -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0</Thickness>
    <!-- Metrics (11): the label column is 340, after a 24 px column for the box (Look.BoxColumn) -->
    <sys:Double x:Key="Fx.Nav.Width">228</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">28</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">26</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">48</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">34</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,4</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">22</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,0,0,12</Thickness>
    <Thickness x:Key="Fx.Page.Padding">20,14,22,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">340</sys:Double>
    <!-- Presence (4): icons in the note colour, no breadcrumb, the scroll bar in its own column, square corners -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">False</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Square</local:WindowCorners>
    <!-- Around (5): menus with 26 px rows, square, the checked item marked with the accent bar; a square bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">26</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Bar</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Barlow</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">False</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <sys:Double x:Key="Look.BoxColumn">24</sys:Double>
    <!-- A round "?" 22 px, outline only, its glyph in the note colour. -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Round}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Fill}">
        <Setter Property="local:Kit.Size" Value="14"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="14"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Bar}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the 14 px box in the row's box column (Base.Card.ColumnsToggle). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Fill}">
        <Setter Property="local:Kit.Size" Value="14"/>
    </Style>
    <!-- Icon buttons: 22 px, an edge, the glyph in the text colour, on the panel. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Box}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
    </Style>
    <!-- A key: the box on the input colour, as wide as its keys. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Capsule.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A row has no surface of its own: it stands on its section's panel. Hand-built editors frame themselves with it. -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
    </Style>

    <!-- A panel's header bar: 28 high on the header colour, a triangle that points down while the panel is open and right
         while it is folded, the title. It folds the panel (owner decision O19). Keyboard focus draws its edge in the focus
         colour. -->
    <Style x:Key="Capsule.Fold" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.SectionTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.HeaderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Path x:Name="Twisty" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="None"
                                      Fill="{DynamicResource Fx.TextSecondaryBrush}" Data="M 2 0 L 7 4 L 2 8 Z"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="Edge" BorderBrush="{DynamicResource Fx.FocusBrush}" BorderThickness="{DynamicResource Fx.Line.Control}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Twisty" Property="Data" Value="M 0 2 L 8 2 L 4 7 Z"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A section is a panel: a line around it on the panel colour, its header bar (the fold), its rows under it while it
         is open (SectionVM.IsOpen: a page opens with its sections open). -->
    <DataTemplate x:Key="Fx.Section">
        <Border Margin="{DynamicResource Fx.Section.Gap}" Background="{DynamicResource Fx.CardBrush}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                BorderThickness="{DynamicResource Fx.Line.Card}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <StackPanel>
                <ToggleButton x:Name="Fold" Style="{StaticResource Capsule.Fold}" IsChecked="{Binding IsOpen}" local:Loc.NameKey="{Binding TitleKey}">
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" Margin="0"/>
                </ToggleButton>
                <ContentPresenter Content="{Binding Cards}" Margin="10,6,10,8"
                                  Visibility="{Binding IsOpen, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A number: right-aligned in its box, the unit after it. -->
    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="50" TextAlignment="Right" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- One of the two joined tabs: on the pane in the note colour; the active one on the lighter surface, white, with a
         2 px accent line under it. -->
    <Style x:Key="Capsule.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.NavBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="Under" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Fx.AccentBrush}" Visibility="Collapsed"/>
                        <Border x:Name="Edge" BorderBrush="{DynamicResource Fx.FocusBrush}" BorderThickness="{DynamicResource Fx.Line.Control}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                            <Setter TargetName="Under" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple or All settings: two joined tabs in a box with the input edge's line; they share the pane's width, and a long
         word in a translation wraps inside its tab. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="0,8,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border BorderBrush="{DynamicResource Fx.ControlEdgeBrush}" BorderThickness="{DynamicResource Fx.Line.Control}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="Fx.Shell.Mode" Style="{StaticResource Capsule.Tab}" IsChecked="{Binding IsSimple}">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple" TextWrapping="Wrap" TextAlignment="Center"/>
                    </RadioButton>
                    <RadioButton Grid.Column="1" GroupName="Fx.Shell.Mode" Style="{StaticResource Capsule.Tab}" IsChecked="{Binding IsAdvanced}">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings" TextWrapping="Wrap" TextAlignment="Center"/>
                    </RadioButton>
                </Grid>
            </Border>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
