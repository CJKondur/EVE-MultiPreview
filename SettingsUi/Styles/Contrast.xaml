<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.ContrastStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- High contrast (UI styles spec §7.7): black and white, with larger text. Source: Contrast.dc.html. The 95 tokens of
         the contract; a value the mock-up does not show is derived from its palette (spec: marked *). While Windows has a
         contrast theme on, its colours are Windows' own (spec §12, UiStyles.SystemContrast). -->

    <!-- Surfaces (10): black; the open page cyan -->
    <Color x:Key="Fx.Bg">#FF000000</Color>
    <Color x:Key="Fx.Nav">#FF000000</Color>
    <Color x:Key="Fx.CardColor">#FF000000</Color>
    <Color x:Key="Fx.CardHover">#FF000000</Color>
    <Color x:Key="Fx.Header">#FF000000</Color>
    <Color x:Key="Fx.Control">#FF000000</Color>
    <Color x:Key="Fx.Flyout">#FF000000</Color>
    <Color x:Key="Fx.AccentSoft">#FF000000</Color>
    <Color x:Key="Fx.NavHover">#FF000000</Color>
    <Color x:Key="Fx.NavSelected">#FF1AEBFF</Color>
    <!-- Lines (5): white -->
    <Color x:Key="Fx.Border">#FFFFFFFF</Color>
    <Color x:Key="Fx.ControlEdge">#FFFFFFFF</Color>
    <Color x:Key="Fx.FlyoutBorder">#FFFFFFFF</Color>
    <Color x:Key="Fx.Divider">#FFFFFFFF</Color>
    <Color x:Key="Fx.Focus">#FFFFFFFF</Color>
    <!-- Text (11): white; links yellow; switched-off green, as Windows' contrast themes draw it -->
    <Color x:Key="Fx.Text">#FFFFFFFF</Color>
    <Color x:Key="Fx.TextSecondary">#FFFFFFFF</Color>
    <Color x:Key="Fx.TextDisabled">#FF3FF23F</Color>
    <Color x:Key="Fx.NavText">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavSelectedText">#FF000000</Color>
    <Color x:Key="Fx.Title">#FFFFFFFF</Color>
    <Color x:Key="Fx.SectionText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Link">#FFFFFF00</Color>
    <Color x:Key="Fx.ValueText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Icon">#FFFFFFFF</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF1AEBFF</Color>
    <Color x:Key="Fx.OnAccent">#FF000000</Color>
    <Color x:Key="Fx.NavMark">#FF1AEBFF</Color>
    <!-- Buttons (4): black with a white edge -->
    <Color x:Key="Fx.Button">#FF000000</Color>
    <Color x:Key="Fx.ButtonHover">#FF000000</Color>
    <Color x:Key="Fx.ButtonBorder">#FFFFFFFF</Color>
    <Color x:Key="Fx.ButtonText">#FFFFFFFF</Color>
    <!-- Check and switch (3): cyan with a black knob when on, a white outline and knob when off -->
    <Color x:Key="Fx.CheckFill">#FF1AEBFF</Color>
    <Color x:Key="Fx.CheckMark">#FF000000</Color>
    <Color x:Key="Fx.CheckBorder">#FFFFFFFF</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FFFFFFFF</Color>
    <Color x:Key="Fx.TrackFill">#FF1AEBFF</Color>
    <Color x:Key="Fx.Thumb">#FF1AEBFF</Color>
    <!-- Status (5): white; severity is told by shape and word (Task 5), no colour carries meaning -->
    <Color x:Key="Fx.Critical">#FFFFFFFF</Color>
    <Color x:Key="Fx.Warning">#FFFFFFFF</Color>
    <Color x:Key="Fx.InfoColor">#FFFFFFFF</Color>
    <Color x:Key="Fx.AlertBadge">#FFFFFF00</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF000000</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF000000</Color>
    <Color x:Key="Fx.CaptionText">#FFFFFFFF</Color>
    <Color x:Key="Fx.WindowBorder">#FFFFFFFF</Color>

    <!-- Fonts (3): Windows' own, nothing carried -->
    <FontFamily x:Key="Fx.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Sizes (8): larger, base 15 -->
    <sys:Double x:Key="Fx.Size.Title">26</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">15</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">15</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">15</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">15</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">15</sys:Double>
    <!-- Weights (4), slant (1), case (4) -->
    <FontWeight x:Key="Fx.Weight.Title">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">SemiBold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5): 4; the switch's pill 10 -->
    <CornerRadius x:Key="Fx.Radius">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">4</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">10</CornerRadius>
    <!-- Lines (3): every line white, 1 px: the box, the control, between rows -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">262</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">34</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">40</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">40</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">14,5</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">30</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,12,0,6</Thickness>
    <Thickness x:Key="Fx.Page.Padding">16,6,28,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4): icons; the group is part of the title (Task 5), no breadcrumb; the scroll bar in its own column -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">False</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): menus with 34 px rows, a white edge, the pointed item inverted; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">34</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">4</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Invert</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Segoe UI</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ Focus: a 2 px outline in the focus colour, 2 px away from the control (spec §7.7). Every control the look
         styles takes it as its FocusVisualStyle; WPF draws it while the control has the keyboard's focus. ═══ -->
    <Style x:Key="Contrast.Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="2" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The ring a control built in code takes as its focus visual (a chip's ✕, EditorCard.Chip; the base's Base.FocusRing):
         here the 2 px outline every control has (fix round C). -->
    <Style x:Key="Base.FocusRing" BasedOn="{StaticResource Contrast.Focus}"/>

    <!-- The width of a mark drawn on a hover or a pick (a button's edge under the mouse, a gallery card's, a list item's
         focus ring): as wide as the focus outline. Not a contract name. -->
    <Thickness x:Key="Contrast.Line.Mark">2</Thickness>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Collapsed</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- The help: a yellow underlined link (its header gives the words), with the focus outline as its only ring (no edge of
         its own, so a click shows none); under the mouse a cyan outline. Enter and Space open and close it (ButtonBase's own). -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Link}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="Hover" Margin="-2" BorderBrush="{DynamicResource Fx.AccentBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                                CornerRadius="{DynamicResource Fx.Radius.Control}" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Switched off: faded, as the kit's (it was drawn live; final wave). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A gallery card (the base's Look.Card, the page's own part): the focus outline for the keyboard (the base's focus
         is its edge in the focus colour, here the edge's own white), and under the mouse a 2 px white edge (a shade on black
         cannot be seen). The current look's card keeps its three cues: the cyan inner line, the tick and the word. -->
    <Style x:Key="Look.Card" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius}" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter/>
                                <StackPanel x:Name="Current" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Hidden">
                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Fx.IconFont}" Foreground="{DynamicResource Fx.LinkBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock local:Loc.Key="L.S.Look.Current" Style="{DynamicResource Fx.Label}" Foreground="{DynamicResource Fx.LinkBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Hover" BorderThickness="{DynamicResource Contrast.Line.Mark}" BorderBrush="{DynamicResource Fx.TextBrush}"
                                CornerRadius="{DynamicResource Fx.Radius}" Visibility="Hidden" IsHitTestVisible="False"/>
                        <Border x:Name="Outline" Margin="1" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}"
                                CornerRadius="{DynamicResource Fx.Radius}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Current" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3), each with the focus outline ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="18"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="18"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Ring}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
    </Style>
    <!-- A text box: black with a white edge; switched off, its text and edge in the switched-off green. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.TextDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A button (and an icon button, a key box, a colour box): under the mouse its white edge is 2 px (on black a hover
         shade cannot be seen; the content stays centred). -->
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
                <Setter Property="Padding" Value="11,0"/>   <!-- the edge 1 px thicker, the padding 1 px less: the text stays put (fix B re-review N1) -->
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A toggle button: under the mouse a 2 px edge; held in (on), filled cyan with black semibold text, as the open page
         and the picked mode button are (not an edge of another colour alone). -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
                <Setter Property="Padding" Value="11,0"/>   <!-- the edge 1 px thicker, the padding 1 px less: the text stays put (fix B re-review N1) -->
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- Icon buttons: 30 px, black with a white edge, a white glyph. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Box}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
                <Setter Property="Padding" Value="11,0"/>   <!-- the edge 1 px thicker, the padding 1 px less: the text stays put (fix B re-review N1) -->
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A dropdown's item: the pointed one (mouse or arrow keys) inverted, white with black text (spec §7.7); the picked one
         with a tick and semibold. -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Kit.Dropdown.Item.Invert}"/>

    <!-- A menu's item: 34 px; the pointed one inverted, white with black text (spec §7.7, "Around"); a checked one ticked. -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource Kit.Menu.Row.Invert}"/>

    <!-- A list's item (a row of choices: Fx.Card.Segmented) and a table's row: the keyboard's focus a 2 px white ring inside
         the item (a list scrolls, and its scroller would cut an outline outside the item); under the mouse a 1 px white
         ring; the picked one marked by a cyan bar (under a choice, left of a row) and semibold, so a picked row with the
         focus differs from a row with the focus only. -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Kit.List.Item}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10,4,10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Bar" Height="3" Margin="4,0,4,3" VerticalAlignment="Bottom" Background="{DynamicResource Fx.AccentBrush}" Visibility="Hidden"/>
                        <Border x:Name="Hover" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.TextBrush}" Visibility="Hidden"/>
                        <Border x:Name="Ring" BorderThickness="{DynamicResource Contrast.Line.Mark}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource Kit.Row.Item}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Margin="{TemplateBinding Padding}" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Bar" Width="3" Margin="3,4,0,4" HorizontalAlignment="Left" Background="{DynamicResource Fx.AccentBrush}" Visibility="Hidden"/>
                        <Border x:Name="Hover" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.TextBrush}" Visibility="Hidden"/>
                        <Border x:Name="Ring" BorderThickness="{DynamicResource Contrast.Line.Mark}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The on/off control: the base's switch with On and Off (it reads these tokens: a white outline and knob when off,
         cyan with a black knob when on), with the focus outline. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" local:Loc.Key="L.S.Off" Foreground="{DynamicResource Fx.TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="{DynamicResource Fx.Radius.Check}" BorderThickness="{DynamicResource Fx.Line.Control}"
                                BorderBrush="{DynamicResource Fx.CheckBorderBrush}" Background="{DynamicResource Fx.ControlBrush}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Fx.CheckBorderBrush}"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="local:Loc.Key" Value="L.S.On"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Contrast.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>

    <!-- A navigation entry: a line Fx.Nav.ItemHeight high; under the mouse a cyan outline (the hover is an outline, not a
         shade: on black a shade cannot be seen); the focus outline for the keyboard. The open page's fill is set on the
         button (Base.Nav.Page). 4 px free left, right and above each entry: the outline reaches 4 px out, and the
         navigation's scroller would cut it at its edges (the first entry's top, every entry's sides). -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.NavBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="4,4,4,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Nav.ItemHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Contrast.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource Fx.Radius.Nav}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hover" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource Fx.AccentBrush}"
                                BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Nav}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A section: its heading; then its rows in one box with a white edge, a white line between two rows (each row's line
         is under it, and the box's last pixel line is clipped). -->
    <DataTemplate x:Key="Fx.Section">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            <Grid>
                <Border Background="{DynamicResource Fx.CardBrush}" CornerRadius="{DynamicResource Fx.Radius}"/>
                <Border Margin="1" ClipToBounds="True">
                    <ContentPresenter Content="{Binding Cards}" Margin="0,0,0,-1"/>
                </Border>
                <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Card}"
                        CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- One of the two mode buttons (the kit's segment): under the mouse a 1 px white ring inside it (on black a hover
         shade cannot be seen); picked, cyan with black semibold text. Not a contract name. -->
    <Style x:Key="Contrast.Segment" TargetType="RadioButton" BasedOn="{StaticResource Kit.Segment}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius.Control}"
                                BorderThickness="{DynamicResource Fx.Line.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="Hover" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.TextBrush}"
                                CornerRadius="{DynamicResource Fx.Radius.Control}" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple or All settings: two joined buttons in a box with the white edge; the picked one cyan with black text. They
         share the pane's width, and a long word in a translation wraps inside its button. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="0,8,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Border BorderBrush="{DynamicResource Fx.ControlEdgeBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                    CornerRadius="{DynamicResource Fx.Radius.Control}" Padding="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Style="{StaticResource Contrast.Segment}" IsChecked="{Binding IsSimple}"
                                 FontSize="{DynamicResource Fx.Size.Body}" FocusVisualStyle="{StaticResource Contrast.Focus}" Padding="6,5">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple" TextWrapping="Wrap" TextAlignment="Center"/>
                    </RadioButton>
                    <RadioButton Grid.Column="1" Style="{StaticResource Contrast.Segment}" IsChecked="{Binding IsAdvanced}"
                                 FontSize="{DynamicResource Fx.Size.Body}" FocusVisualStyle="{StaticResource Contrast.Focus}" Padding="6,5">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings" TextWrapping="Wrap" TextAlignment="Center"/>
                    </RadioButton>
                </Grid>
            </Border>
        </GroupBox>
    </DataTemplate>
    <!-- A severity: a shape and the word, in the status colours (white here; Windows' text colour in a contrast theme):
         ▲ filled for critical, △ outlined for warning, the word alone for info. No colour carries the meaning. -->
    <DataTemplate x:Key="Look.Severity">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path x:Name="Shape" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" StrokeThickness="2"
                  Data="M 12,3 L 22,21 L 2,21 Z" Visibility="Collapsed"/>
            <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Shape" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Shape" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Shape" Property="Data" Value="M 12,4.5 L 20.5,20 L 3.5,20 Z"/>
                <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The title's tokens, for the group, the separator and the page's name of the header (the ones the base's title
         reads): a long title (a translation, Windows' larger text) wraps, it is not cut off. Not a contract name. -->
    <Style x:Key="Contrast.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.TitleFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
        <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The page's header: "Alerts › Sounds" is the title, the group in regular weight (it goes back to the group's first
         page); "Help for this page" as a link on the right; the description under them. Home's title is its name alone. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <StackPanel Margin="0,0,0,2">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource Look.Help}" IsChecked="{Binding HelpOpen}" VerticalAlignment="Center"
                              Margin="16,0,0,0" local:Loc.NameKey="L.S.Shell.Help">
                    <TextBlock local:Loc.Key="L.S.Shell.Help" TextDecorations="Underline"/>
                </ToggleButton>
                <WrapPanel VerticalAlignment="Center">
                    <Button Cursor="Hand" FocusVisualStyle="{StaticResource Contrast.Focus}"
                            Command="{Binding BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                            Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <!-- Under the mouse the group is underlined: it is a link back to the group's first page. -->
                        <TextBlock local:Loc.Key="{Binding GroupTitleKey}" FontWeight="Normal">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Contrast.Title}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <!-- Drawn, not read: a screen reader says "Alerts, Sounds", not the arrow between them. -->
                    <local:DecorativeText Text="  ›  " Style="{StaticResource Contrast.Title}" FontWeight="Normal"
                                          Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}"/>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Contrast.Title}">
                                <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                        <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
            </DockPanel>
            <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}" Margin="0"/>
        </StackPanel>
    </DataTemplate>

    <!-- The profile: an outlined button, 44 high, with the name, "Profile" under it and a chevron; it opens the profile
         menu under it. A screen reader hears both words, "Default, Profile" (the name alone did not say what it is). -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                FocusVisualStyle="{StaticResource Contrast.Focus}"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" MinHeight="44" Padding="12,0" Background="{DynamicResource Fx.ControlBrush}" BorderBrush="{DynamicResource Fx.ControlEdgeBrush}"
                            BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Control}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="{DynamicResource Contrast.Line.Mark}"/>
                            <Setter TargetName="Box" Property="Padding" Value="11,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <DockPanel>
                <Path DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Data="M 0 0 L 5 5 L 10 0"
                      Stroke="{DynamicResource Fx.TextBrush}" StrokeThickness="1.5"/>
                <StackPanel>
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ProfileWord" local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}" Foreground="{DynamicResource Fx.TextBrush}" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <AutomationProperties.Name>
                <MultiBinding StringFormat="{}{0}, {1}">
                    <Binding Path="ProfileName"/>
                    <Binding ElementName="ProfileWord" Path="Text"/>
                </MultiBinding>
            </AutomationProperties.Name>
        </Button>
    </DataTemplate>

</ResourceDictionary>
