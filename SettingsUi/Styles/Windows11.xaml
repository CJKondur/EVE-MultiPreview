<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.Windows11Style"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Windows 11 (today's look, spec §7.2): the 95 tokens of the contract (StyleContract). A colour is written once,
         as a Color; the loader makes its frozen brush (Fx.<Name>Brush; Fx.CardColor's is Fx.CardBrush). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF202020</Color>
    <Color x:Key="Fx.Nav">#FF202020</Color>
    <Color x:Key="Fx.CardColor">#FF2B2B2B</Color>
    <Color x:Key="Fx.CardHover">#FF323232</Color>
    <Color x:Key="Fx.Header">#FF2B2B2B</Color>
    <Color x:Key="Fx.Control">#FF383838</Color>
    <Color x:Key="Fx.Flyout">#FF2C2C2C</Color>
    <Color x:Key="Fx.AccentSoft">#FF2F3A42</Color>
    <Color x:Key="Fx.NavHover">#FF2D2D2D</Color>
    <Color x:Key="Fx.NavSelected">#FF202020</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF3A3A3A</Color>
    <Color x:Key="Fx.ControlEdge">#FF5A5A5A</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF454545</Color>
    <Color x:Key="Fx.Divider">#FF3A3A3A</Color>
    <Color x:Key="Fx.Focus">#FFFFFFFF</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFFFFFFF</Color>
    <Color x:Key="Fx.TextSecondary">#FFABABAB</Color>
    <Color x:Key="Fx.TextDisabled">#FF787878</Color>
    <Color x:Key="Fx.NavText">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFABABAB</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Title">#FFFFFFFF</Color>
    <Color x:Key="Fx.SectionText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Link">#FF4CC2FF</Color>
    <Color x:Key="Fx.ValueText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Icon">#FFD0D0D0</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF4CC2FF</Color>
    <Color x:Key="Fx.OnAccent">#FF00202F</Color>
    <Color x:Key="Fx.NavMark">#FF4CC2FF</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FF383838</Color>
    <Color x:Key="Fx.ButtonHover">#FF454545</Color>
    <Color x:Key="Fx.ButtonBorder">#FF3A3A3A</Color>
    <Color x:Key="Fx.ButtonText">#FFFFFFFF</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FF4CC2FF</Color>
    <Color x:Key="Fx.CheckMark">#FF000000</Color>
    <Color x:Key="Fx.CheckBorder">#FFABABAB</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF5A5A5A</Color>
    <Color x:Key="Fx.TrackFill">#FF4CC2FF</Color>
    <Color x:Key="Fx.Thumb">#FF4CC2FF</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFFF99A4</Color>
    <Color x:Key="Fx.Warning">#FFFCE100</Color>
    <Color x:Key="Fx.InfoColor">#FF60CDFF</Color>
    <Color x:Key="Fx.AlertBadge">#FFFF6B57</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF2A0A05</Color>
    <!-- Title bar (3). This colour and ValueText above are the spec's colours "Caption" and "Value" (ruling 19). Alpha 0
         means "the system's own": Windows 11 draws its caption, text and edge itself, as today. -->
    <Color x:Key="Fx.CaptionColor">#00000000</Color>
    <Color x:Key="Fx.CaptionText">#00000000</Color>
    <Color x:Key="Fx.WindowBorder">#00000000</Color>

    <!-- Fonts (3): today's (UiFont gives the window its family; ruling 8) -->
    <FontFamily x:Key="Fx.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">28</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">14</sys:Double>
    <!-- Weights (4), slant (1), case (4) -->
    <FontWeight x:Key="Fx.Weight.Title">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Normal</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5) -->
    <CornerRadius x:Key="Fx.Radius">6</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">4</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">8</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">4</CornerRadius>
    <!-- Lines (3) -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">264</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">36</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">40</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">64</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">16,12</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0,0,0,4</Thickness>
    <sys:Double x:Key="Fx.Control.Height">32</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,20,0,8</Thickness>
    <Thickness x:Key="Fx.Page.Padding">24,16</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4) -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): the surfaces drawn in code -->
    <sys:Double x:Key="Fx.Menu.RowHeight">32</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">5</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Bar</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Segoe UI</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>
</ResourceDictionary>
