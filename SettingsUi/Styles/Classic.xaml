<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.ClassicStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Classic (UI styles spec §7.1): the old MultiPreview navy, drawn on the new window's pages. Source: Classic.dc.html
         and the old window (App.xaml, Views/SettingsWindow.xaml). The 95 tokens of the contract (StyleContract); a colour
         is written once, as a Color, and the loader makes its frozen brush. A value the mock-up does not show is derived
         from the old window's palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF1A1A2E</Color>
    <Color x:Key="Fx.Nav">#FF0F3460</Color>
    <Color x:Key="Fx.CardColor">#FF252540</Color>
    <Color x:Key="Fx.CardHover">#FF3A3A5E</Color>
    <Color x:Key="Fx.Header">#FF252540</Color>
    <Color x:Key="Fx.Control">#FF252540</Color>
    <Color x:Key="Fx.Flyout">#FF252540</Color>
    <Color x:Key="Fx.AccentSoft">#FF3A3A5E</Color>
    <!-- 20 % and 31 % white over the navy (the old window's #33FFFFFF and the mock-up's .31), written opaque. -->
    <Color x:Key="Fx.NavHover">#FF3F5D80</Color>
    <Color x:Key="Fx.NavSelected">#FF597391</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF3A3A50</Color>
    <Color x:Key="Fx.ControlEdge">#FF3A3A50</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3A3A50</Color>
    <Color x:Key="Fx.Divider">#FF3A3A50</Color>
    <Color x:Key="Fx.Focus">#FF00AAFF</Color>
    <!-- Text (11). The notes are #9A9AA8, not the old #888888 (owner decision O11): that reached 4.18 to 1 on a panel. -->
    <Color x:Key="Fx.Text">#FFFFFFFF</Color>
    <Color x:Key="Fx.TextSecondary">#FF9A9AA8</Color>
    <Color x:Key="Fx.TextDisabled">#FF6E6E80</Color>
    <Color x:Key="Fx.NavText">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFA8A8B8</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Title">#FF00AAFF</Color>
    <Color x:Key="Fx.SectionText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Link">#FF00AAFF</Color>
    <Color x:Key="Fx.ValueText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Icon">#FFFFFFFF</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FF00AAFF</Color>
    <Color x:Key="Fx.OnAccent">#FF1A1A2E</Color>
    <Color x:Key="Fx.NavMark">#FF597391</Color>
    <!-- Buttons (4): the old window's light grey buttons -->
    <Color x:Key="Fx.Button">#FFE0E0E0</Color>
    <Color x:Key="Fx.ButtonHover">#FFF0F0F0</Color>
    <Color x:Key="Fx.ButtonBorder">#FFAAAAAA</Color>
    <Color x:Key="Fx.ButtonText">#FF222222</Color>
    <!-- Check and switch (3): the white check box -->
    <Color x:Key="Fx.CheckFill">#FFFFFFFF</Color>
    <Color x:Key="Fx.CheckMark">#FF212121</Color>
    <Color x:Key="Fx.CheckBorder">#FF707070</Color>
    <!-- Slider (3): the light track and thumb -->
    <Color x:Key="Fx.Track">#FFE7EAEA</Color>
    <Color x:Key="Fx.TrackFill">#FFE7EAEA</Color>
    <Color x:Key="Fx.Thumb">#FFF0F0F0</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFFF5555</Color>
    <Color x:Key="Fx.Warning">#FFFFAA33</Color>
    <Color x:Key="Fx.InfoColor">#FF4FC3F7</Color>
    <Color x:Key="Fx.AlertBadge">#FFFF5555</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF1A1A2E</Color>
    <!-- Title bar (3): the old window's dark caption, opaque, so the look colours it (alpha 0 would be Windows' own). -->
    <Color x:Key="Fx.CaptionColor">#FF202020</Color>
    <Color x:Key="Fx.CaptionText">#FFFFFFFF</Color>
    <Color x:Key="Fx.WindowBorder">#FF4A4A5E</Color>

    <!-- Fonts (3): Segoe UI, nothing bundled -->
    <FontFamily x:Key="Fx.Font">Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Segoe UI</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">Segoe UI</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">18</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">11</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">12</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">12</sys:Double>
    <!-- Weights (4), slant (1), case (4): nothing upper-case -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Normal</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5): the group box 4, the boxes 2, the navigation and the check square -->
    <CornerRadius x:Key="Fx.Radius">4</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">2</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">2</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3) -->
    <Thickness x:Key="Fx.Line.Card">1</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">190</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">30</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">24</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,3</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">22</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,6</Thickness>
    <Thickness x:Key="Fx.Page.Padding">16</Thickness>
    <sys:Double x:Key="Fx.Label.Width">150</sys:Double>
    <!-- Presence (4): no navigation icons, no breadcrumb, a scroll bar in its own column, round window corners -->
    <Visibility x:Key="Fx.Nav.Icons">Collapsed</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">False</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Round</local:WindowCorners>
    <!-- Around (5): menus with 24 px rows, a square highlight and a tick; a round bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">24</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Tick</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Segoe UI</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <!-- The on/off control of a setting is the old window's check box, not a switch. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.BoxTick}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ The page (spec §7.1, "Sections and rows") ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (measured while
         writing plan S2: one named from the base is null when the template is made, and the binding fails, Visible). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A section is a group box: its title set into the top line, its rows inside. -->
    <DataTemplate x:Key="Fx.Section">
        <GroupBox Margin="{DynamicResource Fx.Section.Gap}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <GroupBox.Header>
                <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" Margin="0"/>
            </GroupBox.Header>
            <ContentPresenter Content="{Binding Cards}"/>
        </GroupBox>
    </DataTemplate>

    <!-- A row has no card: no surface, no edge, no hover. Hand-built editors frame themselves with it. -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
    </Style>

    <!-- A row: the label in its column (Fx.Label.Width, wider for a long label up to 420), the control after it, left;
         the note and an error under them. A search hit lights the label. -->
    <Style x:Key="Fx.CardHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" Style="{DynamicResource Fx.Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{DynamicResource Fx.Label.Width}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="420"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                            <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                       Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.AccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch is the check box before its label; the note sits under the label, 19 px in. -->
    <DataTemplate x:Key="Fx.Card.Toggle">
        <Border Style="{DynamicResource Fx.Card}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}" VerticalContentAlignment="Center"
                          HorizontalAlignment="Left">
                    <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                </CheckBox>
                <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}" Margin="19,0,0,0"/>
                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}" Margin="19,0,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.AccentBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The slider, then its value, as the old window had it. -->
    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="180" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
                <TextBlock Text="{Binding Number, StringFormat=N0}" Foreground="{DynamicResource Fx.ValueTextBrush}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- ═══ The window (spec §7.1, "Navigation", "Page header", "Shell parts") ═══ -->
    <!-- The toast's converter, found here for the same reason as Fx.BoolToVis (Task 5). -->
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>

    <!-- The layout: the navy pane (profile, search, the list, App settings docked at the bottom over Simple and All settings
         as in every look (the owner, 2026-10-17)), a 4 px
         strip in the old window's splitter colour, the page, the help column; the toast over the page. The window's code
         hands in the three live parts. Each wrapper is neither focusable nor a tab stop. -->
    <ControlTemplate x:Key="Fx.Shell" TargetType="local:ShellFrame">
        <Grid Background="{DynamicResource Fx.BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding HelpWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="{DynamicResource Fx.Nav.Width}" Background="{DynamicResource Fx.NavBrush}" Padding="4,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Margin="2,0,2,8" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Profile}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ContentControl Grid.Row="1" Margin="2,0,2,8" Focusable="False" IsTabStop="False" Content="{TemplateBinding Search}"
                                    Visibility="{Binding ShowGroups, Converter={StaticResource Fx.BoolToVis}}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding HomeCommand}"
                                    Visibility="{Binding HasHome, Converter={StaticResource Fx.BoolToVis}}">
                                <TextBlock local:Loc.Key="L.S.Nav.Home" Style="{DynamicResource Fx.Label}" Margin="14,0,0,0"
                                           FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                           Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                            </Button>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding AllSettingsCommand}"
                                    Visibility="{Binding IsSimple, Converter={StaticResource Fx.BoolToVis}}">
                                <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" Margin="14,0,0,0"
                                           FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                           Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                            </Button>
                            <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ContentControl Grid.Row="3" Content="{Binding AppGroup}" ContentTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False" IsTabStop="False"/>
                    <ContentControl Grid.Row="4" Margin="6,8,6,4" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Mode}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- The old window's splitter: a strip, not a handle (owner decision S2-10). Its colour has no token. -->
            <Border Grid.Column="1" Width="4" Background="#FF1A1A3E"/>

            <DockPanel Grid.Column="2" Margin="{DynamicResource Fx.Page.Padding}">
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Header}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.SaveError}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Status}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentPresenter Content="{TemplateBinding Page}"/>
            </DockPanel>

            <ContentControl Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                            Content="{TemplateBinding ToastText}" ContentTemplate="{DynamicResource Fx.Toast}"
                            Visibility="{Binding ToastText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fx.NotNullToVis}}"/>

            <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Help}"
                            Focusable="False" IsTabStop="False"/>
        </Grid>
    </ControlTemplate>

    <!-- The profile: "Profile:" and a box in the dropdown's look with the profile's name. It opens the profile menu
         (the profiles and their commands) under it, as Windows 11's avatar does (owner decision S2-9). -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <DockPanel>
            <TextBlock x:Name="ProfileLabel" DockPanel.Dock="Left" local:Loc.Key="L.Eve.ProfileLabel" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <!-- Its name is the profile's (as Windows 11's, which names the button from its content), labelled "Profile:". -->
            <Button AutomationProperties.Name="{Binding ProfileName}" AutomationProperties.LabeledBy="{Binding ElementName=ProfileLabel}"
                    HorizontalContentAlignment="Left" Cursor="Hand"
                    Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.ColumnSpan="2" Background="{DynamicResource Fx.ControlBrush}" BorderBrush="{DynamicResource Fx.ControlEdgeBrush}"
                                    BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Control}"/>
                            <ContentPresenter Margin="6,3,0,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{DynamicResource Fx.TextBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding ProfileName}" Foreground="{DynamicResource Fx.TextBrush}" TextTrimming="CharacterEllipsis"/>
            </Button>
        </DockPanel>
    </DataTemplate>

    <!-- Simple or All settings: two radio buttons at the bottom of the pane. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <StackPanel>
            <RadioButton IsChecked="{Binding IsSimple}" Margin="0,0,0,6" Foreground="{DynamicResource Fx.NavTextBrush}">
                <TextBlock local:Loc.Key="L.S.Shell.Simple" Style="{DynamicResource Fx.Label}" Foreground="{DynamicResource Fx.NavTextBrush}"/>
            </RadioButton>
            <RadioButton IsChecked="{Binding IsAdvanced}" Foreground="{DynamicResource Fx.NavTextBrush}">
                <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" Foreground="{DynamicResource Fx.NavTextBrush}"/>
            </RadioButton>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <!-- The page's name alone, in the accent, its description under it, and a small "?" for the help pane. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <!-- The title's own style from the tokens Fx.PageTitle reads: a look never redefines Fx.PageTitle, and a
                     style based on the base's statically is not found from a look's template (plan S1, Task 17). -->
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
                            <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
                            <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                    <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" IsChecked="{Binding HelpOpen}" Content="?" Width="28" Height="24" Padding="0"
                          VerticalAlignment="Top" Margin="16,0,0,0" ToolTip="{DynamicResource L.S.Shell.Help}" local:Loc.NameKey="L.S.Shell.Help"/>
        </Grid>
    </DataTemplate>

    <!-- A navigation entry: the old window's side-bar button, a line Fx.Nav.ItemHeight high, lighter when hovered. The
         hover shade is a layer UNDER the entry's own background, so the open page's shade (set on the button) is never
         replaced by it; keyboard focus adds an edge in the focus colour. -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Nav.ItemHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Hover" Visibility="Collapsed" Background="{DynamicResource Fx.NavHoverBrush}"
                                CornerRadius="{DynamicResource Fx.Radius.Nav}"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource Fx.Radius.Nav}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Edge" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Nav}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group: a triangle that turns down while it is open, its name; its pages under it. -->
    <DataTemplate x:Key="Fx.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="Twisty" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="None"
                          Fill="{DynamicResource Fx.NavTextBrush}" Data="M 2 0 L 7 4 L 2 8 Z"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Twisty" Property="Data" Value="M 0 2 L 8 2 L 4 7 Z"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A page of a group: indented by Fx.Nav.SubIndent, Fx.Nav.SubItemHeight high; the open page's line is lit. -->
    <DataTemplate x:Key="Fx.Nav.Page">
        <Button x:Name="Line" Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,0,8,0"
                MinHeight="{DynamicResource Fx.Nav.SubItemHeight}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="{DynamicResource Fx.Nav.SubIndent}"/>
                <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}"
                           FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                           Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Fx.NavSelectedBrush}"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
