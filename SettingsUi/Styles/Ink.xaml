<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.InkStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Ink (UI styles spec §7.12): white, black rules, one red. Source: Ink.dc.html. The 95 tokens of the contract; a value
         the mock-up does not show is derived from its palette (spec: marked *). The red is the open page's square, the
         alert badge and the critical's colour, nothing else. -->

    <!-- Surfaces (10): white; the pointed dropdown or menu item (AccentSoft) and the pointed button (ButtonHover) a light grey a step
         darker than the mock-up's #F4F4F4 so the pointer shows (LookUsabilityTests) -->
    <Color x:Key="Fx.Bg">#FFFFFFFF</Color>
    <Color x:Key="Fx.Nav">#FFFFFFFF</Color>
    <Color x:Key="Fx.CardColor">#FFFFFFFF</Color>
    <Color x:Key="Fx.CardHover">#FFF4F4F4</Color>
    <Color x:Key="Fx.Header">#FFFFFFFF</Color>
    <Color x:Key="Fx.Control">#FFFFFFFF</Color>
    <Color x:Key="Fx.Flyout">#FFFFFFFF</Color>
    <Color x:Key="Fx.AccentSoft">#FFF0F0F0</Color>
    <Color x:Key="Fx.NavHover">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavSelected">#FFFFFFFF</Color>
    <!-- Lines (5): black rules, grey hairlines between rows -->
    <Color x:Key="Fx.Border">#FF111111</Color>
    <Color x:Key="Fx.ControlEdge">#FF111111</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF111111</Color>
    <Color x:Key="Fx.Divider">#FFD4D4D4</Color>
    <Color x:Key="Fx.Focus">#FF111111</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FF111111</Color>
    <Color x:Key="Fx.TextSecondary">#FF5C5C5C</Color>
    <Color x:Key="Fx.TextDisabled">#FF767676</Color>
    <Color x:Key="Fx.NavText">#FF111111</Color>
    <Color x:Key="Fx.NavTextSecondary">#FF5C5C5C</Color>
    <Color x:Key="Fx.NavSelectedText">#FF111111</Color>
    <Color x:Key="Fx.Title">#FF111111</Color>
    <Color x:Key="Fx.SectionText">#FF111111</Color>
    <Color x:Key="Fx.Link">#FF111111</Color>
    <Color x:Key="Fx.ValueText">#FF111111</Color>
    <Color x:Key="Fx.Icon">#FF111111</Color>
    <!-- Accent (3): black; the open page's mark red -->
    <Color x:Key="Fx.Accent">#FF111111</Color>
    <Color x:Key="Fx.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavMark">#FFD8261C</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FFFFFFFF</Color>
    <Color x:Key="Fx.ButtonHover">#FFDEDEDE</Color>
    <Color x:Key="Fx.ButtonBorder">#FF111111</Color>
    <Color x:Key="Fx.ButtonText">#FF111111</Color>
    <!-- Check and switch (3): a black box with a white inset when on -->
    <Color x:Key="Fx.CheckFill">#FF111111</Color>
    <Color x:Key="Fx.CheckMark">#FFFFFFFF</Color>
    <Color x:Key="Fx.CheckBorder">#FF111111</Color>
    <!-- Slider (3) -->
    <Color x:Key="Fx.Track">#FF111111</Color>
    <Color x:Key="Fx.TrackFill">#FF111111</Color>
    <Color x:Key="Fx.Thumb">#FF111111</Color>
    <!-- Status (5): the one red for critical and the badge -->
    <Color x:Key="Fx.Critical">#FFD8261C</Color>
    <Color x:Key="Fx.Warning">#FF111111</Color>
    <Color x:Key="Fx.InfoColor">#FF5C5C5C</Color>
    <Color x:Key="Fx.AlertBadge">#FFD8261C</Color>
    <Color x:Key="Fx.OnAlertBadge">#FFFFFFFF</Color>
    <!-- Title bar (3): white with black text and edge -->
    <Color x:Key="Fx.CaptionColor">#FFFFFFFF</Color>
    <Color x:Key="Fx.CaptionText">#FF111111</Color>
    <Color x:Key="Fx.WindowBorder">#FF111111</Color>

    <!-- Fonts (3): Archivo, carried (spec §11.1), for text, titles and key labels -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Archivo/#Archivo</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">/EVE MultiPreview;component/Resources/Fonts/Archivo/#Archivo</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/Archivo/#Archivo</FontFamily>
    <!-- Sizes (8): the title a 44 px headline -->
    <sys:Double x:Key="Fx.Size.Title">44</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">15</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">14</sys:Double>
    <!-- Weights (4), slant (1), case (4): the title, the headings and the groups bold; nothing upper-case -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Bold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Normal</local:TextCase>
    <!-- Radii (5): square everywhere -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3): no card; a control's line under it only; a hairline between rows (under each, the last clipped) -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">0,0,0,1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11): the section's title takes a 190 px column (its own Fx.Section) -->
    <sys:Double x:Key="Fx.Nav.Width">232</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">26</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">18</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">40</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,4</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">26</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,8,0,12</Thickness>
    <Thickness x:Key="Fx.Page.Padding">28,14,36,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4): no icons; the group a small line over the title (Task 11's header), no breadcrumb; a floating scroll
         bar; square corners -->
    <Visibility x:Key="Fx.Nav.Icons">Collapsed</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Square</local:WindowCorners>
    <!-- Around (5): white menus with a black edge, 30 px rows, the pointed item inverted; a round (outlined) bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Invert</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Archivo</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">True</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <!-- No pane colour: a 1 px black rule between the pane and the page. -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- Help is an underlined word (the header gives it; until Task 11 the stacked header's "?"). -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Link}"/>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Inset}">
        <Setter Property="local:Kit.Size" Value="15"/>
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="15"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Line}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Underline}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Underline}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <!-- A button: outlined (a 1 px edge all round, not the controls' underline: Fx.Line.Card is 0 here). The edge and the keyboard's
         focus ring are both black, so the kit's edge-colour focus mark would show nothing: its focus is a ring 3 px out
         (Ink.Button.Template), and the pointer darkens its fill (Fx.ButtonHover). -->
    <Thickness x:Key="Ink.Line.Box">1</Thickness>
    <ControlTemplate x:Key="Ink.Button.Template" TargetType="Button">
        <Grid>
            <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Ink.Line.Box}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="BorderThickness" Value="{DynamicResource Ink.Line.Box}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Template" Value="{StaticResource Ink.Button.Template}"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the 15 px inset box at the row's right end (the base's toggle card). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Inset}">
        <Setter Property="local:Kit.Size" Value="15"/>
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <!-- Icon buttons: an outlined circle. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Ring}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <!-- A key box: outlined all round. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Ink.Line.Box}"/>
        <Setter Property="Template" Value="{StaticResource Ink.Button.Template}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template" Value="{StaticResource Ink.Button.Template}"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Ink.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A section: two columns. On the left (190 px) its number, small, over its title in bold; on the right its rows, a
         grey hairline between two (each row's line is under it, the last clipped). A 1 px black rule under the section. -->
    <DataTemplate x:Key="Fx.Section">
        <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Row}" Padding="{DynamicResource Fx.Section.Gap}"
                Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Grid>
                <!-- The title's column is 190 px while the rows have 540 px beside it, and gives way below that (English at the
                     960 px minimum: the presets' buttons, the severity table); the title wraps. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MaxWidth="190"/>
                    <ColumnDefinition Width="*" MinWidth="540"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,10,16,0">
                    <TextBlock Text="{Binding Ordinal}" FontSize="{DynamicResource Fx.Size.Caption}" Foreground="{DynamicResource Fx.TextSecondaryBrush}"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" Margin="0"/>
                </StackPanel>
                <Border Grid.Column="1" ClipToBounds="True">
                    <ContentPresenter Content="{Binding Cards}" Margin="0,0,0,-1"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A slider: the line, then its value at 20 bold, then the unit. -->
    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="260" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
                <TextBlock Text="{Binding Number, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fx.ValueTextBrush}"
                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- Simple or All settings: two words over a rule; the active one bold and underlined (Task 11 draws the words). Until
         then the kit's radio buttons. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="0,8,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <WrapPanel>
                <RadioButton IsChecked="{Binding IsSimple}" Margin="0,0,16,0">
                    <TextBlock local:Loc.Key="L.S.Shell.Simple"/>
                </RadioButton>
                <RadioButton IsChecked="{Binding IsAdvanced}">
                    <TextBlock local:Loc.Key="L.S.Nav.AllSettings"/>
                </RadioButton>
            </WrapPanel>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
