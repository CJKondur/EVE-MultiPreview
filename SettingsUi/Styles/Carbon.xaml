<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.CarbonStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Carbon (UI styles spec §7.10): black and red, racing type. Source: Carbon.dc.html. The 95 tokens of the contract; a
         value the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10) -->
    <Color x:Key="Fx.Bg">#FF121212</Color>
    <Color x:Key="Fx.Nav">#FF1A1A1A</Color>
    <Color x:Key="Fx.CardColor">#FF1A1A1A</Color>
    <Color x:Key="Fx.CardHover">#FF242424</Color>
    <Color x:Key="Fx.Header">#FF121212</Color>
    <Color x:Key="Fx.Control">#FF0B0B0B</Color>
    <Color x:Key="Fx.Flyout">#FF1A1A1A</Color>
    <Color x:Key="Fx.AccentSoft">#FF262626</Color>
    <Color x:Key="Fx.NavHover">#FF262626</Color>
    <Color x:Key="Fx.NavSelected">#FFDB261B</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF2C2C2C</Color>
    <Color x:Key="Fx.ControlEdge">#FF3A3A3A</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF3A3A3A</Color>
    <Color x:Key="Fx.Divider">#FF242424</Color>
    <Color x:Key="Fx.Focus">#FFFF5E52</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFF3F3F3</Color>
    <Color x:Key="Fx.TextSecondary">#FFADADAD</Color>
    <Color x:Key="Fx.TextDisabled">#FF777777</Color>
    <Color x:Key="Fx.NavText">#FFF3F3F3</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFADADAD</Color>
    <Color x:Key="Fx.NavSelectedText">#FFFFFFFF</Color>
    <Color x:Key="Fx.Title">#FFF3F3F3</Color>
    <Color x:Key="Fx.SectionText">#FFF3F3F3</Color>
    <Color x:Key="Fx.Link">#FFFF5E52</Color>
    <Color x:Key="Fx.ValueText">#FFFF5E52</Color>
    <Color x:Key="Fx.Icon">#FFADADAD</Color>
    <!-- Accent (3) -->
    <Color x:Key="Fx.Accent">#FFDB261B</Color>
    <Color x:Key="Fx.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Fx.NavMark">#FFDB261B</Color>
    <!-- Buttons (4) -->
    <Color x:Key="Fx.Button">#FF262626</Color>
    <Color x:Key="Fx.ButtonHover">#FF333333</Color>
    <Color x:Key="Fx.ButtonBorder">#FF262626</Color>
    <Color x:Key="Fx.ButtonText">#FFF3F3F3</Color>
    <!-- Check and switch (3) -->
    <Color x:Key="Fx.CheckFill">#FFDB261B</Color>
    <Color x:Key="Fx.CheckMark">#FFFFFFFF</Color>
    <Color x:Key="Fx.CheckBorder">#FF8E8E8E</Color>
    <!-- Slider (3): hot red -->
    <Color x:Key="Fx.Track">#FF3A3A3A</Color>
    <Color x:Key="Fx.TrackFill">#FFFF5E52</Color>
    <Color x:Key="Fx.Thumb">#FFFF5E52</Color>
    <!-- Status (5) -->
    <Color x:Key="Fx.Critical">#FFFF7A70</Color>
    <Color x:Key="Fx.Warning">#FFF2C55A</Color>
    <Color x:Key="Fx.InfoColor">#FFADADAD</Color>
    <Color x:Key="Fx.AlertBadge">#FFDB261B</Color>
    <Color x:Key="Fx.OnAlertBadge">#FFFFFFFF</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF0B0B0B</Color>
    <Color x:Key="Fx.CaptionText">#FFF3F3F3</Color>
    <Color x:Key="Fx.WindowBorder">#FF3A3A3A</Color>

    <!-- Fonts (3): Saira for text, Saira Condensed (drawn slanted) for the title, the headings and the two tabs, carried
         (spec §11.1); key labels "Cascadia Mono, Consolas" (O13) -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Saira/#Saira</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/SairaCondensed/#Saira Condensed</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">32</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">16</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">14</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">13.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">13</sys:Double>
    <!-- Weights (4), slant (1), case (4): the title and the headings bold, slanted and in capitals -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">Normal</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">SemiBold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Italic</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Normal</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Upper</local:TextCase>
    <!-- Radii (5): square everywhere -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3): no card; the box's edge; a hairline under each row -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11) -->
    <sys:Double x:Key="Fx.Nav.Width">236</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">26</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">40</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">38</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">2,4</Thickness>
    <Thickness x:Key="Fx.Row.Gap">0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">28</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,14,0,0</Thickness>
    <Thickness x:Key="Fx.Page.Padding">26,12,30,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4): square window corners -->
    <Visibility x:Key="Fx.Nav.Icons">Visible</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Visible</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">True</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Square</local:WindowCorners>
    <!-- Around (5): menus with 30 px rows, square, the checked item marked with a red bar; a square bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">30</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Bar</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Saira</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">False</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Visible</Visibility>
    <!-- A slanted "?". -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Slant}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3) ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="16"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Fill}">
        <Setter Property="local:Kit.Size" Value="16"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Round}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}"/>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The on/off control of a setting is the 16 px box before its label (Base.Card.CheckFirst). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Tick}">
        <Setter Property="local:Kit.Size" Value="16"/>
    </Style>
    <!-- Icon buttons are slanted red parallelograms with a white glyph. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Slant}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
    </Style>
    <!-- A key: hot-red edge and letters on black. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Carbon.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A section: "// " in hot red and the title, slanted, a line under them; then the rows on the page. -->
    <DataTemplate x:Key="Fx.Section">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Border BorderBrush="{DynamicResource Fx.ControlEdgeBrush}" BorderThickness="{DynamicResource Fx.Line.Row}" Padding="0,0,0,3">
                <DockPanel>
                    <local:DecorativeText DockPanel.Dock="Left" Text="// " Style="{DynamicResource Fx.SectionTitle}" Foreground="{DynamicResource Fx.LinkBrush}"
                                          FontStyle="{DynamicResource Fx.Style.Title}"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" FontStyle="{DynamicResource Fx.Style.Title}"/>
                </DockPanel>
            </Border>
            <ContentPresenter Content="{Binding Cards}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A page of a group: the open page is a red bar whose right end is cut at a slant, 14 px short of the pane's edge,
         with white semibold text. -->
    <DataTemplate x:Key="Fx.Nav.Page">
        <Grid Margin="0,0,14,0">
            <Path x:Name="Bar" Visibility="Collapsed" Stretch="Fill" Fill="{DynamicResource Fx.NavSelectedBrush}" Data="M 0,0 L 100,0 L 96,10 L 0,10 Z"/>
            <Button x:Name="Line" Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,0,10,0"
                    MinHeight="{DynamicResource Fx.Nav.SubItemHeight}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{DynamicResource Fx.Nav.SubIndent}"/>
                    <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </DockPanel>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The breadcrumb: small, in capitals, hot red. -->
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Caption}"/>
    </Style>

    <!-- The profile: a slanted red avatar with the initial, the name, "PROFILE" under it. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="6,4" MinHeight="0"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="30" Height="30">
                    <Border Background="{DynamicResource Fx.AccentBrush}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <SkewTransform AngleX="-12"/>
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock Text="{Binding ProfileInitial}" Foreground="{DynamicResource Fx.OnAccentBrush}" FontWeight="Bold"
                               FontStyle="{DynamicResource Fx.Style.Title}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}" local:Loc.Case="{DynamicResource Fx.Case.Caption}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or All settings: two slanted tabs in capitals, the picked one red; they share the pane's width and a long word
         in a translation wraps inside its tab (the pane is 216 px wide; "ALLE EINSTELLUNGEN" and "ВСЕ НАСТРОЙКИ" do not fit on a line). -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="2,6,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" GroupName="Fx.Shell.Mode" Style="{DynamicResource Kit.Segment.Slant}" IsChecked="{Binding IsSimple}" Margin="0,0,2,0">
                    <TextBlock local:Loc.Key="L.S.Shell.Simple" local:Loc.Case="{DynamicResource Fx.Case.Title}" FontStyle="{DynamicResource Fx.Style.Title}"
                               FontFamily="{DynamicResource Fx.TitleFont}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </RadioButton>
                <RadioButton Grid.Column="1" GroupName="Fx.Shell.Mode" Style="{DynamicResource Kit.Segment.Slant}" IsChecked="{Binding IsAdvanced}">
                    <TextBlock local:Loc.Key="L.S.Nav.AllSettings" local:Loc.Case="{DynamicResource Fx.Case.Title}" FontStyle="{DynamicResource Fx.Style.Title}"
                               FontFamily="{DynamicResource Fx.TitleFont}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </RadioButton>
            </Grid>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
