<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.BlueprintStyle"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- Blueprint (UI styles spec §7.9): a technical drawing on blue. Source: Blueprint.dc.html. The 95 tokens of the
         contract; a value the mock-up does not show is derived from its palette (spec: marked *). -->

    <!-- Surfaces (10): the drawing's blue; the open page white -->
    <Color x:Key="Fx.Bg">#FF143C78</Color>
    <Color x:Key="Fx.Nav">#FF143C78</Color>
    <Color x:Key="Fx.CardColor">#FF143C78</Color>
    <Color x:Key="Fx.CardHover">#FF0F3168</Color>
    <Color x:Key="Fx.Header">#FF143C78</Color>
    <Color x:Key="Fx.Control">#FF143C78</Color>
    <Color x:Key="Fx.Flyout">#FF0F3168</Color>
    <Color x:Key="Fx.AccentSoft">#FF0F3168</Color>
    <Color x:Key="Fx.NavHover">#FF143C78</Color>
    <Color x:Key="Fx.NavSelected">#FFF2F7FF</Color>
    <!-- Lines (5) -->
    <Color x:Key="Fx.Border">#FF8FB4EA</Color>
    <Color x:Key="Fx.ControlEdge">#FF8FB4EA</Color>
    <Color x:Key="Fx.FlyoutBorder">#FF8FB4EA</Color>
    <Color x:Key="Fx.Divider">#FF3E67A8</Color>
    <Color x:Key="Fx.Focus">#FFF2F7FF</Color>
    <!-- Text (11) -->
    <Color x:Key="Fx.Text">#FFF2F7FF</Color>
    <Color x:Key="Fx.TextSecondary">#FFB5CDF3</Color>
    <Color x:Key="Fx.TextDisabled">#FF8EAEE0</Color>
    <Color x:Key="Fx.NavText">#FFF2F7FF</Color>
    <Color x:Key="Fx.NavTextSecondary">#FFB5CDF3</Color>
    <Color x:Key="Fx.NavSelectedText">#FF143C78</Color>
    <Color x:Key="Fx.Title">#FFF2F7FF</Color>
    <Color x:Key="Fx.SectionText">#FFF2F7FF</Color>
    <Color x:Key="Fx.Link">#FFF2F7FF</Color>
    <Color x:Key="Fx.ValueText">#FFF2F7FF</Color>
    <Color x:Key="Fx.Icon">#FFF2F7FF</Color>
    <!-- Accent (3): white -->
    <Color x:Key="Fx.Accent">#FFF2F7FF</Color>
    <Color x:Key="Fx.OnAccent">#FF143C78</Color>
    <Color x:Key="Fx.NavMark">#FFF2F7FF</Color>
    <!-- Buttons (4): outlines on the blue -->
    <Color x:Key="Fx.Button">#FF143C78</Color>
    <Color x:Key="Fx.ButtonHover">#FF0F3168</Color>
    <Color x:Key="Fx.ButtonBorder">#FF8FB4EA</Color>
    <Color x:Key="Fx.ButtonText">#FFF2F7FF</Color>
    <!-- Check and switch (3): a white outlined box, a white cross -->
    <Color x:Key="Fx.CheckFill">#FF143C78</Color>
    <Color x:Key="Fx.CheckMark">#FFF2F7FF</Color>
    <Color x:Key="Fx.CheckBorder">#FFF2F7FF</Color>
    <!-- Slider (3): the ticks in the line colour, the base line and the thumb white -->
    <Color x:Key="Fx.Track">#FF8FB4EA</Color>
    <Color x:Key="Fx.TrackFill">#FFF2F7FF</Color>
    <Color x:Key="Fx.Thumb">#FFF2F7FF</Color>
    <!-- Status (5): white; severity is told by shape and word (Task 8) -->
    <Color x:Key="Fx.Critical">#FFF2F7FF</Color>
    <Color x:Key="Fx.Warning">#FFF2F7FF</Color>
    <Color x:Key="Fx.InfoColor">#FFB5CDF3</Color>
    <Color x:Key="Fx.AlertBadge">#FFF2F7FF</Color>
    <Color x:Key="Fx.OnAlertBadge">#FF143C78</Color>
    <!-- Title bar (3) -->
    <Color x:Key="Fx.CaptionColor">#FF0F3168</Color>
    <Color x:Key="Fx.CaptionText">#FFF2F7FF</Color>
    <Color x:Key="Fx.WindowBorder">#FF8FB4EA</Color>

    <!-- Fonts (3): Overpass for text and titles, Overpass Mono for captions, numbers and key labels, carried (spec §11.1) -->
    <FontFamily x:Key="Fx.Font">/EVE MultiPreview;component/Resources/Fonts/Overpass/#Overpass</FontFamily>
    <FontFamily x:Key="Fx.MonoFont">/EVE MultiPreview;component/Resources/Fonts/OverpassMono/#Overpass Mono</FontFamily>
    <FontFamily x:Key="Fx.TitleFont">/EVE MultiPreview;component/Resources/Fonts/Overpass/#Overpass</FontFamily>
    <!-- Sizes (8) -->
    <sys:Double x:Key="Fx.Size.Title">24</sys:Double>
    <sys:Double x:Key="Fx.Size.Section">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Body">14</sys:Double>
    <sys:Double x:Key="Fx.Size.Desc">12.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Nav">13</sys:Double>
    <sys:Double x:Key="Fx.Size.NavSub">13</sys:Double>
    <sys:Double x:Key="Fx.Size.Caption">10.5</sys:Double>
    <sys:Double x:Key="Fx.Size.Control">13</sys:Double>
    <!-- Weights (4), slant (1), case (4): the title and the headings bold, the index semibold (its pages regular), all in
         capitals -->
    <FontWeight x:Key="Fx.Weight.Title">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Section">Bold</FontWeight>
    <FontWeight x:Key="Fx.Weight.Nav">SemiBold</FontWeight>
    <FontWeight x:Key="Fx.Weight.NavSelected">Bold</FontWeight>
    <FontStyle x:Key="Fx.Style.Title">Normal</FontStyle>
    <local:TextCase x:Key="Fx.Case.Title">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Section">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Nav">Upper</local:TextCase>
    <local:TextCase x:Key="Fx.Case.Caption">Upper</local:TextCase>
    <!-- Radii (5): square everywhere -->
    <CornerRadius x:Key="Fx.Radius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Nav">0</CornerRadius>
    <CornerRadius x:Key="Fx.FlyoutRadius">0</CornerRadius>
    <CornerRadius x:Key="Fx.Radius.Check">0</CornerRadius>
    <!-- Lines (3): no card; the outline; a hairline under each row -->
    <Thickness x:Key="Fx.Line.Card">0</Thickness>
    <Thickness x:Key="Fx.Line.Control">1</Thickness>
    <Thickness x:Key="Fx.Line.Row">0,0,0,1</Thickness>
    <!-- Metrics (11): rows start 32 px in from the section's number (Fx.Row.Gap) -->
    <sys:Double x:Key="Fx.Nav.Width">236</sys:Double>
    <sys:Double x:Key="Fx.Nav.ItemHeight">28</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubItemHeight">26</sys:Double>
    <sys:Double x:Key="Fx.Nav.SubIndent">30</sys:Double>
    <sys:Double x:Key="Fx.Row.MinHeight">40</sys:Double>
    <Thickness x:Key="Fx.Row.Padding">0,3</Thickness>
    <Thickness x:Key="Fx.Row.Gap">32,0,0,0</Thickness>
    <sys:Double x:Key="Fx.Control.Height">26</sys:Double>
    <Thickness x:Key="Fx.Section.Gap">0,14,0,2</Thickness>
    <Thickness x:Key="Fx.Page.Padding">22,14,22,0</Thickness>
    <sys:Double x:Key="Fx.Label.Width">0</sys:Double>
    <!-- Presence (4): numbers instead of icons, no breadcrumb, the scroll bar in its own column, square corners -->
    <Visibility x:Key="Fx.Nav.Icons">Collapsed</Visibility>
    <Visibility x:Key="Fx.Show.Breadcrumb">Collapsed</Visibility>
    <sys:Boolean x:Key="Fx.Scroll.Overlay">False</sys:Boolean>
    <local:WindowCorners x:Key="Fx.Window.Corners">Square</local:WindowCorners>
    <!-- Around (5): menus with 28 px rows, square, the pointed item inverted; a square bell -->
    <sys:Double x:Key="Fx.Menu.RowHeight">28</sys:Double>
    <sys:Double x:Key="Fx.Menu.Radius">0</sys:Double>
    <local:MenuCheck x:Key="Fx.Menu.Check">Invert</local:MenuCheck>
    <sys:String x:Key="Fx.Menu.Font">Overpass</sys:String>
    <sys:Boolean x:Key="Fx.Hub.Round">False</sys:Boolean>

    <!-- ═══ The values the shared parts read ═══ -->
    <Visibility x:Key="Look.PaneLine">Visible</Visibility>
    <Visibility x:Key="Look.TopLine">Collapsed</Visibility>
    <!-- Its help: an outlined box with mono capitals (its own header gives the word, Task 8). -->
    <Style x:Key="Look.Help" TargetType="ToggleButton" BasedOn="{StaticResource Kit.Help.Box}">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ═══ Picks from the kit (spec §6.3): outlines; a switched-off box dashed ═══ -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Cross}">
        <Setter Property="local:Kit.Size" Value="16"/>
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Cross}">
        <Setter Property="local:Kit.Size" Value="13"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Ruler}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}">
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <!-- A text box: the outline, mono figures. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <!-- Under the pointer the edge turns the accent colour, as the kit's boxed button (Classic's) does: the hover colour
             alone is within 1.25:1 of the button's (fix round C, LookUsabilityTests). -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Round}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Kit.Scroll.Thin}"/>
    <!-- The item a dropdown or a menu points at (mouse or arrow keys): inverted, the drawing's blue on white (fix round C:
         the kit fills it with AccentSoft, which is this look's Flyout, so it could not be seen); the picked one ticked and
         semibold. High contrast's two styles, as the mock-up's inverted pointed item. -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Kit.Dropdown.Item}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock x:Name="Tick" DockPanel.Dock="Left" Width="20" Text="&#xE73E;" FontFamily="{DynamicResource Fx.IconFont}"
                                       Visibility="Hidden" VerticalAlignment="Center"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource Kit.Menu.Row}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{DynamicResource Fx.FlyoutBrush}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture"/>
                                <ColumnDefinition Width="12"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="Hidden"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.FlyoutRadius}" Padding="2">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The on/off control of a setting is the 16 px crossed box, at the row's right end (the base's toggle card). -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.Cross}">
        <Setter Property="local:Kit.Size" Value="16"/>
        <Setter Property="local:Kit.DashedOff" Value="True"/>
    </Style>
    <!-- Icon buttons: bare, a white glyph on the blue. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Icon.Box}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
    </Style>
    <!-- A key: the outline, mono. -->
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.KeyCap.Box}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Its own parts. The shared parts it takes (BaseTheme's Base.*) are named in Blueprint.xaml.cs. ═══ -->

    <!-- A binding's converter is named statically, and a template of this dictionary finds it only here (S2's measurement). -->
    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>

    <!-- A drawing's numbers and captions: mono, small, in the second text colour; a caption in capitals. Not contract names. -->
    <Style x:Key="Blueprint.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Blueprint.Caption" TargetType="TextBlock" BasedOn="{StaticResource Blueprint.Number}">
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Caption}"/>
    </Style>

    <!-- A navigation entry: a line Fx.Nav.ItemHeight high; under the mouse a thin outline 3 px inside it; keyboard focus an
         edge in the focus colour with a line of the drawing's blue 1 px inside it: the open page is filled in the focus
         colour, and only the blue line shows on it (fix round C). The open page's fill is set on the button (Fx.Nav.Page). -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.NavBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Nav.ItemHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hover" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource Fx.BorderBrush}"
                                BorderThickness="{DynamicResource Fx.Line.Control}"/>
                        <Border x:Name="Edge" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                BorderThickness="{DynamicResource Fx.Line.Control}">
                            <Border Margin="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.BgBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group: its number ("04"), its name in capitals; its pages under it while it is open. -->
    <DataTemplate x:Key="Fx.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}">
                <StackPanel Orientation="Horizontal">
                    <local:DecorativeText Text="{Binding Ordinal, StringFormat={}{0:00}}" Style="{StaticResource Blueprint.Number}" Width="30"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A page of a group: its number ("04.3"), its name in capitals, regular; the open page inverted, blue on white, bold. -->
    <DataTemplate x:Key="Fx.Nav.Page">
        <Button x:Name="Line" Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,0,10,0"
                MinHeight="{DynamicResource Fx.Nav.SubItemHeight}">
            <StackPanel Orientation="Horizontal">
                <Border Width="{DynamicResource Fx.Nav.SubIndent}"/>
                <local:DecorativeText x:Name="Number" Style="{StaticResource Blueprint.Number}" Width="40">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:00}.{1}">
                            <Binding Path="GroupOrdinal"/>
                            <Binding Path="Ordinal"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </local:DecorativeText>
                <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="Normal"
                           Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
            </StackPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Fx.NavSelectedBrush}"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A section: its number in a 22 px circle, its title in capitals, a line running to the right edge; then its rows,
         indented by Fx.Row.Gap, a hairline under each (Base.Card.OnPage). -->
    <DataTemplate x:Key="Fx.Section">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <DockPanel Margin="{DynamicResource Fx.Section.Gap}">
                <Grid DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource Fx.TextBrush}" StrokeThickness="1"/>
                    <local:DecorativeText Text="{Binding Ordinal}" FontFamily="{DynamicResource Fx.MonoFont}" FontSize="{DynamicResource Fx.Size.Caption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock DockPanel.Dock="Left" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}" Margin="0,0,10,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap"/>
                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Fx.BorderBrush}"/>
            </DockPanel>
            <ContentPresenter Content="{Binding Cards}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A slider: "0", the ruler, "100" (the slider's ends), its value in mono, the unit. -->
    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Min}" Style="{StaticResource Blueprint.Number}" Margin="0,0,8,0"/>
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="241" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
                <TextBlock Text="{Binding Max}" Style="{StaticResource Blueprint.Number}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Number, StringFormat=N0}" FontFamily="{DynamicResource Fx.MonoFont}" FontSize="{DynamicResource Fx.Size.Body}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Fx.ValueTextBrush}" MinWidth="32" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Style="{StaticResource Blueprint.Caption}" Margin="4,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- A number: centred in its outline, the unit after it in mono capitals. -->
    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="58" TextAlignment="Center" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Style="{StaticResource Blueprint.Caption}" Margin="8,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- The profile as a drawing's cell: "PROFILE" in mono capitals over the name in capitals and a chevron; it opens the
         profile menu under it. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <StackPanel Margin="4,0,4,6">
            <TextBlock x:Name="ProfileLabel" local:Loc.Key="L.S.Shell.Profile" Style="{StaticResource Blueprint.Caption}" Margin="0,0,0,3"/>
            <Button AutomationProperties.Name="{Binding ProfileName}" AutomationProperties.LabeledBy="{Binding ElementName=ProfileLabel}" Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource Fx.NavBrush}" Padding="0,2">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Fx.TextBrush}"
                                          StrokeThickness="1.5"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="Edge" Margin="-2" BorderBrush="{DynamicResource Fx.FocusBrush}" BorderThickness="{DynamicResource Fx.Line.Control}" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" Foreground="{DynamicResource Fx.NavTextBrush}" TextTrimming="CharacterEllipsis"/>
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- Simple or All settings as a drawing's cell: "SHOWING" in mono capitals over two crossed boxes in capitals. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <GroupBox local:Loc.NameKey="L.S.Shell.Advanced" Focusable="False" IsTabStop="False" Margin="4,8,4,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
            </GroupBox.Template>
            <StackPanel>
                <TextBlock local:Loc.Key="L.S.Shell.Showing" Style="{StaticResource Blueprint.Caption}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <RadioButton IsChecked="{Binding IsSimple}" Margin="0,0,16,0">
                        <TextBlock local:Loc.Key="L.S.Shell.Simple" FontSize="{DynamicResource Fx.Size.Desc}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsAdvanced}">
                        <TextBlock local:Loc.Key="L.S.Nav.AllSettings" FontSize="{DynamicResource Fx.Size.Desc}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                    </RadioButton>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <!-- The table: a drawn grid. A line around it; a line above every row (the head's against the table's own); a line on
         every cell's left (the first over the table's own line); the head row 24 high. Inside it a dropdown has no outline
         and a text box only an underline: implicit styles of the table's own, which reach its controls only. -->
    <Style x:Key="Fx.Table" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Style.Resources>
            <!-- At rest no outline (its line is the cell's colour); under the mouse and with the keyboard's focus the kit's
                 white box (fix round C). -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.Box}">
                <Setter Property="BorderBrush" Value="{DynamicResource Fx.BgBrush}"/>
                <Setter Property="local:Kit.DashedOff" Value="True"/>
            </Style>
            <!-- An underline; with the keyboard's focus a whole white box. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
                <Setter Property="local:Kit.DashedOff" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="Fx.Table.Header" TargetType="Border">
        <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style x:Key="Fx.Table.Row" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="Fx.Table.Cell" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
    </Style>
    <Style x:Key="Look.Table.HeadCell" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
    </Style>

    <!-- A severity: ▲ filled for critical, △ outlined for warning, and the word in mono capitals; info the word alone. -->
    <DataTemplate x:Key="Look.Severity">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path x:Name="Shape" Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" StrokeThickness="2"
                  Data="M 12,3 L 22,21 L 2,21 Z" Visibility="Collapsed"/>
            <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" FontFamily="{DynamicResource Fx.MonoFont}" FontSize="{DynamicResource Fx.Size.Caption}"
                       FontWeight="SemiBold" local:Loc.Case="{DynamicResource Fx.Case.Caption}" Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Shape" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Shape" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Shape" Property="Data" Value="M 12,5 L 20,20 L 4,20 Z"/>
                <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The page's header: the page's name alone in capitals; "HELP" in an outlined box at its right; the description. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource Fx.TitleFont}"/>
                            <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
                            <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                    <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}" Margin="0,2,0,0"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{DynamicResource Look.Help}" IsChecked="{Binding HelpOpen}" VerticalAlignment="Top"
                          Margin="16,2,0,0" local:Loc.NameKey="L.S.Shell.Help">
                <TextBlock local:Loc.Key="L.S.Shell.HelpShort" local:Loc.Case="{DynamicResource Fx.Case.Caption}" Margin="10,0"/>
            </ToggleButton>
        </Grid>
    </DataTemplate>

    <!-- ═══ The sheet (spec §7.9): a frame, the pane's index and cells, the title block ═══ -->
    <!-- The drawing's lines: 2 px around the sheet; 1 px on the pane's right, above the pane's cells and around the title
         block's. Keyed thicknesses, not contract names. -->
    <Thickness x:Key="Blueprint.Frame">2</Thickness>
    <Thickness x:Key="Blueprint.Right">0,0,1,0</Thickness>
    <Thickness x:Key="Blueprint.Top">0,1,0,0</Thickness>
    <Thickness x:Key="Blueprint.TopLeft">1,1,0,0</Thickness>
    <Thickness x:Key="Blueprint.Left">1,0,0,0</Thickness>
    <local:UpperCaseConverter x:Key="Blueprint.Upper"/>
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>

    <!-- A title block's value: mono, semibold, white. -->
    <Style x:Key="Blueprint.Cell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
    </Style>

    <!-- The sheet: a centre mark on each side in the 10 px between the window's edge and the frame; the frame, a 2 px white
         line; inside it the pane (the caption "SHEET INDEX", the search, the numbered list from 01 HOME with App settings in
         it, the profile and SHOWING cells at its foot), a line, the page with its title block at the bottom right, the help
         column. The window's code hands in the three live parts. -->
    <ControlTemplate x:Key="Fx.Shell" TargetType="local:ShellFrame">
        <Grid Background="{DynamicResource Fx.BgBrush}">
            <Border Width="1" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Background="{DynamicResource Fx.TextBrush}"/>
            <Border Width="1" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource Fx.TextBrush}"/>
            <Border Width="8" Height="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Background="{DynamicResource Fx.TextBrush}"/>
            <Border Width="8" Height="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Background="{DynamicResource Fx.TextBrush}"/>
            <Border x:Name="Frame" Margin="10" BorderBrush="{DynamicResource Fx.TextBrush}" BorderThickness="{StaticResource Blueprint.Frame}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding HelpWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="{DynamicResource Fx.Nav.Width}" Background="{DynamicResource Fx.NavBrush}"
                            BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{StaticResource Blueprint.Right}">
                        <!-- The search an underlined field (the outline, as the look's other text boxes, with the keyboard's focus). -->
                        <Border.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Round}">
                                <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource Fx.MonoFont}"/>
                                <Setter Property="local:Kit.DashedOff" Value="True"/>
                                <!-- Written again here: a style in a template's resources left the kit's own Background
                                     setter white (replayed while writing). -->
                                <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" local:Loc.Key="L.S.Shell.SheetIndex" Style="{StaticResource Blueprint.Caption}" Margin="14,12,14,8"/>
                            <ContentControl DockPanel.Dock="Top" Margin="14,0,14,10" Focusable="False" IsTabStop="False" Content="{TemplateBinding Search}"
                                            Visibility="{Binding ShowGroups, Converter={StaticResource Fx.BoolToVis}}"/>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{StaticResource Blueprint.Top}" Padding="10,7,10,8">
                                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Mode}" Focusable="False" IsTabStop="False"
                                                HorizontalContentAlignment="Stretch"/>
                            </Border>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{StaticResource Blueprint.Top}" Padding="10,7,10,0">
                                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Profile}" Focusable="False" IsTabStop="False"
                                                HorizontalContentAlignment="Stretch"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="2,0">
                                <StackPanel>
                                    <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding HomeCommand}"
                                            Visibility="{Binding HasHome, Converter={StaticResource Fx.BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <local:DecorativeText Text="{Binding HomeOrdinal, StringFormat={}{0:00}}" Style="{StaticResource Blueprint.Number}" Width="30"/>
                                            <TextBlock local:Loc.Key="L.S.Nav.Home" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                                       Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding AllSettingsCommand}"
                                            Visibility="{Binding IsSimple, Converter={StaticResource Fx.BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30"/>
                                            <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                                       Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False"/>
                                    <ContentControl Content="{Binding AppGroup}" ContentTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False" IsTabStop="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1" Margin="{DynamicResource Fx.Page.Padding}">
                        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Header}"
                                        Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.SaveError}"
                                        Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Status}"
                                        Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <ContentPresenter Content="{TemplateBinding Page}"/>
                    </DockPanel>

                    <ContentControl Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,72"
                                    IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                    Content="{TemplateBinding ToastText}" ContentTemplate="{DynamicResource Fx.Toast}"
                                    Visibility="{Binding ToastText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fx.NotNullToVis}}"/>

                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Help}"
                                    Focusable="False" IsTabStop="False"/>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- The title block at the page's bottom right, against the frame: PROFILE and its name · SHEET, the page's number and
         name · IN <GROUP>, its place "3 OF 5" (not on Home) · VERSION. In mono capitals (O21). -->
    <DataTemplate x:Key="Fx.Shell.Status">
        <Border HorizontalAlignment="Right" Margin="0,8,-22,0" BorderBrush="{DynamicResource Fx.TextBrush}" BorderThickness="{StaticResource Blueprint.TopLeft}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="14,6,14,7">
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{StaticResource Blueprint.Caption}"/>
                    <TextBlock Text="{Binding ProfileName, Converter={StaticResource Blueprint.Upper}}" Style="{StaticResource Blueprint.Cell}"/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource Fx.TextBrush}" BorderThickness="{StaticResource Blueprint.Left}" Padding="14,6,14,7">
                    <StackPanel>
                        <TextBlock local:Loc.Key="L.S.Shell.Sheet" Style="{StaticResource Blueprint.Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SheetNumber" Text="{Binding SheetNumber}" Style="{StaticResource Blueprint.Cell}" Margin="0,0,6,0"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Blueprint.Cell}">
                                        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Caption}"/>
                                        <Setter Property="Text" Value="{Binding Current.Page.Title, Converter={StaticResource Blueprint.Upper}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                                <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Fx.TextBrush}" BorderThickness="{StaticResource Blueprint.Left}" Padding="14,6,14,7"
                        Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding InGroupText, Converter={StaticResource Blueprint.Upper}}" Style="{StaticResource Blueprint.Number}"/>
                        <TextBlock Text="{Binding PlaceInGroup, Converter={StaticResource Blueprint.Upper}}" Style="{StaticResource Blueprint.Cell}"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Fx.TextBrush}" BorderThickness="{StaticResource Blueprint.Left}" Padding="14,6,14,7">
                    <StackPanel>
                        <TextBlock local:Loc.Key="L.S.Shell.Version" Style="{StaticResource Blueprint.Caption}"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Blueprint.Cell}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
