<Window x:Class="EveMultiPreview.SettingsUi.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveMultiPreview.SettingsUi"
        Background="{DynamicResource Fx.BgBrush}"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{DynamicResource Fx.Label}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock local:Loc.Key="L.S.Hotkey.Prompt" Style="{DynamicResource Fx.Desc}" Margin="0,8,0,0"/>
        <Border Style="{DynamicResource Fx.Card}" Margin="0,16,0,0" MinHeight="56">
            <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource Fx.MonoFont}" FontSize="20"
                       Foreground="{DynamicResource Fx.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock local:Loc.Key="L.S.Hotkey.Unusable" Foreground="{DynamicResource Fx.CriticalBrush}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="{Binding Unusable, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Visibility="{Binding HasClashes, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
            <TextBlock local:Loc.Key="L.S.Hotkey.UsedBy" Foreground="{DynamicResource Fx.WarningBrush}" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Clashes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Fx.Label}" Margin="12,2,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock local:Loc.Key="L.S.Hotkey.UsedByNote" Style="{DynamicResource Fx.Desc}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button local:Loc.Key="L.S.Hotkey.Clear" Click="OnClear" Margin="0,0,8,0" Padding="16,6"/>
            <Button local:Loc.Key="L.S.Shell.Cancel" Click="OnCancel" Margin="0,0,8,0" Padding="16,6"/>
            <Button local:Loc.Key="L.S.Shell.Ok" Click="OnOk" Padding="16,6" IsEnabled="{Binding CanAccept}"/>
        </StackPanel>
    </StackPanel>
</Window>
