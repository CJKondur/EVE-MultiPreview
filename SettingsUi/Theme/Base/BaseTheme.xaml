<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.BaseTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- The base of every look (UI styles spec §5.1): each template and style once, written against the tokens of the
         style dictionary that a window merges after it (UiStyles.Attach). It holds no token of its own. One file, so a
         template's static reference (a converter, a BasedOn) finds what it names in its own dictionary. -->

    <FontFamily x:Key="Fx.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>
    <local:ColorTextToBrushConverter x:Key="Fx.ColorBrush"/>

    <!-- ═══ Keyed controls and text ═══ -->

    <!-- The one filled button of a dialog (Next, Update now): accent with dark text (Plan 4). Hover and press dim it;
         keyboard focus keeps WPF's own focus rectangle. -->
    <Style x:Key="Fx.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain button for windows without the Fluent theme (the quick-switch wheel draws itself on a transparent
         window, which never takes Fluent's dictionary). -->
    <Style x:Key="Fx.QuietButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting card: 4 px gap below each card (spec §7). -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Fx.Radius}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fx.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
        <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock" BasedOn="{StaticResource Fx.PageTitle}">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Fx.PageDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <!-- 20 px before each section title (spec §7). -->
    <Style x:Key="Fx.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Section}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.SectionTextBrush}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Section.Gap}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Section}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- A missing description key leaves Text empty: collapse instead of leaving a blank line. -->
    <Style x:Key="Fx.Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Literal text of an editor (a character or group name, a system, a read-out): never translated (EditorCard.Value).
         In the text colour; the colour token Fx.ValueText colours a slider card's number (plan S1, ruling 15). -->
    <Style x:Key="Fx.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.ValueSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- A name chip ("Logi ✕", EditorCard.Chip). -->
    <Style x:Key="Fx.Chip" TargetType="Border">
        <Setter Property="Padding" Value="10,4,4,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
    </Style>

    <!-- ═══ The page: cards, info lines, editors, sections ═══ -->

    <!-- Toggle switch with On/Off text (spec §6). Motion: none beyond the instant state change. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" local:Loc.Key="L.S.Off" Foreground="{DynamicResource Fx.TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="{DynamicResource Fx.Line.Control}"
                                BorderBrush="{DynamicResource Fx.CheckBorderBrush}" Background="Transparent">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Fx.CheckBorderBrush}"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="local:Loc.Key" Value="L.S.On"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card frame: label, description and error on the left; the control (Content) on the right. -->
    <Style x:Key="Fx.CardHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" Style="{DynamicResource Fx.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="{DynamicResource Fx.Label.Width}">
                                <TextBlock local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                                <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Option text: Literal when set (language names, percentages), else the LabelKey resource. -->
    <DataTemplate x:Key="Fx.OptionText">
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding Literal}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Literal}" Value="{x:Null}">
                            <Setter Property="local:Loc.Key" Value="{Binding LabelKey}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Toggle">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <CheckBox Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Choice">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ComboBox MinWidth="200" local:Loc.NameKey="{Binding LabelKey}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                      ItemTemplate="{DynamicResource Fx.OptionText}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Segmented">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ListBox local:Loc.NameKey="{Binding LabelKey}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                     ItemTemplate="{DynamicResource Fx.OptionText}" BorderThickness="{DynamicResource Fx.Line.Control}"
                     BorderBrush="{DynamicResource Fx.BorderBrush}" Background="{DynamicResource Fx.ControlBrush}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Number, StringFormat=N0}" Foreground="{DynamicResource Fx.ValueTextBrush}"
                           VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="200" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="80" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Text">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Folder">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <Button local:Loc.Key="L.S.Shell.Browse" Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.File">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <Button local:Loc.Key="L.S.Shell.Browse" Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Color">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Button local:Loc.NameKey="{Binding LabelKey}" Command="{Binding PickColorCommand}" Width="32" Height="32" Padding="0" Margin="0,0,8,0">
                    <Border Width="22" Height="22" CornerRadius="{DynamicResource Fx.Radius.Control}" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                            Background="{Binding Text, Converter={StaticResource Fx.ColorBrush}}"/>
                </Button>
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="96" FontFamily="{DynamicResource Fx.MonoFont}"
                         Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Hotkey">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Button local:Loc.NameKey="{Binding LabelKey}" AutomationProperties.HelpText="{Binding HotkeyDisplay}"
                        Command="{Binding CaptureHotkeyCommand}" MinWidth="120" Padding="12,4">
                    <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{DynamicResource Fx.MonoFont}"/>
                </Button>
                <Button local:Loc.Key="L.S.Hotkey.Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="12,4"
                        Visibility="{Binding HasValue, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Actions">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}" Margin="8,0,0,0" Padding="12,4">
                            <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}"/>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </DataTemplate>

    <!-- Info line: a coloured bar, a severity glyph and the text. The glyph's shape and its screen-reader name say the
         severity, so colour never stands alone (spec §7). Search outlines the line it lands on (spec §6). -->
    <DataTemplate x:Key="Fx.Info">
        <Grid Margin="0,0,0,4" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Border x:Name="Bar" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Fx.InfoBrush}"
                    Background="{DynamicResource Fx.CardBrush}" CornerRadius="{DynamicResource Fx.Radius}" Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{DynamicResource Fx.IconFont}"
                               Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Top" Margin="0,3,10,0"
                               local:Loc.NameKey="L.S.Info.Note"/>
                    <TextBlock Text="{Binding Text}" Style="{DynamicResource Fx.Label}"/>
                </DockPanel>
            </Border>
            <Border x:Name="Highlight" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}"
                    CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Glyph" Property="local:Loc.NameKey" Value="L.S.Info.Warning"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Glyph" Property="local:Loc.NameKey" Value="L.S.Info.Error"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Highlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A hand-built editor. Its own card keeps the 4 px gap below it (Fx.Card), so the search outline stops above it. -->
    <DataTemplate x:Key="Fx.Editor">
        <Grid Margin="0,0,0,4" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <ContentPresenter Content="{Binding Element}"/>
            <Border x:Name="Highlight" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}" Margin="0,0,0,4"
                    CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Highlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Section">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            <local:CardList ItemsSource="{Binding Items}" Focusable="False"/>
        </StackPanel>
    </DataTemplate>

    <!-- The frame around a dialog's content (Fx.Dialog). In Windows 11 the window's own background is the frame: it draws
         nothing. -->
    <Style x:Key="Fx.Dialog" TargetType="Border"/>

    <!-- ═══ Tables of the hand-built editors (EditorTable) ═══ -->

    <!-- The table, a row and the header row behind their cells, and a cell. In Windows 11 none draws anything: a look
         with lines, a header bar or a grid overrides them. -->
    <Style x:Key="Fx.Table" TargetType="Border"/>
    <Style x:Key="Fx.Table.Header" TargetType="Border"/>
    <Style x:Key="Fx.Table.Row" TargetType="Border"/>
    <Style x:Key="Fx.Table.Cell" TargetType="Border"/>

    <!-- A column's heading. In Windows 11 what EditorCard.Note(key, strong: true) drew: the description's size and colour,
         semibold. -->
    <Style x:Key="Fx.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Caption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══ Navigation ═══ -->

    <!-- Navigation entry: icon + text, accent bar when current. -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- A navigation group: its header, and its pages (Fx.Nav.Page) while it is expanded. Used by the scrolling list and
         by App settings at the bottom left. -->
    <DataTemplate x:Key="Fx.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A page of a navigation group: indented by Fx.Nav.SubIndent, the open page marked by a bar in Fx.NavMark. -->
    <DataTemplate x:Key="Fx.Nav.Page">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,6,12,6">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="{DynamicResource Fx.Nav.SubIndent}"/>
                <Grid>
                    <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                            Margin="-14,0,0,0" Background="{DynamicResource Fx.NavMarkBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}"
                               FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </Grid>
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══ The settings window (UI styles spec §8.1) ═══ -->

    <!-- The layout: navigation on the left, the page in the middle, the help pane on the right; the toast over the page.
         The window's code hands in the three live parts (ShellFrame.Search, .Page, .Help); every other part is a data
         template over the window's view model. Each wrapper is neither focusable nor a tab stop, so the keyboard path is
         the parts' own. In Windows 11 this is the layout SettingsShell.xaml held before plan S1. -->
    <ControlTemplate x:Key="Fx.Shell" TargetType="local:ShellFrame">
        <Grid Background="{DynamicResource Fx.BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding HelpWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid.ColumnDefinitions>

            <!-- No fill of its own in Windows 11 (plan S1, ruling 11): the window's shows through. -->
            <Border Grid.Column="0" Width="{DynamicResource Fx.Nav.Width}">
                <DockPanel Margin="8,8,4,8">
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Profile}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <ContentControl DockPanel.Dock="Top" Margin="0,8,0,8" Focusable="False" IsTabStop="False"
                                    Content="{TemplateBinding Search}"
                                    Visibility="{Binding ShowGroups, Converter={StaticResource Fx.BoolToVis}}"/>

                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Mode}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <!-- App settings: apart at the bottom left, just above the switch, in both modes (owner, 2026-10-09). -->
                    <ContentControl DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False"
                                    Content="{Binding AppGroup}" ContentTemplate="{DynamicResource Fx.Nav.Group}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding HomeCommand}"
                                    Visibility="{Binding HasHome, Converter={StaticResource Fx.BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.Home" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding AllSettingsCommand}"
                                    Visibility="{Binding IsSimple, Converter={StaticResource Fx.BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom of the padding: a strip of window below the scrolling area, so the settings don't run into the
                 window's edge. -->
            <DockPanel Grid.Column="1" Margin="{DynamicResource Fx.Page.Padding}">
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Header}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.SaveError}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Status}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentPresenter Content="{TemplateBinding Page}"/>
            </DockPanel>

            <!-- Toast: inside the window, never a separate window, never takes focus (spec §4). -->
            <ContentControl Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                            Content="{TemplateBinding ToastText}" ContentTemplate="{DynamicResource Fx.Toast}"
                            Visibility="{Binding ToastText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fx.NotNullToVis}}"/>

            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Help}"
                            Focusable="False" IsTabStop="False"/>
        </Grid>
    </ControlTemplate>

    <!-- The profile: its initial in a circle, its name; the frame's command opens the profile menu under it. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Fx.AccentBrush}">
                    <TextBlock Text="{Binding ProfileInitial}" Foreground="#FF000000" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or Advanced: the switch at the bottom left. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <Border Padding="12,8" Margin="0,8,0,0">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsAdvanced}"/>
                <TextBlock local:Loc.Key="L.S.Shell.Advanced" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- The page's header: the breadcrumb (its group goes back to the group's page), the title, the description, and
         the help pane's button. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel>
                    <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="0" Margin="0"
                            Command="{Binding BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                            Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                        <TextBlock local:Loc.Key="{Binding GroupTitleKey}" Style="{DynamicResource Fx.Breadcrumb}"/>
                    </Button>
                    <TextBlock Text="  ›  " Style="{DynamicResource Fx.Breadcrumb}"
                               Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}"/>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Fx.PageTitle}">
                                <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                        <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
                <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" IsChecked="{Binding HelpOpen}" Content="?" FontWeight="SemiBold"
                          Width="36" Height="36" VerticalAlignment="Top" Margin="16,4,0,0"
                          ToolTip="{DynamicResource L.S.Shell.Help}"/>
        </Grid>
    </DataTemplate>

    <!-- The help pane: the frame's live pane, as it is. -->
    <DataTemplate x:Key="Fx.Shell.Help">
        <ContentPresenter Content="{Binding Help, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"/>
    </DataTemplate>

    <!-- The status strip under the page: nothing in Windows 11. -->
    <DataTemplate x:Key="Fx.Shell.Status">
        <Grid/>
    </DataTemplate>

    <!-- The toast's text, in a card. -->
    <DataTemplate x:Key="Fx.Toast">
        <Border Padding="16,10" CornerRadius="{DynamicResource Fx.Radius}" BorderThickness="{DynamicResource Fx.Line.Card}"
                BorderBrush="{DynamicResource Fx.BorderBrush}" Background="{DynamicResource Fx.CardBrush}">
            <TextBlock Text="{Binding}" Style="{DynamicResource Fx.Label}" MaxWidth="420"/>
        </Border>
    </DataTemplate>

    <!-- Save error bar (spec §8.5): stays until a save succeeds. -->
    <DataTemplate x:Key="Fx.SaveError">
        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="{DynamicResource Fx.Radius}"
                BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Fx.CriticalBrush}" Background="{DynamicResource Fx.CardBrush}"
                Visibility="{Binding HasSaveError, Converter={StaticResource Fx.BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" local:Loc.Key="L.S.Shell.Retry" Padding="12,4" Margin="12,0,0,0"
                        Command="{Binding RetrySaveCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                        Visibility="{Binding CanRetrySave, Converter={StaticResource Fx.BoolToVis}}"/>
                <TextBlock local:Loc.Key="{Binding SaveErrorKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
