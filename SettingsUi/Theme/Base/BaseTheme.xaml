<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.BaseTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- The base of every look (UI styles spec §5.1): each template and style once, written against the tokens of the
         style dictionary that a window merges after it (UiStyles.Attach). It holds no token of its own. One file, so a
         template's static reference (a converter, a BasedOn) finds what it names in its own dictionary. -->

    <FontFamily x:Key="Fx.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="Fx.BoolToVis"/>
    <local:NotNullToVisibilityConverter x:Key="Fx.NotNullToVis"/>
    <local:ColorTextToBrushConverter x:Key="Fx.ColorBrush"/>

    <!-- ═══ Keyed controls and text ═══ -->

    <!-- The one filled button of a dialog (Next, Update now): accent with dark text (Plan 4). Hover and press dim it;
         keyboard focus keeps WPF's own focus rectangle. -->
    <Style x:Key="Fx.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain button for windows without the Fluent theme (the quick-switch wheel draws itself on a transparent
         window, which never takes Fluent's dictionary). -->
    <Style x:Key="Fx.QuietButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting card: 4 px gap below each card (spec §7). -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Fx.Radius}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fx.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.TitleFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
        <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock" BasedOn="{StaticResource Fx.PageTitle}">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Fx.PageDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <!-- 20 px before each section title (spec §7). -->
    <Style x:Key="Fx.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Fx.TitleFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Section}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.SectionTextBrush}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Section.Gap}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Section}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- A missing description key leaves Text empty: collapse instead of leaving a blank line. -->
    <Style x:Key="Fx.Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Literal text of an editor (a character or group name, a system, a read-out): never translated (EditorCard.Value).
         In the text colour; the colour token Fx.ValueText colours a slider card's number (plan S1, ruling 15). -->
    <Style x:Key="Fx.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.ValueSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- A name chip ("Logi ✕", EditorCard.Chip). -->
    <Style x:Key="Fx.Chip" TargetType="Border">
        <Setter Property="Padding" Value="10,4,4,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
    </Style>

    <!-- ═══ The page: cards, info lines, editors, sections ═══ -->

    <!-- Toggle switch with On/Off text (spec §6). Motion: none beyond the instant state change. -->
    <Style x:Key="Fx.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" local:Loc.Key="L.S.Off" Foreground="{DynamicResource Fx.TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="{DynamicResource Fx.Line.Control}"
                                BorderBrush="{DynamicResource Fx.CheckBorderBrush}" Background="Transparent">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Fx.CheckBorderBrush}"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="local:Loc.Key" Value="L.S.On"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card frame: label, description and error on the left; the control (Content) on the right. -->
    <Style x:Key="Fx.CardHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" Style="{DynamicResource Fx.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="{DynamicResource Fx.Label.Width}">
                                <TextBlock local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                                <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Option text: Literal when set (language names, percentages), else the LabelKey resource. -->
    <DataTemplate x:Key="Fx.OptionText">
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding Literal}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Literal}" Value="{x:Null}">
                            <Setter Property="local:Loc.Key" Value="{Binding LabelKey}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Toggle">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <CheckBox Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Choice">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ComboBox MinWidth="200" local:Loc.NameKey="{Binding LabelKey}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                      ItemTemplate="{DynamicResource Fx.OptionText}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Segmented">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ListBox local:Loc.NameKey="{Binding LabelKey}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                     ItemTemplate="{DynamicResource Fx.OptionText}" BorderThickness="{DynamicResource Fx.Line.Control}"
                     BorderBrush="{DynamicResource Fx.BorderBrush}" Background="{DynamicResource Fx.ControlBrush}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Slider">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Number, StringFormat=N0}" Foreground="{DynamicResource Fx.ValueTextBrush}"
                           VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="200" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Number">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="80" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Text">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Folder">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <Button local:Loc.Key="L.S.Shell.Browse" Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.File">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="240" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
                <Button local:Loc.Key="L.S.Shell.Browse" Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Color">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Button local:Loc.NameKey="{Binding LabelKey}" Command="{Binding PickColorCommand}" Width="32" Height="32" Padding="0" Margin="0,0,8,0">
                    <Border Width="22" Height="22" CornerRadius="{DynamicResource Fx.Radius.Control}" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.BorderBrush}"
                            Background="{Binding Text, Converter={StaticResource Fx.ColorBrush}}"/>
                </Button>
                <TextBox local:Loc.NameKey="{Binding LabelKey}" MinWidth="96" FontFamily="{DynamicResource Fx.MonoFont}"
                         Text="{Binding Text, UpdateSourceTrigger=LostFocus}" local:CommitOnEnter.Enabled="True"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Card.Hotkey">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Button local:Loc.NameKey="{Binding LabelKey}" AutomationProperties.HelpText="{Binding HotkeyDisplay}"
                        Command="{Binding CaptureHotkeyCommand}" MinWidth="120" Padding="12,4">
                    <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{DynamicResource Fx.MonoFont}"/>
                </Button>
                <Button local:Loc.Key="L.S.Hotkey.Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="12,4"
                        Visibility="{Binding HasValue, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- One action button of a row (plan S5): a look that draws a destructive button its own way redefines this part only,
         never the card (Neon does: owner's decision of 2026-10-17). A destructive action's label is in the critical colour. -->
    <DataTemplate x:Key="Look.Action">
        <Button Command="{Binding Command}" Margin="8,0,0,0" Padding="12,4">
            <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}"/>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="Fx.Card.Actions">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <ItemsControl ItemsSource="{Binding Buttons}" ItemTemplate="{DynamicResource Look.Action}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ContentControl>
    </DataTemplate>

    <!-- Info line: a coloured bar, a severity glyph and the text. The glyph's shape and its screen-reader name say the
         severity, so colour never stands alone (spec §7). Search outlines the line it lands on (spec §6). -->
    <DataTemplate x:Key="Fx.Info">
        <Grid Margin="0,0,0,4" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Border x:Name="Bar" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Fx.InfoBrush}"
                    Background="{DynamicResource Fx.CardBrush}" CornerRadius="{DynamicResource Fx.Radius}" Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{DynamicResource Fx.IconFont}"
                               Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Top" Margin="0,3,10,0"
                               local:Loc.NameKey="L.S.Info.Note"/>
                    <TextBlock Text="{Binding Text}" Style="{DynamicResource Fx.Label}"/>
                </DockPanel>
            </Border>
            <Border x:Name="Highlight" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}"
                    CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
                <Setter TargetName="Glyph" Property="local:Loc.NameKey" Value="L.S.Info.Warning"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
                <Setter TargetName="Glyph" Property="local:Loc.NameKey" Value="L.S.Info.Error"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Highlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A hand-built editor. Its own card keeps the 4 px gap below it (Fx.Card), so the search outline stops above it. -->
    <DataTemplate x:Key="Fx.Editor">
        <Grid Margin="0,0,0,4" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <ContentPresenter Content="{Binding Element}"/>
            <Border x:Name="Highlight" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}" Margin="0,0,0,4"
                    CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Highlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Fx.Section">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            <ContentPresenter Content="{Binding Cards}"/>
        </StackPanel>
    </DataTemplate>

    <!-- The frame around a dialog's content (Fx.Dialog). In Windows 11 the window's own background is the frame: it draws
         nothing. -->
    <Style x:Key="Fx.Dialog" TargetType="Border"/>

    <!-- ═══ Tables of the hand-built editors (EditorTable) ═══ -->

    <!-- The table, a row and the header row behind their cells, and a cell. In Windows 11 none draws anything: a look
         with lines, a header bar or a grid overrides them. -->
    <Style x:Key="Fx.Table" TargetType="Border"/>
    <Style x:Key="Fx.Table.Header" TargetType="Border"/>
    <Style x:Key="Fx.Table.Row" TargetType="Border"/>
    <Style x:Key="Fx.Table.Cell" TargetType="Border"/>

    <!-- A column's heading. In Windows 11 what EditorCard.Note(key, strong: true) drew: the description's size and colour,
         semibold. -->
    <Style x:Key="Fx.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Caption}"/>
        <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Caption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══ Navigation ═══ -->

    <!-- Navigation entry: icon + text, accent bar when current. -->
    <Style x:Key="Fx.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- A navigation group: its header, and its pages (Fx.Nav.Page) while it is expanded. Used by the scrolling list and
         by App settings at the bottom left. -->
    <DataTemplate x:Key="Fx.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A page of a navigation group: indented by Fx.Nav.SubIndent, the open page marked by a bar in Fx.NavMark. -->
    <DataTemplate x:Key="Fx.Nav.Page">
        <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,6,12,6">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="{DynamicResource Fx.Nav.SubIndent}"/>
                <Grid>
                    <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                            Margin="-14,0,0,0" Background="{DynamicResource Fx.NavMarkBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}"
                               FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </Grid>
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══ The settings window (UI styles spec §8.1) ═══ -->

    <!-- The layout: navigation on the left, the page in the middle, the help pane on the right; the toast over the page.
         The window's code hands in the three live parts (ShellFrame.Search, .Page, .Help); every other part is a data
         template over the window's view model. Each wrapper is neither focusable nor a tab stop, so the keyboard path is
         the parts' own. In Windows 11 this is the layout SettingsShell.xaml held before plan S1. -->
    <ControlTemplate x:Key="Fx.Shell" TargetType="local:ShellFrame">
        <Grid Background="{DynamicResource Fx.BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding HelpWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid.ColumnDefinitions>

            <!-- No fill of its own in Windows 11 (plan S1, ruling 11): the window's shows through. -->
            <Border Grid.Column="0" Width="{DynamicResource Fx.Nav.Width}">
                <DockPanel Margin="8,8,4,8">
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Profile}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <ContentControl DockPanel.Dock="Top" Margin="0,8,0,8" Focusable="False" IsTabStop="False"
                                    Content="{TemplateBinding Search}"
                                    Visibility="{Binding ShowGroups, Converter={StaticResource Fx.BoolToVis}}"/>

                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Mode}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <!-- App settings: apart at the bottom left, just above the switch, in both modes (owner, 2026-10-09). -->
                    <ContentControl DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False"
                                    Content="{Binding AppGroup}" ContentTemplate="{DynamicResource Fx.Nav.Group}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding HomeCommand}"
                                    Visibility="{Binding HasHome, Converter={StaticResource Fx.BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.Home" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding AllSettingsCommand}"
                                    Visibility="{Binding IsSimple, Converter={StaticResource Fx.BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" Margin="12,0,0,0"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom of the padding: a strip of window below the scrolling area, so the settings don't run into the
                 window's edge. -->
            <DockPanel Grid.Column="1" Margin="{DynamicResource Fx.Page.Padding}">
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Header}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.SaveError}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Status}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentPresenter Content="{TemplateBinding Page}"/>
            </DockPanel>

            <!-- Toast: inside the window, never a separate window, never takes focus (spec §4). -->
            <ContentControl Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                            Content="{TemplateBinding ToastText}" ContentTemplate="{DynamicResource Fx.Toast}"
                            Visibility="{Binding ToastText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fx.NotNullToVis}}"/>

            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Help}"
                            Focusable="False" IsTabStop="False"/>
        </Grid>
    </ControlTemplate>

    <!-- The profile: its initial in a circle, its name; the frame's command opens the profile menu under it. -->
    <DataTemplate x:Key="Fx.Shell.Profile">
        <Button Style="{DynamicResource Fx.Nav.Entry}"
                Command="{Binding ProfileMenuCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Fx.AccentBrush}">
                    <TextBlock Text="{Binding ProfileInitial}" Foreground="#FF000000" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" Style="{DynamicResource Fx.Label}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fx.NavTextBrush}"/>
                    <TextBlock local:Loc.Key="L.S.Shell.Profile" Style="{DynamicResource Fx.Desc}"
                               Foreground="{DynamicResource Fx.NavTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Simple or Advanced: the switch at the bottom left. -->
    <DataTemplate x:Key="Fx.Shell.Mode">
        <Border Padding="12,8" Margin="0,8,0,0">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsAdvanced}"/>
                <TextBlock local:Loc.Key="L.S.Shell.Advanced" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- The page's header: the breadcrumb (its group goes back to the group's page), the title, the description, and
         the help pane's button. -->
    <DataTemplate x:Key="Fx.Shell.Header">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{DynamicResource Fx.Show.Breadcrumb}">
                        <Button Style="{DynamicResource Fx.Nav.Entry}" Padding="0" Margin="0"
                                Command="{Binding BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                                Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                            <TextBlock local:Loc.Key="{Binding GroupTitleKey}" Style="{DynamicResource Fx.Breadcrumb}"/>
                        </Button>
                        <TextBlock Text="  ›  " Style="{DynamicResource Fx.Breadcrumb}"
                                   Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}"/>
                    </StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Fx.PageTitle}">
                                <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                        <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
                <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" IsChecked="{Binding HelpOpen}" Content="?" FontWeight="SemiBold"
                          Width="36" Height="36" VerticalAlignment="Top" Margin="16,4,0,0"
                          ToolTip="{DynamicResource L.S.Shell.Help}"/>
        </Grid>
    </DataTemplate>

    <!-- The help pane: the frame's live pane, as it is. -->
    <DataTemplate x:Key="Fx.Shell.Help">
        <ContentPresenter Content="{Binding Help, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"/>
    </DataTemplate>

    <!-- The status strip under the page: nothing in Windows 11. -->
    <DataTemplate x:Key="Fx.Shell.Status">
        <Grid/>
    </DataTemplate>

    <!-- The toast's text, in a card. -->
    <DataTemplate x:Key="Fx.Toast">
        <Border Padding="16,10" CornerRadius="{DynamicResource Fx.Radius}" BorderThickness="{DynamicResource Fx.Line.Card}"
                BorderBrush="{DynamicResource Fx.BorderBrush}" Background="{DynamicResource Fx.CardBrush}">
            <TextBlock Text="{Binding}" Style="{DynamicResource Fx.Label}" MaxWidth="420"/>
        </Border>
    </DataTemplate>

    <!-- Save error bar (spec §8.5): stays until a save succeeds. -->
    <DataTemplate x:Key="Fx.SaveError">
        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="{DynamicResource Fx.Radius}"
                BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Fx.CriticalBrush}" Background="{DynamicResource Fx.CardBrush}"
                Visibility="{Binding HasSaveError, Converter={StaticResource Fx.BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" local:Loc.Key="L.S.Shell.Retry" Padding="12,4" Margin="12,0,0,0"
                        Command="{Binding RetrySaveCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}"
                        Visibility="{Binding CanRetrySave, Converter={StaticResource Fx.BoolToVis}}"/>
                <TextBlock local:Loc.Key="{Binding SaveErrorKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ═══ The look gallery (UI styles spec §9.2) ═══ -->

    <!-- A look's miniature: the look's own templates over a LookSample, on a gallery card's subtree in that look
         (UiStyles.Scope), scaled down into its card's preview box. Look.Preview.Width wide, 420 here: at 320 Windows 11's slider card had no room left for its label (measured); a look whose slider row is wider sets
         its own (Blueprint). Two navigation entries (the open one first), a section heading, a setting with
         its on/off control, a slider, a dropdown, a number box and a button. Inert (PreviewHost). -->
    <sys:Double x:Key="Look.Preview.Width">420</sys:Double>
    <DataTemplate x:Key="Fx.Preview">
        <StackPanel Width="{DynamicResource Look.Preview.Width}" Background="{DynamicResource Fx.BgBrush}">
            <Border Background="{DynamicResource Fx.NavBrush}" Padding="4">
                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{DynamicResource Fx.Nav.Page}" Focusable="False"/>
            </Border>
            <StackPanel Margin="10,0,10,10">
                <TextBlock local:Loc.Key="{Binding SectionTitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
                <ContentPresenter Content="{Binding Toggle}" ContentTemplate="{DynamicResource Fx.Card.Toggle}"/>
                <ContentPresenter Content="{Binding Slider}" ContentTemplate="{DynamicResource Fx.Card.Slider}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox MinWidth="130" ItemsSource="{Binding Choice.Options}" SelectedItem="{Binding Choice.Selected}"
                              ItemTemplate="{DynamicResource Fx.OptionText}"/>
                    <TextBox Width="44" Margin="8,0,0,0" Text="{Binding Number.Text, Mode=OneWay}"/>
                    <Button local:Loc.Key="L.S.Shell.Browse" Margin="8,0,0,0" Padding="10,2"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A card of the gallery: a radio button of the group "Look", drawn in the window's own look (what it holds shows its
         look). The current look's card has three cues, none of them colour alone: an accent outline (two lines), a check
         mark and the word Current. Not a contract name: the page's own part, the same in every look. -->
    <Style x:Key="Look.Card" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- The card draws its own focus (the border below): no dashed Windows box over it. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius}" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter/>
                                <StackPanel x:Name="Current" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Hidden">
                                    <!-- In the link colour: text on the card (Carbon's accent on its card reaches only 3.57 to 1;
                                         the link colour is the accent's in Windows 11 and Classic). -->
                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Fx.IconFont}" Foreground="{DynamicResource Fx.LinkBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock local:Loc.Key="L.S.Look.Current" Style="{DynamicResource Fx.Label}" Foreground="{DynamicResource Fx.LinkBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Outline" Margin="1" BorderThickness="{DynamicResource Fx.Line.Card}" BorderBrush="{DynamicResource Fx.AccentBrush}"
                                CornerRadius="{DynamicResource Fx.Radius}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- The keyboard's focus: a ring in the focus colour 3 px inside the card (fix round C). The border's
                             colour alone showed nothing on a card without a border (the flat looks' Fx.Line.Card is 0) nor on the
                             picked card where the focus colour is the accent's. -->
                        <Border x:Name="FocusRing" Margin="3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                CornerRadius="{DynamicResource Fx.Radius}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter TargetName="Outline" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Current" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A focus visual (WPF's focus adorner) for a control built in code whose look draws its focus on a border it does not
         have (a chip's ✕, EditorCard.Chip): a ring in the focus colour 2 px around it (fix round C). -->
    <Style x:Key="Base.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                            CornerRadius="{DynamicResource Fx.Radius.Control}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ The parts the flat looks share (plan S3: Daylight, Dusk, Compact, Neon, Carbon). Keyed Base.*: Windows 11 and
         Classic never name them. A look's code puts one under the contract's key (UiStyles.ReadLook; an alias in XAML,
         a StaticResource element, is read under the wrong key by WPF: measured). Each reads tokens, and three values every
         flat look defines: Look.Help (the "?"'s style), Look.PaneLine and Look.TopLine (Visibility). ═══ -->

    <local:NullToVisibilityConverter x:Key="Base.NullToVis"/>

    <!-- A row in a section's card: on the card's colour, Fx.Line.Row under it in Fx.Divider, the hover colour under the
         mouse. The card hides the last row's line (Base.Section.InCard). -->
    <Style x:Key="Base.Card.InCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
        <Setter Property="Padding" Value="{DynamicResource Fx.Row.Padding}"/>
        <Setter Property="Margin" Value="{DynamicResource Fx.Row.Gap}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A row straight on the page: the same, on the page's colour. -->
    <Style x:Key="Base.Card.OnPage" TargetType="Border" BasedOn="{StaticResource Base.Card.InCard}">
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
    </Style>

    <!-- A section as one card (Daylight, Dusk): its heading, then all its rows in one card with the card's corner and edge.
         Each row's line is drawn under it; the card's last pixel line is clipped, so a line runs only between two rows. -->
    <DataTemplate x:Key="Base.Section.InCard">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            <Grid>
                <Border Background="{DynamicResource Fx.CardBrush}" CornerRadius="{DynamicResource Fx.Radius}"/>
                <Border Padding="14,0">
                    <Border ClipToBounds="True">
                        <ContentPresenter Content="{Binding Cards}" Margin="0,0,0,-1"/>
                    </Border>
                </Border>
                <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Card}"
                        CornerRadius="{DynamicResource Fx.Radius}" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- A section straight on the page (Compact): its heading, then its rows. -->
    <DataTemplate x:Key="Base.Section.OnPage">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            <ContentPresenter Content="{Binding Cards}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A section with a rule under its heading (Neon): Fx.Line.Row in the card line's colour, then the rows. -->
    <DataTemplate x:Key="Base.Section.Ruled">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Border BorderBrush="{DynamicResource Fx.BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Row}" Padding="0,0,0,6">
                <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.SectionTitle}"/>
            </Border>
            <ContentPresenter Content="{Binding Cards}"/>
        </StackPanel>
    </DataTemplate>

    <!-- An on/off setting with its check before the label (Daylight, Dusk, Compact, Carbon): the check box holds the label
         and the note, so a click on either switches it; the error under it. A search hit lights the label. -->
    <DataTemplate x:Key="Base.Card.CheckFirst">
        <Border Style="{DynamicResource Fx.Card}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <StackPanel VerticalAlignment="Center">
                <CheckBox Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}"
                          HorizontalAlignment="Left" VerticalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                        <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                    </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A slider setting as the flat mock-ups draw it: the slider, then its value in the value colour, then the unit. -->
    <DataTemplate x:Key="Base.Card.SliderThenValue">
        <ContentControl Style="{DynamicResource Fx.CardHost}">
            <StackPanel Orientation="Horizontal">
                <Slider local:Loc.NameKey="{Binding LabelKey}" Width="220" VerticalAlignment="Center" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True" Value="{Binding Number, Delay=150}"/>
                <TextBlock Text="{Binding Number, StringFormat=N0}" Foreground="{DynamicResource Fx.ValueTextBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Margin="8,0,0,0"/>
                <TextBlock local:Loc.Key="{Binding UnitKey}" Foreground="{DynamicResource Fx.TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- A table's row and its header row: Fx.Line.Row under each in Fx.Divider; a row Fx.Row.MinHeight high, the header
         Fx.Control.Height. -->
    <Style x:Key="Base.Table.Ruled" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Row}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Row.MinHeight}"/>
    </Style>
    <Style x:Key="Base.Table.Head" TargetType="Border" BasedOn="{StaticResource Base.Table.Ruled}">
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
    </Style>

    <!-- A navigation entry of a flat look: a line Fx.Nav.ItemHeight high with the navigation corner. The hover shade is a
         layer UNDER the entry's own background, so the open page's fill (set on the button) is never replaced by it;
         keyboard focus adds an edge in the focus colour. -->
    <Style x:Key="Base.Nav.Entry" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Nav.ItemHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Hover" Visibility="Collapsed" Background="{DynamicResource Fx.NavHoverBrush}"
                                CornerRadius="{DynamicResource Fx.Radius.Nav}"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource Fx.Radius.Nav}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Edge" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Nav}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group: its icon (Fx.Nav.Icons), its name, and a chevron on the right that turns down while it is open; its pages
         under it. -->
    <DataTemplate x:Key="Base.Nav.Group">
        <StackPanel>
            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}">
                <DockPanel>
                    <Path x:Name="Chevron" DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center" Stretch="None"
                          Stroke="{DynamicResource Fx.NavTextSecondaryBrush}" StrokeThickness="1.2" Data="M 2 0 L 6 4 L 2 8"/>
                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                               Foreground="{DynamicResource Fx.IconBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                </DockPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" ItemTemplate="{DynamicResource Fx.Nav.Page}"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Fx.BoolToVis}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Chevron" Property="Data" Value="M 0 2 L 4 6 L 8 2"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A page of a group: indented by Fx.Nav.SubIndent, Fx.Nav.SubItemHeight high, in the pane's second text colour; the
         open page filled with Fx.NavSelected, its text in Fx.NavSelectedText and Fx.Weight.NavSelected. -->
    <DataTemplate x:Key="Base.Nav.Page">
        <Button x:Name="Line" Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding OpenCommand}" Padding="0,0,10,0"
                MinHeight="{DynamicResource Fx.Nav.SubItemHeight}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="{DynamicResource Fx.Nav.SubIndent}"/>
                <TextBlock x:Name="Text" local:Loc.Key="{Binding TitleKey}" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fx.Size.NavSub}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                           Foreground="{DynamicResource Fx.NavTextSecondaryBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Fx.NavSelectedBrush}"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fx.NavSelectedTextBrush}"/>
                <Setter TargetName="Text" Property="FontWeight" Value="{DynamicResource Fx.Weight.NavSelected}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The settings window of a flat look: the pane on its own colour (profile, search, the list with App settings last,
         Simple and All settings), Look.PaneLine's 1 px line, the page, the help column; Look.TopLine's 3 px accent line
         along the window's top; the toast over the page. The window's code hands in the three live parts, as in Fx.Shell. -->
    <ControlTemplate x:Key="Base.Shell.Pane" TargetType="local:ShellFrame">
        <Grid Background="{DynamicResource Fx.BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding HelpWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="4" Height="{DynamicResource Look.TopLine.Height}" Opacity="{DynamicResource Look.TopLine.Opacity}"
                    Background="{DynamicResource Fx.AccentBrush}" Visibility="{DynamicResource Look.TopLine}"/>

            <Border Grid.Row="1" Grid.Column="0" Width="{DynamicResource Fx.Nav.Width}" Background="{DynamicResource Fx.NavBrush}">
                <DockPanel Margin="10,12">
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Profile}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ContentControl DockPanel.Dock="Top" Margin="0,8,0,8" Focusable="False" IsTabStop="False"
                                    Content="{TemplateBinding Search}"
                                    Visibility="{Binding ShowGroups, Converter={StaticResource Fx.BoolToVis}}"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Mode}"
                                    Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ContentControl DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False"
                                    Content="{Binding AppGroup}" ContentTemplate="{DynamicResource Fx.Nav.Group}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding HomeCommand}"
                                    Visibility="{Binding HasHome, Converter={StaticResource Fx.BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.IconBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.Home" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{DynamicResource Fx.Nav.Entry}" Command="{Binding AllSettingsCommand}"
                                    Visibility="{Binding IsSimple, Converter={StaticResource Fx.BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="{DynamicResource Fx.Nav.Icons}"
                                               Foreground="{DynamicResource Fx.IconBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock local:Loc.Key="L.S.Nav.AllSettings" Style="{DynamicResource Fx.Label}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fx.Size.Nav}" FontWeight="{DynamicResource Fx.Weight.Nav}"
                                               Foreground="{DynamicResource Fx.NavTextBrush}" local:Loc.Case="{DynamicResource Fx.Case.Nav}"/>
                                </DockPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding VisibleGroups}" ItemTemplate="{DynamicResource Fx.Nav.Group}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Width="1" Background="{DynamicResource Fx.BorderBrush}" Visibility="{DynamicResource Look.PaneLine}"/>

            <DockPanel Grid.Row="1" Grid.Column="2" Margin="{DynamicResource Fx.Page.Padding}">
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Header}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{DynamicResource Fx.SaveError}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Status}"
                                Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentPresenter Content="{TemplateBinding Page}"/>
            </DockPanel>

            <ContentControl Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                            Content="{TemplateBinding ToastText}" ContentTemplate="{DynamicResource Fx.Toast}"
                            Visibility="{Binding ToastText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Fx.NotNullToVis}}"/>

            <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding}" ContentTemplate="{DynamicResource Fx.Shell.Help}"
                            Focusable="False" IsTabStop="False"/>

            <!-- A resize grip, drawn (Look.Grip): the window's own edge resizes it. -->
            <Path x:Name="Grip" Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Data="M 9,3 L 3,9 M 9,6 L 6,9" Stroke="{DynamicResource Fx.TextDisabledBrush}" StrokeThickness="1"
                  IsHitTestVisible="False" Visibility="{DynamicResource Look.Grip}"/>
        </Grid>
    </ControlTemplate>

    <!-- The page's header of a flat look: the breadcrumb on a line of its own (Fx.Show.Breadcrumb; the group goes back to
         its first page), the page's name in the title's tokens under it, the description, and Look.Help's "?" on the right.
         Home has no breadcrumb. -->
    <DataTemplate x:Key="Base.Header.Stacked">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel Visibility="{DynamicResource Fx.Show.Breadcrumb}">
                    <WrapPanel Visibility="{Binding GroupTitleKey, Converter={StaticResource Fx.NotNullToVis}}">
                        <Button Cursor="Hand" Command="{Binding BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=local:ShellFrame}}">
                            <!-- The group's name: with the keyboard's focus an edge in the focus colour around it (fix round C). -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border x:Name="Edge" Margin="-2" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                                CornerRadius="{DynamicResource Fx.Radius.Control}" Visibility="Hidden" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock local:Loc.Key="{Binding GroupTitleKey}" Style="{DynamicResource Fx.Breadcrumb}"/>
                        </Button>
                        <TextBlock Text=" › " Style="{DynamicResource Fx.Breadcrumb}"/>
                        <TextBlock Text="{Binding Current.Page.Title}" Style="{DynamicResource Fx.Breadcrumb}"
                                   Visibility="{Binding Current.Page.Title, Converter={StaticResource Fx.NotNullToVis}}"/>
                        <TextBlock local:Loc.Key="{Binding Current.Page.TitleKey}" Style="{DynamicResource Fx.Breadcrumb}"
                                   Visibility="{Binding Current.Page.Title, Converter={StaticResource Base.NullToVis}}"/>
                    </WrapPanel>
                </WrapPanel>
                <!-- The title's own style from the tokens Fx.PageTitle reads: no style here is based on a contract style, so a look
                     may define Fx.Breadcrumb (StyleSwitchTests: no look redefines a style the app's XAML derives from). -->
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource Fx.TitleFont}"/>
                            <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Title}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource Fx.Weight.Title}"/>
                            <Setter Property="FontStyle" Value="{DynamicResource Fx.Style.Title}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
                            <Setter Property="local:Loc.Case" Value="{DynamicResource Fx.Case.Title}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Text" Value="{Binding Current.Page.Title}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Page.Title}" Value="{x:Null}">
                                    <Setter Property="local:Loc.Key" Value="{Binding Current.Page.TitleKey}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock local:Loc.Key="{Binding Current.Page.DescKey}" Style="{DynamicResource Fx.PageDesc}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{DynamicResource Look.Help}" IsChecked="{Binding HelpOpen}" Content="?"
                          VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{DynamicResource L.S.Shell.Help}" local:Loc.NameKey="L.S.Shell.Help"/>
        </Grid>
    </DataTemplate>

    <!-- ═══ Parts of plan S4's looks. Keyed Base.*, put under a contract key by a look's code (UiStyles.ReadLook). ═══ -->

    <!-- A row on a grid of columns (Capsule, Terminal): a column for a check box, Look.BoxColumn wide (a Double the look
         defines); the label, its note and an error in a column at most Fx.Label.Width wide (a star column with that most:
         where the page has no room it is narrower and the label wraps, so the control is never pushed off the page); then
         the control, left; the rest of the row empty. A search hit lights the label. -->
    <Style x:Key="Base.Card.Columns" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" Style="{DynamicResource Fx.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1000*" MaxWidth="{DynamicResource Fx.Label.Width}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="{DynamicResource Look.BoxColumn}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                                <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                                <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                           Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An on/off setting on the same grid: the look's on/off box in the box column, its label and note from the label
         column on (the box's own padding reaches it), the error under them. A click anywhere on the label switches it. -->
    <DataTemplate x:Key="Base.Card.ColumnsToggle">
        <Border Style="{DynamicResource Fx.Card}" Visibility="{Binding IsVisible, Converter={StaticResource Fx.BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1000*" MaxWidth="{DynamicResource Fx.Label.Width}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="{DynamicResource Look.BoxColumn}"/>
                <CheckBox Grid.ColumnSpan="2" Style="{DynamicResource Fx.ToggleSwitch}" IsChecked="{Binding IsOn}" local:Loc.NameKey="{Binding LabelKey}"
                          HorizontalAlignment="Left" VerticalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="Label" local:Loc.Key="{Binding LabelKey}" Style="{DynamicResource Fx.Label}"/>
                        <TextBlock local:Loc.Key="{Binding DescKey}" Style="{DynamicResource Fx.Desc}"/>
                        <TextBlock Text="{Binding Error}" Style="{DynamicResource Fx.Error}"
                                   Visibility="{Binding HasError, Converter={StaticResource Fx.BoolToVis}}"/>
                    </StackPanel>
                </CheckBox>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══ Parts every look reads that are not contract names (plan S4). Each default here is what Windows 11 and Classic
         draw; a look that draws the part otherwise defines the same key in its own dictionary. ═══ -->

    <!-- A severity in an editor's table (AlertEvents.SeverityText): its word in its status colour. The content is the
         severity's id: critical, warning, or anything else (info). -->
    <DataTemplate x:Key="Look.Severity">
        <TextBlock x:Name="Word" local:Loc.Key="L.S.Sev.info" Foreground="{DynamicResource Fx.InfoBrush}" VerticalAlignment="Center"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="critical">
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.critical"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.CriticalBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="warning">
                <Setter TargetName="Word" Property="local:Loc.Key" Value="L.S.Sev.warning"/>
                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Fx.WarningBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The border behind a cell of a table's header row (EditorTable): as any row's cell, nothing. A look with lines
         between the header's columns only draws them here. -->
    <Style x:Key="Look.Table.HeadCell" TargetType="Border"/>

    <!-- The flat looks' pane shell (Base.Shell.Pane): its accent line along the window's top is 3 px and opaque, and it
         has no grip, unless a look says otherwise (Capsule). -->
    <sys:Double x:Key="Look.TopLine.Height">3</sys:Double>
    <sys:Double x:Key="Look.TopLine.Opacity">1</sys:Double>
    <Visibility x:Key="Look.Grip">Collapsed</Visibility>
</ResourceDictionary>
