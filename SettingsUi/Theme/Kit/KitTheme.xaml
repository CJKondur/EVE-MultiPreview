    <!-- A key as the hotkey cards show it (Fx.KeyCap): a box on the input colour, as wide as Windows 11's. -->
    <Style x:Key="Kit.KeyCap.Box" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Scroll bar: 10 wide, no arrows, a thin rounded thumb in the input edge's colour, the note colour under the mouse
         (Thin). The flat looks set Fx.Scroll.Overlay: the page leaves it a margin of its own. -->
    <ControlTemplate x:Key="Kit.Scroll.ThumbShape" TargetType="Thumb">
        <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{DynamicResource Fx.ControlEdgeBrush}"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Kit.Scroll.Thin" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource Kit.Scroll.ThumbShape}" OverridesDefaultStyle="True"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.56"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource Kit.Scroll.ThumbShape}" OverridesDefaultStyle="True"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ The shapes of plan S4's looks (Capsule, High contrast, Blueprint, Ink, Terminal). Keyed only, as the flat shapes:
         a look picks one by basing its implicit style on it. A trigger that is true when its template is made sets plain
         values only. ═══ -->

    <!-- Check box with a filled square (BoxFill, Capsule): a box Kit.Size wide on the check colour with the check border,
         an inner square in the mark colour 2 px in from the edge when on, half seen when neither on nor off. -->
    <Style x:Key="Kit.Check.Fill" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                    CornerRadius="{DynamicResource Fx.Radius.Check}" Visibility="Hidden"/>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Check}"
                                    Width="{TemplateBinding local:Kit.Size}" Height="{TemplateBinding local:Kit.Size}">
                                <Rectangle x:Name="Inner" Margin="2" Fill="{DynamicResource Fx.CheckMarkBrush}" Visibility="Hidden"/>
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Inner" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider as a bar (Bar, Capsule): a 2 px track in Fx.Track, filled in Fx.TrackFill up to an upright 6 by 14 thumb in
         Fx.Thumb; keyboard focus draws an edge in the focus colour around the thumb. -->
    <Style x:Key="Kit.Slider.BarFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
