    </Style>
    <Style x:Key="Kit.Slider.Bar" TargetType="Slider">
        <Setter Property="MinHeight" Value="16"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="2" Margin="3,0" VerticalAlignment="Center" Background="{DynamicResource Fx.TrackBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.BarFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="6" Height="14" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border x:Name="Ring" Margin="-2" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                                                <Rectangle Fill="{DynamicResource Fx.ThumbBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider with a ring thumb (High contrast): a 4 px round track in Fx.Track, filled in Fx.TrackFill up to a 20 px
         thumb drawn as three rings: 1 px in the input edge's colour, 4 px in the page's colour, the thumb's colour inside. -->
    <Style x:Key="Kit.Slider.RingFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Fx.TrackFillBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Slider.Ring" TargetType="Slider">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" Margin="10,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Fx.TrackBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.RingFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                                                <Ellipse Fill="{DynamicResource Fx.ControlEdgeBrush}"/>
                                                <Ellipse Margin="1" Fill="{DynamicResource Fx.BgBrush}"/>
                                                <Ellipse Margin="5" Fill="{DynamicResource Fx.ThumbBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page's help as a link (Link: High contrast, Ink): its content in the link colour on the page, no box; picked
         (the help pane open), semibold; keyboard focus draws an edge in the focus colour. The header gives it an underlined
         text. -->
    <Style x:Key="Kit.Help.Link" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="Edge" Margin="-3" BorderBrush="{DynamicResource Fx.FocusBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                                Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box crossed corner to corner (BoxCross, Blueprint): an outlined box Kit.Size wide in the check border's colour
         on the check colour; when on, a cross in the mark colour from corner to corner, half seen when neither on nor off.
         Switched off with Kit.DashedOff: a dashed edge. -->
    <Style x:Key="Kit.Check.Cross" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Width="{TemplateBinding local:Kit.Size}" Height="{TemplateBinding local:Kit.Size}">
                            <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Path x:Name="Cross" Margin="1" Stretch="Fill" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Fx.CheckMarkBrush}"
                                  StrokeThickness="1.5" Visibility="Hidden"/>
                            <Rectangle x:Name="Dashed" Stroke="{DynamicResource Fx.TextDisabledBrush}" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Cross" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Radio.Cross" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="7,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Width="{TemplateBinding local:Kit.Size}" Height="{TemplateBinding local:Kit.Size}">
                            <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Path x:Name="Cross" Margin="1" Stretch="Fill" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Fx.CheckMarkBrush}"
                                  StrokeThickness="1.5" Visibility="Hidden"/>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider as a ruler (Ruler, Blueprint): a base line in Fx.TrackFill, a tick every 24 px in Fx.Track (the ticks are the
         track's colour through a mask: the mask's black is an alpha, not a colour), and an upright 3 by 18 thumb in Fx.Thumb;
         keyboard focus draws an edge around the thumb. -->
    <Style x:Key="Kit.Slider.Ruler" TargetType="Slider">
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="Ticks" Height="6" Margin="1,0,1,1" VerticalAlignment="Bottom" Fill="{DynamicResource Fx.TrackBrush}">
                            <Rectangle.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,24,6" ViewportUnits="Absolute" Viewbox="0,0,24,6" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="Black" Geometry="M 0,0 L 1,0 L 1,6 L 0,6 Z"/>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Fx.TrackFillBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="3" Height="18" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                                                <Rectangle Fill="{DynamicResource Fx.ThumbBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box with an inset (BoxInset, Ink): a box Kit.Size wide with a 1.5 px edge in the check border's colour, the
         mark colour inside; when on, the check colour fills it inside a 2 px ring of the mark colour (half seen when
         neither). Switched off with Kit.DashedOff: a dashed edge. -->
    <Style x:Key="Kit.Check.Inset" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.CheckMarkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Width="{TemplateBinding local:Kit.Size}" Height="{TemplateBinding local:Kit.Size}">
                            <Border x:Name="Ring" Margin="-3" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Rectangle x:Name="Inset" Margin="2" Fill="{DynamicResource Fx.CheckFillBrush}" Visibility="Hidden"/>
                            </Border>
                            <Rectangle x:Name="Dashed" Stroke="{DynamicResource Fx.TextDisabledBrush}" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Inset" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Inset" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Inset" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider as a line (Line, Ink): a 1 px line in Fx.Track, 3 px in Fx.TrackFill up to a 12 px dot in Fx.Thumb; keyboard
         focus draws a ring around the dot. -->
    <Style x:Key="Kit.Slider.LineFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="3" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Fx.TrackFillBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Slider.Line" TargetType="Slider">
        <Setter Property="MinHeight" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="1" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource Fx.TrackBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.LineFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                                                <Ellipse Fill="{DynamicResource Fx.ThumbBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box as an underline (Underline, Ink): on the input colour, a line in Fx.Line.Control's thickness (a look sets
         it to an underline) in the input edge's colour; 3 px while focused; switched off with Kit.DashedOff, a dashed
         underline. -->
    <Style x:Key="Kit.TextBox.Underline" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <Line x:Name="Dashed" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Bottom" Stroke="{DynamicResource Fx.TextDisabledBrush}"
                              StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown as an underline (Underline, Ink): the same underline, 3 px while it has the keyboard; a chevron. -->
    <Style x:Key="Kit.Dropdown.Underline" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Template="{StaticResource Kit.Dropdown.Hit}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="2,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Focusable="True"
                                 Background="{DynamicResource Fx.ControlBrush}" Foreground="{DynamicResource Fx.TextBrush}" CaretBrush="{DynamicResource Fx.TextBrush}"
                                 BorderThickness="0" Padding="0" Margin="2,0,22,0" VerticalAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Path x:Name="Chevron" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                              Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Fx.TextBrush}" StrokeThickness="1.5"/>
                        <Line x:Name="Dashed" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Bottom" Stroke="{DynamicResource Fx.TextDisabledBrush}"
                              StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <!-- The list's edge all round, 1 px: this dropdown's looks draw their control line as an underline and
                                 their card line as 0 (Ink), which left a white list on the white page with no edge. -->
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Fx.FlyoutRadius}"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="BorderThickness" Value="0,0,0,3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon button as an outlined circle (Ring, Ink): an edge in the button border's colour on the button colour, the glyph
         in the button text's colour; keyboard focus a ring in the focus colour. -->
    <Style x:Key="Kit.Icon.Ring" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Text shapes (Text, Terminal): controls drawn as characters in the look's own font; keyboard focus inverts them
         (the text colour behind, the page's colour as the text). ═══ -->

    <!-- Check box as text: "[ ]" off, "[x]" on in the mark colour, "[-]" neither on nor off; its content after it. -->
    <Style x:Key="Kit.Check.Text" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" VerticalAlignment="Top">
                            <local:DecorativeText x:Name="Mark" Text="[ ]" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="[x]"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Mark" Property="Text" Value="[-]"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio button as text: "( )" off, "(•)" on in the mark colour. -->
    <Style x:Key="Kit.Radio.Text" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" VerticalAlignment="Top">
                            <local:DecorativeText x:Name="Mark" Text="( )" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="(•)"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.CheckMarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button as text: "<" its content ">"; under the mouse on the hover colour; pressed or focused inverted. -->
    <Style x:Key="Kit.Button.Text" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <local:DecorativeText Text="&lt;" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <local:DecorativeText Text="&gt;" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A toggle button as text: the same, bold while it is on. -->
    <Style x:Key="Kit.Toggle.Text" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <local:DecorativeText Text="&lt;" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <local:DecorativeText Text="&gt;" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box as text: "[" the field "]", the field on the input colour, its text in the value colour; the brackets in the
         title colour while it has the keyboard; switched off, the field has no colour and the box is faded. -->
    <Style x:Key="Kit.TextBox.Text" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ValueTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <DockPanel x:Name="root">
                        <local:DecorativeText x:Name="Open" DockPanel.Dock="Left" Text="[" Foreground="{DynamicResource Fx.TextBrush}" VerticalAlignment="Center"/>
                        <local:DecorativeText x:Name="Close" DockPanel.Dock="Right" Text="]" Foreground="{DynamicResource Fx.TextBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="Field" Background="{TemplateBinding Background}" VerticalAlignment="Center">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Open" Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
                            <Setter TargetName="Close" Property="Foreground" Value="{DynamicResource Fx.TitleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Background" Value="{x:Null}"/>
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown as text: "[" the choice "▼]"; inverted while it has the keyboard; the list in a pop-up. -->
    <Style x:Key="Kit.Dropdown.Text" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.BgBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <DockPanel>
                                <local:DecorativeText DockPanel.Dock="Left" Text="[" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <local:DecorativeText DockPanel.Dock="Right" Text="▼]" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Template="{StaticResource Kit.Dropdown.Hit}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Focusable="True"
                                 Background="{DynamicResource Fx.ControlBrush}" Foreground="{DynamicResource Fx.TextBrush}" CaretBrush="{DynamicResource Fx.TextBrush}"
                                 BorderThickness="0" Padding="0" Margin="10,0,20,0" VerticalAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Card}" CornerRadius="{DynamicResource Fx.FlyoutRadius}"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.TextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.BgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider as character blocks (Blocks, Terminal): the filled part a solid bar in Fx.TrackFill, the rest hatched in
         Fx.Track (the track's colour through a mask of diagonal lines: the mask's black is an alpha, not a colour); a thumb
         of the fill's colour; keyboard focus a line under the whole track. -->
    <Style x:Key="Kit.Slider.BlocksFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Height="16" VerticalAlignment="Center" Fill="{DynamicResource Fx.TrackFillBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Slider.Blocks" TargetType="Slider">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="Hatch" Height="16" VerticalAlignment="Center" Fill="{DynamicResource Fx.TrackBrush}">
                            <Rectangle.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="Black" Geometry="M 0,3 L 3,0 L 4,0 L 4,1 L 1,4 L 0,4 Z"/>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="Ring" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Fx.FocusBrush}" Visibility="Hidden"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.BlocksFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="4" Height="20" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Height="16" VerticalAlignment="Center" Fill="{DynamicResource Fx.TrackFillBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
