<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.KitTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EveMultiPreview.SettingsUi">

    <!-- The kit (UI styles spec §5.1, §6.3): the standard controls in the shapes the looks without Fluent pick, each
         against tokens. Slot 0 of a window of such a look. A shape is keyed (Kit.<Control>.<Shape>); the implicit style of
         its type is based on the default shape, and a look that wants another shape redefines the implicit style in its
         own dictionary. The default shapes are Classic's: the old settings window's controls, drawn as WPF's own theme
         drew them there, with the look's colours. Where a value has no token (the plain slider's two edges, a button's
         corner) the shape keeps WPF's own value (LookScanTests lists them). -->

    <!-- ═══ Check box: a 13 px box, a tick when on (BoxTick) ═══ -->
    <Style x:Key="Kit.Check.BoxTick" TargetType="CheckBox">
        <Setter Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="checkBoxBorder" Margin="1" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius.Check}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid x:Name="markGrid">
                                <Path x:Name="optionMark" Margin="1" Opacity="0" Stretch="None" Fill="{DynamicResource Fx.CheckMarkBrush}"
                                      Data="F1M9.97498,1.22334L4.6983,9.09834 4.52164,9.09834 0,5.19331 1.27664,3.52165 4.255,6.08833 8.33331,1.52588E-05 9.97498,1.22334z"/>
                                <Rectangle x:Name="indeterminateMark" Margin="2" Opacity="0" Fill="{DynamicResource Fx.CheckMarkBrush}"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter Property="Padding" Value="4,-1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="templateRoot" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="optionMark" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="indeterminateMark" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Kit.Check.BoxTick}"/>

    <!-- ═══ Radio button: a circle with a dot (Dot) ═══ -->
    <Style x:Key="Kit.Radio.Dot" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="radioButtonBorder" Margin="1,1,2,1" CornerRadius="100" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid x:Name="markGrid" Margin="2">
                                <Ellipse x:Name="optionMark" MinWidth="6" MinHeight="6" Opacity="0" Fill="{DynamicResource Fx.CheckMarkBrush}"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter Property="Padding" Value="4,-1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="radioButtonBorder" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="radioButtonBorder" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="radioButtonBorder" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="templateRoot" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="optionMark" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Kit.Radio.Dot}"/>

    <!-- ═══ Slider: a light 4 px track, an upright thumb (Plain). Horizontal: the app has no upright slider. The track is
         Fx.Track and the thumb Fx.Thumb; their two edges are WPF's own (#D6D6D6, #ACACAC): no token is a slider's edge. ═══ -->
    <Style x:Key="Kit.Slider.Repeat" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Slider.Plain" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="4" Margin="5,0" VerticalAlignment="Center"
                                    BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="#FFD6D6D6" Background="{DynamicResource Fx.TrackBrush}"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" OverridesDefaultStyle="True" Width="11" Height="18" VerticalAlignment="Center" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path x:Name="grip" Stretch="Fill" Fill="{DynamicResource Fx.ThumbBrush}" Stroke="#FFACACAC" StrokeThickness="1"
                                                          UseLayoutRounding="True" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                                          Data="M0,0C0,0 11,0 11,0 11,0 11,18 11,18 11,18 0,18 0,18 0,18 0,0 0,0z"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="grip" Property="Stroke" Value="{DynamicResource Fx.AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="grip" Property="Stroke" Value="{DynamicResource Fx.AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TrackBackground" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Kit.Slider.Plain}"/>

    <!-- ═══ Text box: a box on the input colour (Box) ═══ -->
    <Style x:Key="Kit.TextBox.Box" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kit.TextBox.Box}"/>

    <!-- ═══ Dropdown: a box on the input colour with a triangle (BoxArrow), the old window's own ═══ -->
    <ControlTemplate x:Key="Kit.Dropdown.Toggle" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2" Background="{DynamicResource Fx.ControlBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.Radius.Control}"/>
            <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{DynamicResource Fx.TextBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Kit.Dropdown.BoxArrow" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Template="{StaticResource Kit.Dropdown.Toggle}" Focusable="False" ClickMode="Press"
                                      BorderBrush="{DynamicResource Fx.ControlEdgeBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="6,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <!-- WPF honours IsEditable only with a TextBox named PART_EditableTextBox (the old window's #88). -->
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Focusable="True"
                                 Background="Transparent" Foreground="{DynamicResource Fx.TextBrush}" CaretBrush="{DynamicResource Fx.TextBrush}"
                                 BorderThickness="0" Padding="0" Margin="6,3,23,3" VerticalAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.FlyoutRadius}"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Kit.Dropdown.BoxArrow}"/>
    <Style x:Key="Kit.Dropdown.Item" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Kit.Dropdown.Item}"/>

    <!-- ═══ Button: light grey with a grey edge (Box); hovered lighter with an accent edge. The corner is the old
         window's 3 (its boxes had 2): no token is a button's corner. ═══ -->
    <Style x:Key="Kit.Button.Box" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Kit.Button.Box}"/>

    <!-- The keyed buttons of a look without Fluent (Windows 11's are in Windows11Controls): the kit's button with the old
         window's small-button metrics. -->
    <Style x:Key="Fx.IconButton" TargetType="Button" BasedOn="{StaticResource Kit.Button.Box}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Fx.KeyCap" TargetType="Button" BasedOn="{StaticResource Kit.Button.Box}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="12,3"/>
    </Style>
    <Style x:Key="Fx.Swatch" TargetType="Button" BasedOn="{StaticResource Kit.Button.Box}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ Group box: one line with the title set into its top edge (Line). Behind the title the page's colour, so the
         line stops on both sides of it: a group box stands on the page. ═══ -->
    <Style x:Key="Kit.GroupBox.Line" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Padding" Value="10,4,10,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,8,0,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Margin="0,8,0,0"/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Padding="4,0" Background="{DynamicResource Fx.BgBrush}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource Kit.GroupBox.Line}"/>

    <!-- ═══ Toggle button: the kit's button, held in while it is on (Box) ═══ -->
    <Style x:Key="Kit.Toggle.Box" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Kit.Toggle.Box}"/>

    <!-- ═══ WPF's own shapes, as the old window had them: the scroll bar takes its own column ═══ -->
    <Style TargetType="RepeatButton"/>
    <Style TargetType="ScrollBar"/>
    <Style TargetType="ScrollViewer"/>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
    </Style>

    <!-- ═══ A list box: a box on the input colour; the picked item on the soft accent (Box) ═══ -->
    <Style x:Key="Kit.List.Box" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource Kit.List.Box}"/>
    <Style x:Key="Kit.List.Item" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="{DynamicResource Fx.Line.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Kit.List.Item}"/>

    <!-- ═══ A list view (the alert history's table): WPF's own GridView shape, with the look's rows and headers ═══ -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
    </Style>
    <Style x:Key="Kit.Row.Item" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Padding" Value="2,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="{DynamicResource Fx.Line.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource Kit.Row.Item}"/>
    <Style x:Key="Kit.Header.Box" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Fx.HeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource Fx.Line.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource Kit.Header.Box}"/>

    <!-- ═══ Menus and tool tips: on the flyout colour, with its edge and corner. A row is Fx.Menu.RowHeight high; a
         checked item has a tick; the pointed one is on the soft accent. ═══ -->
    <Style x:Key="Kit.Menu.Box" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Fx.FlyoutBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.FlyoutBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Fx.FlyoutRadius}" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource Kit.Menu.Box}"/>
    <Style x:Key="Kit.Menu.Row" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Menu.RowHeight}"/>
        <Setter Property="Padding" Value="4,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture"/>
                                <ColumnDefinition Width="12"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource Fx.IconFont}" Visibility="Hidden"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fx.TextSecondaryBrush}"/>
                            <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.FlyoutRadius}" Padding="2">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Fx.TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource Kit.Menu.Row}"/>
    <!-- A separator in a menu is styled by MenuItem.SeparatorStyleKey, anywhere else by its type. -->
    <Style x:Key="Kit.Menu.Separator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Fx.DividerBrush}"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Kit.Menu.Separator}"/>
    <Style TargetType="Separator" BasedOn="{StaticResource Kit.Menu.Separator}"/>
    <Style x:Key="Kit.ToolTip.Box" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Fx.FlyoutBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.FlyoutBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Fx.FlyoutRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource Kit.ToolTip.Box}"/>

    <!-- ═══ The flat looks' shapes (plan S3: Daylight, Dusk, Compact, Neon, Carbon). Keyed only: a look picks one by basing
         the implicit style of its control on it in its own dictionary, so Classic's shapes above stay Classic's. A size
         the tokens do not hold is the kit's own value Kit.Size, set by the look's style. Keyboard focus is a ring or an
         edge in Fx.Focus; a disabled shape is faded, and dashed where the look sets Kit.DashedOff. ═══ -->

    <!-- Check box: a box Kit.Size wide with the look's check corner; empty with the check border when off, filled with the
         check colour and a tick in the mark colour when on (spec §6.3, BoxTick of Daylight, Compact and Carbon). -->
    <Style x:Key="Kit.Check.Tick" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="Ring" Margin="-3" BorderThickness="{DynamicResource Fx.Line.Control}" BorderBrush="{DynamicResource Fx.FocusBrush}"
                                    CornerRadius="{DynamicResource Fx.Radius.Check}" Visibility="Hidden"/>
                            <Border x:Name="Box" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Fx.Radius.Check}"
                                    Width="{TemplateBinding local:Kit.Size}"
                                    Height="{TemplateBinding local:Kit.Size}">
                                <Path x:Name="Tick" Margin="3" Stretch="Uniform" Visibility="Hidden" Data="M 0,5 L 4,9 L 12,0"
                                      Stroke="{DynamicResource Fx.CheckMarkBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fx.CheckFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box as a circle (RoundTick, Dusk): Kit.Size wide, a 2 px check border when off; filled with the check colour
         and a tick when on. -->
    <Style x:Key="Kit.Check.RoundTick" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Width="{TemplateBinding local:Kit.Size}" Height="{TemplateBinding local:Kit.Size}">
                            <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                            <Ellipse x:Name="Box" Fill="Transparent" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                            <Path x:Name="Tick" Margin="5" Stretch="Uniform" Visibility="Hidden" Data="M 0,5 L 4,9 L 12,0"
                                  Stroke="{DynamicResource Fx.CheckMarkBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Fill" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio button: a circle Kit.Size wide; empty with the check border when off, filled with the check colour and a dot
         in the mark colour when on. -->
    <Style x:Key="Kit.Radio.Fill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.CheckBorderBrush}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Width="{TemplateBinding local:Kit.Size}"
                              Height="{TemplateBinding local:Kit.Size}">
                            <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                            <Ellipse x:Name="Box" Fill="Transparent" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Margin="5" Fill="{DynamicResource Fx.CheckMarkBrush}" Visibility="Hidden"/>
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Fill" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource Fx.CheckFillBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: a 4 px round track in Fx.Track, filled in Fx.TrackFill up to a round 14 px thumb in Fx.Thumb (Round). -->
    <Style x:Key="Kit.Slider.Fill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" Margin="7,0,0,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Fx.TrackFillBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Slider.Round" TargetType="Slider">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" Margin="7,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Fx.TrackBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Kit.Slider.Fill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                                                <Ellipse Fill="{DynamicResource Fx.ThumbBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box: a box on the input colour with the control corner, Fx.Control.Height high, the text centred; the accent
         edge under the mouse and the focus edge for the keyboard. Switched off with Kit.DashedOff: no surface, a dashed
         edge, faded. (A trigger that can be true when its template is made sets plain values only: plan S3, Task 1.) -->
    <Style x:Key="Kit.TextBox.Round" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Fx.AccentBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius.Control}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <Rectangle x:Name="Dashed" Stroke="{DynamicResource Fx.TextDisabledBrush}" StrokeThickness="1" StrokeDashArray="3 2"
                                   Visibility="Collapsed" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{x:Null}"/>
                            <Setter TargetName="border" Property="Background" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown: the same box with a chevron (Box). The toggle that opens it is a transparent area over the box. -->
    <ControlTemplate x:Key="Kit.Dropdown.Hit" TargetType="ToggleButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <Style x:Key="Kit.Dropdown.Box" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}"/>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Template="{StaticResource Kit.Dropdown.Hit}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="9,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <!-- WPF honours IsEditable only with a TextBox named PART_EditableTextBox. -->
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Focusable="True"
                                 Background="Transparent" Foreground="{DynamicResource Fx.TextBrush}" CaretBrush="{DynamicResource Fx.TextBrush}"
                                 BorderThickness="0" Padding="0" Margin="9,0,28,0" VerticalAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Path x:Name="Chevron" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                              Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Fx.TextSecondaryBrush}" StrokeThickness="1.5"/>
                        <Rectangle x:Name="Dashed" Stroke="{DynamicResource Fx.TextDisabledBrush}" StrokeThickness="1" StrokeDashArray="3 2"
                                   Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource Fx.FlyoutBrush}" BorderBrush="{DynamicResource Fx.FlyoutBorderBrush}"
                                        BorderThickness="{DynamicResource Fx.Line.Control}" CornerRadius="{DynamicResource Fx.FlyoutRadius}"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="local:Kit.DashedOff" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Null}"/>
                            <Setter TargetName="Box" Property="Background" Value="{x:Null}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: the button colours with the control corner, Fx.Control.Height high (Round). -->
    <Style x:Key="Kit.Button.Round" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Toggle.Round" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Control}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Fx.Control.Height}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One of joined buttons (Simple and All settings): bare in the pane's second text colour; the picked one filled with
         the accent, its text on the accent. A look's frame around the two gives the join. -->
    <Style x:Key="Kit.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fx.NavTextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Desc}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Fx.Radius.Control}"
                            BorderThickness="{DynamicResource Fx.Line.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fx.AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fx.OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page's "?" (Help) and Fx.IconButton's shapes: a box with the control corner (Box), or a disc (Round). The glyph is
         in the link colour on the box, in the button's text colour on the disc. A look sets the size. -->
    <Style x:Key="Kit.Help.Box" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Help.Round" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{DynamicResource Fx.Size.Body}"/>
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Fx.AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Icon.Box" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Fx.Line.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.LinkBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Fx.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Fx.ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fx.FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Kit.Icon.Round" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fx.ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.ButtonTextBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Fx.FocusBrush}" StrokeThickness="1" Visibility="Hidden"/>
                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A key as the hotkey cards show it (Fx.KeyCap): a box on the input colour, as wide as Windows 11's. -->
    <Style x:Key="Kit.KeyCap.Box" TargetType="Button" BasedOn="{StaticResource Kit.Button.Round}">
        <Setter Property="Background" Value="{DynamicResource Fx.ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Fx.ControlEdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fx.TextBrush}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Scroll bar: 10 wide, no arrows, a thin rounded thumb in the input edge's colour, the note colour under the mouse
         (Thin). The flat looks set Fx.Scroll.Overlay: the page leaves it a margin of its own. -->
    <ControlTemplate x:Key="Kit.Scroll.ThumbShape" TargetType="Thumb">
        <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{DynamicResource Fx.ControlEdgeBrush}"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fx.TextSecondaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Kit.Scroll.Thin" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource Kit.Scroll.ThumbShape}" OverridesDefaultStyle="True"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Kit.Slider.Repeat}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource Kit.Scroll.ThumbShape}" OverridesDefaultStyle="True"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
