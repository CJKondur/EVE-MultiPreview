<ResourceDictionary x:Class="EveMultiPreview.SettingsUi.SettingsTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spec §7 tokens. Change them here only. -->
    <Color x:Key="Fx.Bg">#FF202020</Color>
    <Color x:Key="Fx.CardColor">#FF2B2B2B</Color>
    <Color x:Key="Fx.CardHover">#FF323232</Color>
    <Color x:Key="Fx.Control">#FF383838</Color>
    <Color x:Key="Fx.Border">#FF3A3A3A</Color>
    <Color x:Key="Fx.Text">#FFFFFFFF</Color>
    <Color x:Key="Fx.TextSecondary">#FFABABAB</Color>
    <Color x:Key="Fx.Accent">#FF4CC2FF</Color>
    <Color x:Key="Fx.Critical">#FFFF99A4</Color>
    <Color x:Key="Fx.Warning">#FFFCE100</Color>
    <Color x:Key="Fx.Info">#FF60CDFF</Color>

    <SolidColorBrush x:Key="Fx.BgBrush" Color="{StaticResource Fx.Bg}"/>
    <SolidColorBrush x:Key="Fx.CardBrush" Color="{StaticResource Fx.CardColor}"/>
    <SolidColorBrush x:Key="Fx.CardHoverBrush" Color="{StaticResource Fx.CardHover}"/>
    <SolidColorBrush x:Key="Fx.ControlBrush" Color="{StaticResource Fx.Control}"/>
    <SolidColorBrush x:Key="Fx.BorderBrush" Color="{StaticResource Fx.Border}"/>
    <SolidColorBrush x:Key="Fx.TextBrush" Color="{StaticResource Fx.Text}"/>
    <SolidColorBrush x:Key="Fx.TextSecondaryBrush" Color="{StaticResource Fx.TextSecondary}"/>
    <SolidColorBrush x:Key="Fx.AccentBrush" Color="{StaticResource Fx.Accent}"/>
    <SolidColorBrush x:Key="Fx.CriticalBrush" Color="{StaticResource Fx.Critical}"/>
    <SolidColorBrush x:Key="Fx.WarningBrush" Color="{StaticResource Fx.Warning}"/>
    <SolidColorBrush x:Key="Fx.InfoBrush" Color="{StaticResource Fx.Info}"/>

    <FontFamily x:Key="Fx.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Fx.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <CornerRadius x:Key="Fx.Radius">6</CornerRadius>

    <!-- A setting card: 4 px gap below each card (spec §7). -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Fx.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Fx.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Fx.Radius}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="MinHeight" Value="64"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Fx.CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fx.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Breadcrumb" TargetType="TextBlock" BasedOn="{StaticResource Fx.PageTitle}">
        <Setter Property="Foreground" Value="{StaticResource Fx.TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Fx.PageDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <!-- 20 px before each section title (spec §7). -->
    <Style x:Key="Fx.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.TextBrush}"/>
        <Setter Property="Margin" Value="0,20,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fx.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- A missing description key leaves Text empty: collapse instead of leaving a blank line. -->
    <Style x:Key="Fx.Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fx.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Fx.CriticalBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
</ResourceDictionary>
