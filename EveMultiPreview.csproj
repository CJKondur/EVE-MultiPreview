<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 (20H1) is the minimum that exposes the full Windows.Graphics.Capture surface -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- PerMonitorV2: WinForms coords stay in physical pixels, WPF renders crisply
         per monitor. Requires DIP/physical conversions anywhere the two meet
         (see Interop/DpiHelper.cs). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>EVE MultiPreview</AssemblyName>
    <RootNamespace>EveMultiPreview</RootNamespace>
    <Version>3.0.0</Version>
    <Description>EVE Online multi-client thumbnail preview manager</Description>

    <!-- Publish settings -->
    <!-- The standalone exe is ~76MB, so it publishes OUTSIDE the repo entirely:
         a sibling folder, not a gitignored subfolder. Being out of the working
         tree means it cannot be committed even by an `git add -A`. -->
    <PublishDir>..\EVE-MultiPreview-Release\</PublishDir>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- A Release build doesn't carry the path of the folder it was built in. Without this the dll inside the exe
       holds the full path of its .pdb, and the .pdb (a release asset) the full path of every source file: on a PC
       that is the user-profile folder, so the Windows user name. The build folder is written as /_ instead, so a
       source file is /_/Services/X.cs, and that is also what a stack trace in error_log.txt shows.
       PathMap does that for the compiler, in a git checkout or not. DeterministicSourcePaths makes the SDK do the
       same for the one place the compiler doesn't write: the Source Link note in the .pdb, which says where on
       GitHub the sources of this commit are, and named the build folder too. Debug builds keep the real paths, so
       a debugger finds the sources by itself. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_</PathMap>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon-Suspend.ico" />
    <!-- Multi-language alert log substrings extracted from EVE's localization (issue #86) -->
    <EmbeddedResource Include="Resources\alert_patterns.json" />
  </ItemGroup>

  <!-- The typefaces of the looks (UI styles spec §11.1) and their licences, compiled in as WPF resources: a look names a
       family as /EVE MultiPreview;component/Resources/Fonts/<Folder>/#<Family>, and App settings › About shows the
       licences. -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\**\*.ttf" />
    <Resource Include="Resources\Fonts\**\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The xUnit project lives under tests/ and builds separately. -->
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

</Project>
